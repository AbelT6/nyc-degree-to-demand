		source = DATATABLE ( "Term", STRING, "Meaning", STRING, "sort_order", INTEGER, { { "Degree-level job", "Usually needs an associate's or bachelor's degree to start (BLS), like registered nurse. Master's-level jobs appear only to compare.", 1 }, { "Less schooling", "Usually needs less than an associate's degree", 2 }, { "Openings a year", "Jobs to fill each year, 2022–2032 (projected): new jobs plus replacements", 3 }, { "No related experience", "BLS's typical rating for the occupation, not what each employer asks", 4 }, { "Entry wage", "NY State's term: average pay of a job's lowest-paid third; not an offer", 5 }, { "Median", "The middle value: half are higher, half are lower", 6 }, { "After inflation", "Adjusted for rising prices, so pay in different years compares fairly", 7 }, { "NY metro", "NYC and nearby counties in NY and NJ (and PA until 2023)", 8 }, { "CUNY", "The City University of New York, the city's public university system", 9 }, { "AI exposure", "How much AI could change a job's tasks, vs. other jobs (BLS). Not job loss", 10 }, { "Our estimate", "We made it by combining public numbers; the Notes page says how", 11 } } )
