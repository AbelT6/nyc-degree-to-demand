	/// Notes on the Summary view (2 to 5).
	measure 'Job notes summary n' = [Job is filled] + 2 + IF ( [Job has NYC line], 1, 0 ) + IF ( SELECTEDVALUE ( job_profile[routes_status] ) = "listed", 1, 0 )
		formatString: 0
