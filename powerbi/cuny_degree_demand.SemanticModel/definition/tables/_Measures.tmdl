table _Measures
	lineageTag: 7dbf65cf-1546-560f-8821-d5fdab47dfe3

	/// The date of the last data refresh (NOW() captured when the model refreshes), for the v5 data lines ('… · refreshed 18 Oct 2026').
	measure 'Refreshed date' = FORMAT ( MAX ( '_Measures'[refreshed_at] ), "d mmm yyyy" )
		displayFolder: Shared
		lineageTag: 9ae635a3-cbd7-5c5e-b8f9-1b6e54ca97e8

	/// Header as-of line: the date of the last data refresh.
	measure Refreshed = "Refreshed " & [Refreshed date]
		displayFolder: Shared
		lineageTag: b6cd4b9c-f020-58dd-aa18-14b3c6046e80

	/// D60: the gold tick before a drill button's hint; 'none' (the SVG draws nothing) once a job row is picked, since the tick sits over the button.
	measure 'Hint tick job' = IF ( ISFILTERED ( dim_job[job_label] ), "none", "#FFB81C" )
		isHidden
		displayFolder: Shared
		lineageTag: f0b15162-77fe-52b6-a1fe-f1f791da2fed

	/// D60: the same for Find your major's button, once a major row is picked.
	measure 'Hint tick major' = IF ( ISFILTERED ( dim_major[major_label] ), "none", "#FFB81C" )
		isHidden
		displayFolder: Shared
		lineageTag: 7af95b83-ff07-5d98-b8d9-6598e65b0f8b

	/// Projected openings a year in degree-level jobs, NYC 2022-2032 (NYS DOL). Ties to 136,786.8.
	measure 'KPI openings a year' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "openings_per_year" )
		formatString: #,0
		displayFolder: Overview\Numbers
		lineageTag: a5dc43d0-c2bc-5a36-911b-ad3e4c5194b4

	/// Share of those openings that replace people leaving. Ties to 0.8692.
	measure 'KPI replacement share' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "replacement_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 2ca34314-0c9e-5fcb-b0ae-8480ac644d32

	/// Median NYC entry wage across degree-level jobs (NYS DOL entry wage, not new-graduate pay). Ties to 69,556.
	measure 'KPI starting pay' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "entry_wage_median" )
		formatString: $#,0
		displayFolder: Overview\Numbers
		lineageTag: 5a4b8934-340e-5e9b-98a9-492015d32920

	/// Real median pay change 2019-2025, degree-level jobs, NY metro. Ties to -0.0117.
	measure 'KPI real pay change' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "real_pay_change_degree" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: d8135ae7-b753-559c-b75c-d91e567fdca3

	/// Same, all jobs. Ties to 0.0255.
	measure 'KPI real pay change all jobs' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "real_pay_change_degree" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: dd895844-4333-5340-9f41-c5f6e2c6dcfa

	/// Associate's + bachelor's awarded by NYC colleges, 2024. Ties to 73,225.
	measure 'KPI degrees awarded' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "awards_2024" )
		formatString: #,0
		displayFolder: Overview\Numbers
		lineageTag: 4fef900e-4906-51a5-bc1a-a4b7d23b6776

	/// Of them at CUNY. Ties to 34,839.
	measure 'KPI degrees awarded CUNY' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "awards_2024" )
		formatString: #,0
		displayFolder: Overview\Numbers
		lineageTag: abd6cf46-32f7-516c-8324-2a25a7d156d0

	/// Change in awards 2019-2024, all NYC colleges. Ties to -0.1423.
	measure 'KPI degrees change' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "awards_change_since_2019" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 5d32c136-11d6-54b6-806a-da386977c2da

	/// Same, CUNY. Ties to -0.2451.
	measure 'KPI degrees change CUNY' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "awards_change_since_2019" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 2f00a9d5-cfee-5069-9d1f-c1e5d1c9915f

	/// Share of linked bachelor's awards in High AI-exposure majors, 2024. Ties to 0.1819.
	measure 'KPI high AI share' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "high_exposure_awards_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 4bba9eeb-4545-58fa-b971-12458f2bed1b

	/// Same, CUNY. Ties to 0.1702.
	measure 'KPI high AI share CUNY' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "high_exposure_awards_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 9c2ee7c6-8674-5a0e-b53e-a58f79b160f2

	/// Share of degree-level openings a year in jobs BLS rates High or Very high for AI exposure (BLS 2025-35 tiers x NYS DOL 2022-2032). Ties to 0.9441.
	measure 'KPI BLS AI share' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "bls_ai_high_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: cca620ae-07ff-5e0c-bcfb-55f341d3862f

	/// Same, openings in jobs that usually start with less than an associate's (the yardstick). Ties to 0.4097.
	measure 'KPI BLS AI share need less' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "bls_ai_high_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: d127a42c-b9a1-55f0-83fd-73956a48e01b

	/// MIT living wage, one adult, NY metro, 2026, before taxes. Ties to 65,510.
	measure 'KPI living wage' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "living_wage_line" )
		formatString: $#,0
		displayFolder: Overview\Numbers
		lineageTag: fc7ddac3-265a-53a2-9cbb-541f09e5e1f8

	/// NYC True Cost of Living, single adult (2022 data; note only). Ties to 70,334.
	measure 'KPI living wage city' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "living_wage_line" )
		formatString: $#,0
		displayFolder: Overview\Numbers
		lineageTag: d3ac9db2-ca7f-52f1-9654-d9323ff46444

	/// Share of degree-level openings whose entry wage starts below MIT's line. Ties to 0.2594.
	measure 'KPI below living wage' = CALCULATE ( MAX ( overview_kpi[value] ), overview_kpi[kpi_key] = "below_living_wage_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: b66206fd-98b1-5d23-a804-9e82bdafd31f

	/// Same, associate's-entry jobs. Ties to 0.7999.
	measure 'KPI below living wage assoc' = CALCULATE ( MAX ( overview_kpi[comparison_value] ), overview_kpi[kpi_key] = "below_living_wage_share" )
		formatString: 0.0%
		displayFolder: Overview\Numbers
		lineageTag: 8d05821c-0c04-5e39-a46c-9cc460471c4f

	/// Card frame shared by the four card images (v5, D54): 296 x 112, a white card with 8 px corners on the mist page, Inter 8 pt text, the number 20 pt in Bahnschrift (DIN).
	measure 'Card svg head' = "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'><style>text{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;fill:#5B6470}.v{font-family:Bahnschrift,'Segoe UI',sans-serif;font-size:26.67px;font-weight:600;fill:#1F2328}.q{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;font-weight:400;fill:#5B6470}.b{font-weight:400;fill:#1D3A83}.s{font-family:'Segoe UI Symbol','Segoe UI',sans-serif;font-size:8.53px}</style><rect width='296' height='112' rx='8' fill='#FFFFFF'/>"
		isHidden
		displayFolder: Overview\Numbers\Card parts
		lineageTag: 860fb788-cc1c-5bf3-a13a-b9794c4c6376

	/// People in the jobs behind the openings total, 2022 (NYS DOL base year): the 186 degree-level rows with a projection (164 ranked + 22 'All other'). Ties to 1,522,531.
	measure 'KPI base employment' = CALCULATE ( SUM ( job_profile[base_employment] ), REMOVEFILTERS (), job_profile[has_projection] = TRUE () )
		formatString: #,0
		displayFolder: Overview\Numbers
		lineageTag: be5ecc34-699a-5f7a-8c31-a98690f57465

	/// C1 yardstick (D45 item 1): openings a year per 100 people in degree-level jobs, same source and universe. Ties to 8.98 (136,786.8 / 1,522,531).
	measure 'KPI openings per 100' = DIVIDE ( [KPI openings a year], [KPI base employment] ) * 100
		formatString: 0.00
		displayFolder: Overview\Numbers
		lineageTag: c3ec0a83-af0c-5e16-bdf9-ffd2b8dd7eb3

	/// Card 3: CUNY's share of the degrees in words, by rule (45-50% nearly half, 50-55% about half, else the percent). Ties to 47.6% -> 'nearly half'.
	measure 'KPI CUNY share words' =
			VAR s = DIVIDE ( [KPI degrees awarded CUNY], [KPI degrees awarded] )
			RETURN
			    SWITCH ( TRUE (),
			        s >= 0.45 && s < 0.5, "nearly half",
			        s >= 0.5 && s < 0.55, "about half",
			        FORMAT ( s, "0%" ) & " of them" )
		displayFolder: Overview\Numbers
		lineageTag: d877617f-d470-5c56-9450-a39f618c807d

	/// Card 2's label: the degree-level jobs with an NYS DOL entry wage, the median's base (D58). Ties to 208.
	measure 'KPI entry wage jobs' = COUNTROWS ( FILTER ( ALL ( job_profile ), NOT ISBLANK ( job_profile[entry_wage] ) ) )
		formatString: #,0
		displayFolder: Overview\Numbers
		lineageTag: 82a9f5d6-26ee-596f-b882-f04c7e06afb7

	/// Card 1 image (SVG, v5; copy D59): openings a year (two significant digits, D45), what an opening is, the share that replaces people leaving the occupation (BLS separations: labor-force exits and occupational transfers), and the projection's maker and vintage. Ties to 'About 140K' · '87% replace people leaving the occupation'.
	measure 'Card openings' =
			VAR body =
			    [Card svg head]
			        & "<text x='16' y='22'>Openings a year, degree-level jobs ¹</text>"
			        & "<text class='v' x='16' y='50'>" & "About " & IF ( [KPI openings a year] < 1000, IF ( [KPI openings a year] < 1, "< 1", IF ( [KPI openings a year] < 10, FORMAT ( ROUND ( [KPI openings a year], 0 ), "0" ), FORMAT ( ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & "</text>"
			        & "<text x='16' y='70'>" & "Jobs to fill each year in NYC, 2022–2032" & "</text>"
			        & "<text x='16' y='84'>" & FORMAT ( [KPI replacement share], "0%" ) & " replace people leaving the occupation" & "</text>"
			        & "<text x='16' y='98'>" & "NY State projection from 2022 data, not postings" & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" )
		displayFolder: Overview\Numbers
		lineageTag: 65c90283-5e7d-5248-8986-31f6b256427a

	/// Screen-reader text for Card openings.
	measure 'Card openings alt' = "Openings a year in degree-level jobs, NYC: about " & IF ( [KPI openings a year] < 1000, IF ( [KPI openings a year] < 1, "< 1", IF ( [KPI openings a year] < 10, FORMAT ( ROUND ( [KPI openings a year], 0 ), "0" ), FORMAT ( ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " jobs to fill each year, 2022 to 2032, projected by New York State from 2022 data (not job postings); " & FORMAT ( [KPI replacement share], "0%" ) & " replace people leaving the occupation."
		isHidden
		displayFolder: Overview\Numbers\Alt text
		lineageTag: d2bc30a8-51e3-5559-962d-3ded2514b208

	/// Card 2 image (SVG, v5; D56, copy D59): the median of the degree-level jobs' entry wages, what an entry wage is (NYS DOL: 'average of bottom third of wages in an occupation'), the MIT living wage for one adult (D50 item 2), and that it is not an offer. Ties to 'Entry wage, middle of 208 degree-level jobs' · '$69.5K' · '$65.5K'.
	measure 'Card starting pay' =
			VAR body =
			    [Card svg head]
			        & "<text x='16' y='22'>Entry wage, middle of " & FORMAT ( [KPI entry wage jobs], "0" ) & " degree-level jobs ²</text>"
			        & "<text class='v' x='16' y='50'>" & "$" & IF ( ABS ( [KPI starting pay] ) >= 99950, FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0" ), FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0.0" ) ) & "K" & "<tspan class='q' dx='6'>a year, 2026 dollars</tspan></text>"
			        & "<text x='16' y='70'>" & "Average pay of each job's lowest-paid third" & "</text>"
			        & "<text x='16' y='84'>" & "Living wage for one adult: $" & IF ( ABS ( [KPI living wage] ) >= 99950, FORMAT ( ABS ( [KPI living wage] ) / 1000, "0" ), FORMAT ( ABS ( [KPI living wage] ) / 1000, "0.0" ) ) & "K" & " ³" & "</text>"
			        & "<text x='16' y='98'>" & "Not a job offer: new grads may earn more or less" & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" )
		displayFolder: Overview\Numbers
		lineageTag: 5803e11a-0b84-5739-9a1c-e03596d88924

	/// Screen-reader text for Card starting pay.
	measure 'Card starting pay alt' = "Entry wage, the middle of " & FORMAT ( [KPI entry wage jobs], "0" ) & " degree-level jobs, NYC: " & FORMAT ( [KPI starting pay], "$#,0" ) & " a year in 2026 dollars. A job's entry wage is New York State's average pay of its lowest-paid third of workers. It is not a job offer: new graduates may earn more or less. The living wage for one adult with no children in the NY metro area is " & FORMAT ( [KPI living wage], "$#,0" ) & " (MIT, 2026)."
		isHidden
		displayFolder: Overview\Numbers\Alt text
		lineageTag: e32e38fc-6eac-5716-8fc6-b1b7944b228f

	/// Card 3 image (SVG, v5; copy D59, stage 2): degrees awarded by all NYC colleges with the levels beside the number, CUNY's part in accent blue, the change since 2019 as two clauses, and the openings warning. Ties to '73.2K' · 'Of them, CUNY: 34.8K (48%)' · 'Down 14.2% since 2019; CUNY down 24.5%'.
	measure 'Card degrees' =
			VAR body =
			    [Card svg head]
			        & "<text x='16' y='22'>Degrees awarded by all NYC colleges, 2024 ⁴</text>"
			        & "<text class='v' x='16' y='50'>" & IF ( ABS ( [KPI degrees awarded] ) >= 99950, FORMAT ( ABS ( [KPI degrees awarded] ) / 1000, "0" ), FORMAT ( ABS ( [KPI degrees awarded] ) / 1000, "0.0" ) ) & "K" & "<tspan class='q' dx='6'>associate's and bachelor's</tspan></text>"
			        & "<text x='16' y='70'>" & "Of them, <tspan class='b'>CUNY: " & IF ( ABS ( [KPI degrees awarded CUNY] ) >= 99950, FORMAT ( ABS ( [KPI degrees awarded CUNY] ) / 1000, "0" ), FORMAT ( ABS ( [KPI degrees awarded CUNY] ) / 1000, "0.0" ) ) & "K" & " (" & FORMAT ( DIVIDE ( [KPI degrees awarded CUNY], [KPI degrees awarded] ), "0%" ) & ")</tspan>" & "</text>"
			        & "<text x='16' y='84'>" & IF ( [KPI degrees change] < 0, "Down ", "Up " ) & FORMAT ( ABS ( [KPI degrees change] ), "0.0%" ) & " since 2019; <tspan class='b'>CUNY " & IF ( [KPI degrees change CUNY] < 0, "down ", "up " ) & FORMAT ( ABS ( [KPI degrees change CUNY] ), "0.0%" ) & "</tspan>" & "</text>"
			        & "<text x='16' y='98'>" & "Not every opening goes to a new graduate" & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" )
		displayFolder: Overview\Numbers
		lineageTag: 6bd249af-157a-5119-8fae-b04f189242a4

	/// Screen-reader text for Card degrees.
	measure 'Card degrees alt' = "Associate's and bachelor's degrees awarded by all NYC colleges in 2024 (July 2023 to June 2024): " & FORMAT ( [KPI degrees awarded], "#,0" ) & ". Of them, CUNY (the City University of New York) awarded " & FORMAT ( [KPI degrees awarded CUNY], "#,0" ) & ", " & FORMAT ( DIVIDE ( [KPI degrees awarded CUNY], [KPI degrees awarded] ), "0%" ) & ". Change since 2019: " & FORMAT ( [KPI degrees change], "+0.0%;-0.0%" ) & ", CUNY " & FORMAT ( [KPI degrees change CUNY], "+0.0%;-0.0%" ) & ". Not every opening goes to a new graduate, so degrees and openings don't compare one-to-one."
		isHidden
		displayFolder: Overview\Numbers\Alt text
		lineageTag: 0dba2de8-5276-56d5-beae-56f28b20af3a

	/// Card 4 image (SVG, D50 item 1; copy D59): share of degree-level openings in jobs BLS rates High or Very high, what that means in BLS's words, the same share for jobs that need less schooling, and BLS's caveat. Ties to '94%' · '34%'.
	measure 'Card AI exposure' =
			VAR body =
			    [Card svg head]
			        & "<text x='16' y='22'>AI exposure, degree-level openings</text>"
			        & "<text class='v' x='16' y='50'>" & FORMAT ( [KPI BLS AI share], "0%" ) & "<tspan class='q' dx='6'>in jobs BLS rates High or Very high</tspan></text>"
			        & "<text x='16' y='70'>" & "Vs. other jobs, AI could do or help with more tasks" & "</text>"
			        & "<text x='16' y='84'>" & "For jobs needing less schooling: " & FORMAT ( [KPI BLS AI share need less], "0%" ) & "</text>"
			        & "<text x='16' y='98'>" & "Not a forecast of job loss or job growth" & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" )
		displayFolder: Overview\Numbers
		lineageTag: 874552b1-ad8d-5ad7-bd68-4322f85deb9f

	/// Screen-reader text for Card AI exposure.
	measure 'Card AI exposure alt' = "AI exposure: " & FORMAT ( [KPI BLS AI share], "0%" ) & " of degree-level openings a year in NYC are in jobs the U.S. Bureau of Labor Statistics rates High or Very high: compared with other jobs, AI could do or help with more of their tasks. For jobs that need less schooling, the share is " & FORMAT ( [KPI BLS AI share need less], "0%" ) & ". The rating is not a forecast of job loss or job growth."
		isHidden
		displayFolder: Overview\Numbers\Alt text
		lineageTag: a877cc36-d5a2-5072-8fa8-fc619f08207a

	/// NYC jobs by occupation (estimate: QCEW x state staffing pattern). Area nyc, every soc_level: the levels sum to the QCEW NYC total (mart-plan §6.3).
	measure 'NYC jobs estimate' = CALCULATE ( SUM ( job_employment_trend[nyc_employment_est] ), job_employment_trend[area_key] = "nyc" )
		formatString: #,0
		displayFolder: Overview\Trend
		lineageTag: 57a5a47b-bfc8-5d6a-a228-cc973ef00edc

	/// D37: only codes with a count in 2019 and 2025, so the change compares the same jobs (the 10 codes OEWS split in 2021 leave). Ties to 1,216,185 (2019) and 1,420,495 (2025).
	measure 'Degree-level jobs' = CALCULATE ( [NYC jobs estimate], job_employment_trend[is_degree_entry] = TRUE (), job_employment_trend[in_both_end_years] = TRUE () )
		formatString: #,0
		displayFolder: Overview\Trend
		lineageTag: 582da65b-8a61-55f5-a137-7aeb1955b596

	/// D37, as above. Ties to 3,234,319 (2019) and 3,181,010 (2025).
	measure 'All other jobs' = CALCULATE ( [NYC jobs estimate], job_employment_trend[is_degree_entry] = FALSE (), job_employment_trend[in_both_end_years] = TRUE () )
		formatString: #,0
		displayFolder: Overview\Trend
		lineageTag: 68f7b790-9a96-5676-b2fa-ad06a0f81569

	measure 'First year' = CALCULATE ( MIN ( job_employment_trend[year] ), REMOVEFILTERS ( job_employment_trend ) )
		formatString: 0
		isHidden
		displayFolder: Overview\Trend
		lineageTag: 238e070a-6094-5aec-bca8-47a858196837

	measure 'Last year' = CALCULATE ( MAX ( job_employment_trend[year] ), REMOVEFILTERS ( job_employment_trend ) )
		formatString: 0
		isHidden
		displayFolder: Overview\Trend
		lineageTag: 064203f2-774c-5e34-93c8-6442edeaa4c9

	/// Jobs that usually start with less than an associate's (BLS entry rank 1-4), D37 base. Ties to 2,992,443 (2019) and 2,905,136 (2025).
	measure 'Need-less jobs' = CALCULATE ( [NYC jobs estimate], dim_job[entry_education_rank] <= 4, job_employment_trend[in_both_end_years] = TRUE () )
		formatString: #,0
		displayFolder: Overview\Trend
		lineageTag: 45ea2187-58a3-5b78-85e2-4cd3de6895f4

	/// Jobs that usually start with a master's, doctorate or professional degree (BLS entry rank 7-8), D37 base. Ties to 241,876 (2019) and 275,874 (2025).
	measure 'Masters-level jobs' = CALCULATE ( [NYC jobs estimate], dim_job[entry_education_rank] >= 7, job_employment_trend[in_both_end_years] = TRUE () )
		formatString: #,0
		displayFolder: Overview\Trend
		lineageTag: 12b3469a-a0ae-5239-a7c5-a9eea39fa2d4

	/// Degree-level jobs, % change since the first year (2019), one point per year on the focal chart.
	measure 'Degree-level change since 2019' =
			VAR y = SELECTEDVALUE ( job_employment_trend[year] )
			VAR y0 = [First year]
			RETURN
			    IF ( NOT ISBLANK ( y ), DIVIDE ( [Degree-level jobs], CALCULATE ( [Degree-level jobs], job_employment_trend[year] = y0 ) ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Overview\Trend
		lineageTag: 09184165-e2f2-5b18-918c-468b45d91504

	/// Direct label at the last year only (the format string carries the series name).
	measure 'Degree-level end label' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Last year], [Degree-level change since 2019] )
		formatString: """Degree-level ""+0.0%;""Degree-level −""0.0%;""Degree-level ""0.0%"
		displayFolder: Overview\Trend
		lineageTag: 2499851c-1ab7-519f-9126-fb75753d19ea

	/// All other jobs, % change since the first year (2019), one point per year on the focal chart.
	measure 'All other change since 2019' =
			VAR y = SELECTEDVALUE ( job_employment_trend[year] )
			VAR y0 = [First year]
			RETURN
			    IF ( NOT ISBLANK ( y ), DIVIDE ( [All other jobs], CALCULATE ( [All other jobs], job_employment_trend[year] = y0 ) ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Overview\Trend
		lineageTag: 9b551d13-d261-5284-8e98-e830cabaaff5

	/// Direct label at the last year only (the format string carries the series name).
	measure 'All other end label' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Last year], [All other change since 2019] )
		formatString: """All other ""+0.0%;""All other −""0.0%;""All other ""0.0%"
		displayFolder: Overview\Trend
		lineageTag: 9badcd2f-69b6-5eb2-bd20-97fbb7929609

	/// Need less jobs, % change since the first year (2019), one point per year on the focal chart.
	measure 'Need less change since 2019' =
			VAR y = SELECTEDVALUE ( job_employment_trend[year] )
			VAR y0 = [First year]
			RETURN
			    IF ( NOT ISBLANK ( y ), DIVIDE ( [Need-less jobs], CALCULATE ( [Need-less jobs], job_employment_trend[year] = y0 ) ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Overview\Trend
		lineageTag: 0302d5b1-d154-51b3-802d-a422abfda22c

	/// Direct label at the last year only (the format string carries the series name).
	measure 'Need less end label' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Last year], [Need less change since 2019] )
		formatString: """Need less schooling ""+0.0%;""Need less schooling −""0.0%;""Need less schooling ""0.0%"
		displayFolder: Overview\Trend
		lineageTag: 5c435e1f-5356-5ec9-85c4-fed5b9b22881

	/// Masters jobs, % change since the first year (2019), one point per year on the focal chart.
	measure 'Masters change since 2019' =
			VAR y = SELECTEDVALUE ( job_employment_trend[year] )
			VAR y0 = [First year]
			RETURN
			    IF ( NOT ISBLANK ( y ), DIVIDE ( [Masters-level jobs], CALCULATE ( [Masters-level jobs], job_employment_trend[year] = y0 ) ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Overview\Trend
		lineageTag: 97d1a54d-b2fa-5246-9a7f-263869f1e12e

	/// Direct label at the last year only (the format string carries the series name).
	measure 'Masters end label' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Last year], [Masters change since 2019] )
		formatString: """Master’s or more ""+0.0%;""Master’s or more −""0.0%;""Master’s or more ""0.0%"
		displayFolder: Overview\Trend
		lineageTag: 1edfd9ac-bdae-5e13-b974-bf3ce6ba9ee7

	/// Overview intro line 2 (release, frame A): the share of NYC jobs the 225 hold, every degree-level code in the last year (not only codes in both end years, unlike the trend), and the openings share in words. Ties to 1,445,723 of 4,652,930 (31%) -> 'about 1.4M of the 4.7M … 3 in 10'; openings 136,787 of 599,058 (23%) -> 'about 1 in 4' (NYS DOL 2022-2032; written as words, the all-jobs openings total isn't in the model).
	measure 'Overview scope' =
			VAR y1 = [Last year]
			VAR deg = CALCULATE ( [NYC jobs estimate], REMOVEFILTERS ( job_employment_trend ), job_employment_trend[is_degree_entry] = TRUE (), job_employment_trend[year] = y1 )
			VAR alljobs = CALCULATE ( [NYC jobs estimate], REMOVEFILTERS ( job_employment_trend ), job_employment_trend[year] = y1 )
			VAR tenths = ROUND ( DIVIDE ( deg, alljobs ) * 10, 0 )
			RETURN
			    "They employ about " & IF ( deg >= 1000000, FORMAT ( ROUND ( deg, 1 - INT ( LOG10 ( deg ) ) ) / 1000000, "0.0" ) & "M", IF ( deg < 1000, IF ( deg < 1, "< 1", IF ( deg < 10, FORMAT ( ROUND ( deg, 0 ), "0" ), FORMAT ( ROUND ( deg, 1 - INT ( LOG10 ( deg ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( deg, 1 - INT ( LOG10 ( deg ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) ) & " of the " & IF ( alljobs >= 1000000, FORMAT ( ROUND ( alljobs, 1 - INT ( LOG10 ( alljobs ) ) ) / 1000000, "0.0" ) & "M", IF ( alljobs < 1000, IF ( alljobs < 1, "< 1", IF ( alljobs < 10, FORMAT ( ROUND ( alljobs, 0 ), "0" ), FORMAT ( ROUND ( alljobs, 1 - INT ( LOG10 ( alljobs ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( alljobs, 1 - INT ( LOG10 ( alljobs ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) ) & " people working in NYC in " & y1
			        & ", or " & tenths & " in 10 (our estimate), and about 1 in 4 openings a year. Not studied: jobs that start with less schooling, or with a master's or more."
		displayFolder: Overview\Text
		lineageTag: cfcd940d-9c93-52f1-b44c-2f3503d724ff

	/// Header answer, Overview (v5, study title 'Degree to Demand: NYC jobs for two- and four-year graduates', D54): growth (our estimate, whole percent with 'about', D45), openings a year (two significant digits), the share in jobs BLS rates as needing no related experience (in tenths) and, as the fair counterweight, the share that starts below MIT's living wage (D53 v2 round 3); non-breaking spaces keep '7 in 10' and '1 in 4' on one line. Readability check: 'typically' (BLS's word; 'no related experience' alone was repeated as '70% of openings need no experience') and 'are in jobs starting below' (1 in 4 of what?); 1,688 px = 3 lines in 576. Ties to 'Since 2019, NYC jobs that usually need a two- or four-year degree grew about 17% (our estimate). Of about 140,000 openings a year projected to 2032, 7 in 10 are in jobs rated as typically needing no related experience, but 1 in 4 are in jobs starting below a living wage.' (+16.8%; 136,787; 94,103 / 136,787 = 69%; 0.2594 -> 1 in 4).
	measure 'Overview answer' =
			VAR y0 = [First year]
			VAR y1 = [Last year]
			VAR op = [KPI openings a year]
			VAR s0 = DIVIDE ( [WF openings none], [WF openings all] )
			VAR g = CALCULATE ( [Degree-level change since 2019], job_employment_trend[year] = y1 )
			VAR b = [KPI below living wage]
			VAR nb = UNICHAR ( 160 )
			RETURN
			    "Since " & y0 & ", NYC jobs that usually need a two- or four-year degree " & IF ( g >= 0, "grew", "shrank" ) & " about " & FORMAT ( ABS ( g ), "0%" )
			        & " (our estimate). Of about " & IF ( op < 1, "< 1", IF ( op < 10, FORMAT ( ROUND ( op, 0 ), "0" ), FORMAT ( ROUND ( op, 1 - INT ( LOG10 ( op ) ) ), "#,0" ) ) ) & " openings a year to 2032, " & ROUND ( s0 * 10, 0 ) & nb & "in" & nb & "10"
			        & " are in jobs BLS rates as needing no related experience, but 1" & nb & "in" & nb & ROUND ( DIVIDE ( 1, b ), 0 ) & " pay an entry wage below a living wage."
		displayFolder: Overview\Text
		lineageTag: 5410fa6d-d83b-5c46-8a64-8583e26bf27c

	/// Header Data line (D53 v2: the projection period joins it; v5: on the answer's last baseline). Ties to 'Data: jobs 2019–25 · openings 2022–32 · degrees 2024 · refreshed <date>'.
	measure 'Overview data line' = "Data: jobs " & [First year] & "–" & RIGHT ( [Last year], 2 ) & " · openings 2022–32 · degrees 2024 · refreshed " & [Refreshed date]
		displayFolder: Overview\Text
		lineageTag: 561b6f72-7a9d-5c08-a311-0af83b48f122

	/// Focal chart title (D53 v2: our estimate in whole percent with 'about', D45 precision; What we found's finding 1 keeps +16.8%). Ties to 'Degree-level jobs grew about 17%; jobs needing less schooling fell about 3%' (D37).
	measure 'Trend title' =
			VAR y1 = [Last year]
			VAR g = CALCULATE ( [Degree-level change since 2019], job_employment_trend[year] = y1 )
			VAR o = CALCULATE ( [Need less change since 2019], job_employment_trend[year] = y1 )
			RETURN
			    "Degree-level jobs " & IF ( g >= 0, "grew", "fell" ) & " about " & FORMAT ( ABS ( g ), "0%" )
			        & "; jobs needing less schooling " & IF ( o >= 0, "grew", "fell" ) & " about " & FORMAT ( ABS ( o ), "0%" )
		displayFolder: Overview\Text
		lineageTag: 91cc65d9-1c93-5c56-b5bc-1d0025f6d5ab

	measure 'Trend alt' =
			VAR y1 = [Last year]
			VAR m = CALCULATE ( [Masters change since 2019], job_employment_trend[year] = y1 )
			RETURN
			    "Line chart of NYC jobs, percent change since " & [First year] & ", one point per year to " & [Last year] & ". " & [Trend title]
			        & "; jobs that start with a master's or more " & IF ( m >= 0, "grew ", "fell " ) & FORMAT ( ABS ( m ), "0.0%" ) & ". All three lines are estimates."
		isHidden
		displayFolder: Overview\Text
		lineageTag: 75b83394-fa20-522d-829e-2fdb03e563b5

	/// NYC private payroll jobs added 2019 -> 2025 (QCEW). Health care ties to +206,694.
	measure 'Sector jobs added' = SUM ( industry_profile[change_2019_2025] )
		formatString: +#,0;−#,0
		displayFolder: Overview\Sectors
		lineageTag: 32ee483b-9a90-5106-ac6a-f1fd4b914e34

	/// Same value in thousands, drawn by the bar: label '+207K · 21% degree-level'.
	measure 'Sector jobs added K' = DIVIDE ( [Sector jobs added], 1000 )
		isHidden
		displayFolder: Overview\Sectors
		lineageTag: 6fdb8d83-9154-5349-b742-b4b8a0ec9688

		formatStringDefinition = VAR share = FORMAT ( MAX ( industry_profile[degree_reachable_share] ), "0%" ) VAR lit = """K · " & share & " degree-level""" VAR big = ABS ( SELECTEDMEASURE () ) >= 99.95 RETURN IF ( big, "+0", "+0.0" ) & lit & ";" & IF ( big, "−0", "−0.0" ) & lit

	/// Degree-level jobs in the sector (estimate). Picks the six sectors that hold 80% of them (Top N filter on the bar).
	measure 'Sector degree-level jobs' = SUM ( industry_profile[degree_reachable_jobs_est] )
		formatString: #,0
		displayFolder: Overview\Sectors
		lineageTag: c9dc4966-28dd-5c85-92a8-da48ea5fc335

	/// Accent on the sector that added the most jobs; context gray for the rest.
	measure 'Sector bar color' =
			VAR most = MAXX ( ALLSELECTED ( dim_industry[industry_short_title] ), [Sector jobs added] )
			RETURN IF ( [Sector jobs added] = most, "#1D3A83", "#828B97" )
		isHidden
		displayFolder: Overview\Sectors
		lineageTag: ea8f2c1c-afb9-503d-8b6f-8a96bd2d4d80

	/// Value-axis end (thousands): the longest bar takes 1/3.2 of the plot so its ~150px outside label fits.
	measure 'Sector axis end' = MAXX ( ALL ( dim_industry[industry_short_title] ), [Sector jobs added K] ) * 3.2
		formatString: #,0.0
		isHidden
		displayFolder: Overview\Sectors
		lineageTag: 74d4908e-cf73-58cf-9284-09576db46deb

	/// Bar title. Ties to Health care, 20.7% -> 1 in 5.
	measure 'Sector title' =
			VAR six = TOPN ( 6, FILTER ( ALL ( dim_industry[industry_short_title] ), NOT ISBLANK ( [Sector degree-level jobs] ) ), [Sector degree-level jobs], DESC )
			VAR best = TOPN ( 1, six, [Sector jobs added], DESC )
			VAR top_sector = MAXX ( best, dim_industry[industry_short_title] )
			VAR share = CALCULATE ( MAX ( industry_profile[degree_reachable_share] ), dim_industry[industry_short_title] = top_sector )
			RETURN
			    top_sector & " added the most jobs, "
			        & IF ( share < 0.5, "but 1 in " & ROUND ( DIVIDE ( 1, share ), 0 ) & " of its jobs is degree-level", "and " & FORMAT ( share, "0%" ) & " of its jobs are degree-level" )
		displayFolder: Overview\Text
		lineageTag: 092b54d7-03dc-5f85-99d8-7f509236ab21

	measure 'Sector alt' = "Bar chart of NYC private payroll jobs added since 2019 in the six sectors that hold most degree-level jobs. " & [Sector title] & "."
		isHidden
		displayFolder: Overview\Text
		lineageTag: 39ab8020-90cd-5e2d-9bd9-04cd65813288

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview note 1' = "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "projection_vintage", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: bb3a9586-4240-5d88-9701-c00c3e974e00

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview note 2' = "² " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "entry_wage_definition", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: a2e765b6-6d46-5f1e-97ae-a102a7c919d0

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview note 3' = "³ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "living_wage", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: 5c3e5e54-078f-5cd3-947e-4427fe9aa7da

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview note 4' = "⁴ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "awards_2024_provisional", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: 55bb121f-5f9e-5df4-ab74-088d114b717e

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview note 5' = "⁵ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "nyc_jobs_estimate", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: 680d2dd1-e6e4-5547-a0cc-79e56bbd2421

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Overview sources' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "sources_overview", footnote[page_key], "overview" )
		displayFolder: Shared\Footer
		lineageTag: 50e0723d-d928-571b-8f7b-9c163a78dd23

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs note 1' = "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "openings_average", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: 08dee65c-499f-5663-9fcc-f2952feb100b

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs note 2' = "² " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "bls_work_experience", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: 3b047b7c-54e9-5a20-85ff-7288456fa1e4

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs note 3' = "³ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "entry_wage_definition", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: 1b734d6f-9021-5a4d-8ce3-2be5e1bdd1d5

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs note 4' = "⁴ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "imputed_projection", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: e0b997ad-7cd8-5978-b4b1-1eb7ac4cea90

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs note diamond' = "◆ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "hybrid_2019", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: 1a1cc3eb-b72d-56c9-bbdb-d70ca1a34ecc

	/// Footer cell (D11; marks in reading order, clarity mockups).
	measure 'Jobs sources' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "sources_jobs", footnote[page_key], "jobs" )
		displayFolder: Shared\Footer
		lineageTag: 1b40c42d-ce00-5207-9052-b58fe8bcbe8f

	/// Projected openings a year 2022-2032, jobs with a projection, not 'All other' (164 jobs). Ranks List 1 (Top 25 in the visual).
	measure 'L1 openings' = CALCULATE ( SUM ( job_profile[annual_openings_avg] ), KEEPFILTERS ( job_profile[has_projection] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
		formatString: #,0
		displayFolder: Jobs\List 1
		lineageTag: 58a1551a-fa77-543d-8e24-1a416ab2b2f3

	/// Same value, drawn as the data bar.
	measure 'L1 openings bar' = [L1 openings]
		formatString: #,0
		displayFolder: Jobs\List 1
		lineageTag: d845c18b-74aa-5d11-84e7-a22cd0cd50e8

	/// Details, List 1: two significant digits (D45 item 5; the subtitle says rounded), 'our estimate ⁴' in words for the 18 filled jobs (D45 item 7). Ties to 9,800; Software Developers '4,300 our estimate ⁴'.
	measure 'L1 openings text' =
			VAR v = [L1 openings]
			RETURN IF ( NOT ISBLANK ( v ), IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & IF ( SELECTEDVALUE ( job_profile[is_imputed] ), " our estimate ⁴" ) )
		displayFolder: Jobs\List 1
		lineageTag: 5133cc37-3477-5fd0-9df6-01a8c0e16182

	measure 'Job growth dot' = IF ( NOT ISBLANK ( [L1 openings] ), "●" )
		displayFolder: Jobs\List 1
		lineageTag: 213126da-14e9-5440-9f85-c0d92989d391

	/// Growth-share ramp, light -> dark (design-brief §10.2). The band is always written beside the dot.
	measure 'Job growth dot color' = SWITCH ( SELECTEDVALUE ( job_profile[growth_share_band_rank] ), 1, "#C3CCE2", 2, "#8496C4", 3, "#4A62A0", 4, "#1D3A83" )
		isHidden
		displayFolder: Jobs\List 1
		lineageTag: ab249e3f-7754-568f-bdd9-8d9f66f6aff9

	/// Share of openings from growth (29%). D58 (fact-check): the band words left ('29% growth-led' got 71% of its openings from people leaving; '10% replacement' read as the opposite); the dot's color still marks the band.
	measure 'Job growth text' =
			VAR s = SELECTEDVALUE ( job_profile[growth_share] )
			RETURN
			    IF ( NOT ISBLANK ( [L1 openings] ) && NOT ISBLANK ( s ), IF ( s < 0, "−", "" ) & FORMAT ( ABS ( s ), "0%" ) )
		displayFolder: Jobs\List 1
		lineageTag: 65c9c9e8-a895-50a2-90b7-8cb265d10cda

	/// Line under List 1, Details only (D48 item 7). Ties to 22 groups, about 6,600 openings.
	measure 'Not ranked line' =
			VAR n = CALCULATE ( COUNTROWS ( job_profile ), KEEPFILTERS ( job_profile[is_all_other] = TRUE () ), KEEPFILTERS ( job_profile[has_projection] = TRUE () ) )
			VAR o = CALCULATE ( SUM ( job_profile[annual_openings_avg] ), KEEPFILTERS ( job_profile[is_all_other] = TRUE () ), KEEPFILTERS ( job_profile[has_projection] = TRUE () ) )
			RETURN
			    IF ( n > 0, "Not ranked: " & n & " “All other” groups, about " & IF ( o < 1, "< 1", IF ( o < 10, FORMAT ( ROUND ( o, 0 ), "0" ), FORMAT ( ROUND ( o, 1 - INT ( LOG10 ( o ) ) ), "#,0" ) ) ) & " openings a year (in every total)" )
		displayFolder: Jobs\List 1
		lineageTag: de7bb183-2c2c-52cd-9cdd-dbf1a3e6a577

	/// BLS typical work experience in a related job (D26). The job page and its signals keep these words (approved, built and tested).
	measure 'Job experience' = SWITCH ( SELECTEDVALUE ( job_profile[entry_experience_rank] ), 1, "None", 2, "< 5 years", 3, "5+ years" )
		displayFolder: Jobs\Cells
		lineageTag: 8a10483d-cee6-5fe6-97e7-374af606876f

	/// Jobs lists and the A-Z finder, 'Experience asked' column (D48 item 7): BLS typical work experience in words on every row; 'None' in label gray (Job experience color).
	measure 'Job experience asked' = SWITCH ( SELECTEDVALUE ( job_profile[entry_experience_rank] ), 1, "None", 2, "Under 5 yrs", 3, "5+ yrs" )
		displayFolder: Jobs\Cells
		lineageTag: 743fa770-6c09-592d-a75d-f57e09734ea8

	/// A-Z and Major page 'Experience asked' cells: BLS typical work experience, plus BLS typical on-the-job training where it is long-term (more than 12 months; 9 jobs, e.g. Actuaries) or an internship/residency (4) and no experience is asked. Ties to Actuaries 'None · 1 yr+ training', Architects 'None · internship'.
	measure 'Job experience asked full' =
			VAR e = [Job experience asked]
			VAR t = SELECTEDVALUE ( job_profile[entry_training] )
			RETURN
			    IF ( e = "None" && t = "Long-term on-the-job training", "None · 1 yr+ training",
			        IF ( e = "None" && t = "Internship/residency", "None · internship", e ) )
		displayFolder: Jobs\Cells
		lineageTag: c8622495-a3b6-574d-a079-df7048eba765

	measure 'Job experience color' = IF ( SELECTEDVALUE ( job_profile[entry_experience_rank] ) = 1, "#5B6470", "#1F2328" )
		isHidden
		displayFolder: Jobs\Cells
		lineageTag: 8536ccf9-4d76-5990-b394-de1bbb121f0d

	/// NYS DOL entry wage, 2025 ($95.8K).
	measure 'Job starting pay' =
			VAR w = SELECTEDVALUE ( job_profile[entry_wage] )
			RETURN IF ( NOT ISBLANK ( w ), "$" & IF ( ABS ( w ) >= 99950, FORMAT ( ABS ( w ) / 1000, "0" ), FORMAT ( ABS ( w ) / 1000, "0.0" ) ) & "K" )
		displayFolder: Jobs\Cells
		lineageTag: b8e6c49b-1b4c-5ad7-bba7-48d466eef9b0

	/// NYC jobs added 2019 -> 2025 (estimate), jobs with at least 1,000 people in both years, not 'All other' (121 jobs).
	measure 'L2 jobs added' = CALCULATE ( SUM ( job_profile[nyc_change_2019_2025] ), KEEPFILTERS ( job_profile[clears_floor_1000] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
		formatString: +#,0;−#,0
		displayFolder: Jobs\List 2
		lineageTag: a84a4f80-4309-547a-bb1c-a39374690627

	measure 'L2 jobs 2019' = CALCULATE ( SUM ( job_profile[nyc_employment_2019] ), KEEPFILTERS ( job_profile[clears_floor_1000] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
		formatString: #,0
		isHidden
		displayFolder: Jobs\List 2
		lineageTag: 581fcd00-17f1-57ce-b709-770b65d0f523

	measure 'L2 change' = DIVIDE ( [L2 jobs added], [L2 jobs 2019] )
		formatString: +0.0%;−0.0%
		displayFolder: Jobs\List 2
		lineageTag: a7f506b9-8887-53bd-8fa7-234693c5bbdd

	/// The published NY metro series, the check on the NYC estimate (D8).
	measure 'L2 metro change' =
			VAR a = CALCULATE ( SUM ( job_profile[metro_employment_2019] ), KEEPFILTERS ( job_profile[clears_floor_1000] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
			VAR b = CALCULATE ( SUM ( job_profile[metro_employment_2025] ), KEEPFILTERS ( job_profile[clears_floor_1000] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
			RETURN IF ( NOT ISBLANK ( a ) && NOT ISBLANK ( b ), DIVIDE ( b, a ) - 1 )
		formatString: +0.0%;−0.0%
		displayFolder: Jobs\List 2
		lineageTag: f513918e-f28e-5840-8316-fa0f04af82e3

	/// What List 2 ranks by, from the button slicer: jobs added, % change, or jobs lost. Ranks List 2 (Top 25 in the visual) and is drawn as its data bar.
	measure 'L2 ranked value' =
			VAR r = SELECTEDVALUE ( list2_ranking[ranking], "Jobs added" )
			VAR a = [L2 jobs added]
			RETURN
			    SWITCH ( r,
			        "Jobs added", IF ( a > 0, a ),
			        // D58: a ◆ job's 2019 count is its old combined code's, so a percent is mostly relabeling (Data Scientists +1,217%)
			        "% change", IF ( a > 0 && NOT SELECTEDVALUE ( job_profile[split_2019] ), [L2 change] ),
			        "Fewer jobs", IF ( a < 0, -a )
			    )
		formatString: #,0.00
		displayFolder: Jobs\List 2
		lineageTag: 807df0dc-c7d1-527e-8996-f99f4bc4c8b3

	/// Jobs added (our estimate), three significant digits; ◆ beside the number when the 2019 count comes from split codes (D48 item 7). Ties to '+28.4K ◆'.
	measure 'L2 jobs added text' =
			VAR a = [L2 jobs added]
			RETURN IF ( NOT ISBLANK ( a ), IF ( a < 0, "−", "+" ) & IF ( ABS ( a ) >= 99950, FORMAT ( ABS ( a ) / 1000, "0" ), FORMAT ( ABS ( a ) / 1000, "0.0" ) ) & "K" & IF ( SELECTEDVALUE ( job_profile[split_2019] ), " ◆" ) )
		displayFolder: Jobs\List 2
		lineageTag: cc691e16-759c-5356-a108-a489166930f4

	/// +68.2%; no decimal at 100% or more (+1,217%).
	measure 'L2 change text' =
			VAR p = [L2 change]
			VAR x = ABS ( p )
			RETURN IF ( NOT ISBLANK ( p ), IF ( p < 0, "−", "+" ) & IF ( x >= 0.9995, FORMAT ( x, "#,0%" ), FORMAT ( x, "0.0%" ) ) )
		displayFolder: Jobs\List 2
		lineageTag: 48b997e1-c3c5-55ca-b127-2aefb2388fd8

	measure 'L2 metro change text' =
			VAR p = [L2 metro change]
			VAR x = ABS ( p )
			RETURN IF ( NOT ISBLANK ( p ), IF ( p < 0, "−", "+" ) & IF ( x >= 0.9995, FORMAT ( x, "#,0%" ), FORMAT ( x, "0.0%" ) ) )
		displayFolder: Jobs\List 2
		lineageTag: 3ea0ce08-8319-5a1e-9382-205f731f16e1

	/// Header answer line 1, page 1: the first row of List 1 under the slicers, two significant digits with 'about' (D45). Ties to 'Most openings: General and Operations Managers, about 9,800 a year (projected); asks 5+ years of experience.'
	measure 'Jobs answer openings' =
			VAR t = TOPN ( 1, FILTER ( VALUES ( job_profile[soc_code] ), NOT ISBLANK ( [L1 openings] ) ), [L1 openings], DESC )
			VAR code = MAXX ( t, job_profile[soc_code] )
			VAR title = CALCULATE ( MAX ( job_profile[soc_short_title] ), job_profile[soc_code] = code )
			VAR v = CALCULATE ( [L1 openings], job_profile[soc_code] = code )
			VAR xp = CALCULATE ( MAX ( job_profile[entry_experience_rank] ), job_profile[soc_code] = code )
			RETURN
			    IF ( ISBLANK ( code ), "No job in this selection has a projection.",
			        "Most openings: " & title & ", about " & IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & " a year ("
			            & IF ( CALCULATE ( COUNTROWS ( job_profile ), job_profile[soc_code] = code, job_profile[is_imputed] = TRUE () ) > 0, "our estimate", "projected" ) & ")"
			            & SWITCH ( xp, 3, "; BLS rates it as typically needing 5+ years of experience.", 2, "; BLS rates it as typically needing under 5 years of experience.", "." ) )
		displayFolder: Jobs\Text
		lineageTag: d09112a5-5595-52e9-b978-76bab0a2fb63

	/// Header answer line 2, page 1: the first row of List 2 (jobs added), said as our estimate (D48). Ties to 'Most jobs added since 2019: Software Developers, +28,400 ◆ (our estimate).'
	measure 'Jobs answer added' =
			VAR t = TOPN ( 1, FILTER ( VALUES ( job_profile[soc_code] ), [L2 jobs added] > 0 ), [L2 jobs added], DESC )
			VAR code = MAXX ( t, job_profile[soc_code] )
			VAR t1 = TOPN ( 1, FILTER ( VALUES ( job_profile[soc_code] ), NOT ISBLANK ( [L1 openings] ) ), [L1 openings], DESC )
			VAR same = code = MAXX ( t1, job_profile[soc_code] )
			VAR title = CALCULATE ( MAX ( job_profile[soc_short_title] ), job_profile[soc_code] = code )
			VAR a = CALCULATE ( [L2 jobs added], job_profile[soc_code] = code )
			VAR split = CALCULATE ( COUNTROWS ( job_profile ), job_profile[soc_code] = code, job_profile[split_2019] = TRUE () ) > 0
			VAR num = "+" & FORMAT ( ROUND ( a, -2 ), "#,0" ) & IF ( split, " ◆", "" )
			RETURN
			    IF ( ISBLANK ( code ), "No job in this selection added jobs since 2019.",
			        IF ( same, title & " also added the most jobs since 2019, " & num & " (our estimate).",
			            "Most jobs added since 2019: " & title & ", " & num & " (our estimate)." ) )
		displayFolder: Jobs\Text
		lineageTag: 7d589111-4e52-5023-acec-d528d9cbb047

	/// Header answer, Jobs (v5: one wrapping measure, up to 3 lines at 10 pt in the 576 px column): the two sentences above, in order.
	measure 'Jobs answer' = [Jobs answer openings] & " " & [Jobs answer added]
		displayFolder: Jobs\Text
		lineageTag: a00a62bc-b068-5225-9dd8-b01f81fb4fb3

	/// Filter-context line (design-brief §4.1).
	measure 'Jobs showing' =
			VAR areas =
			    IF ( ISFILTERED ( dim_cluster[cluster_name] ),
			        VAR n = COUNTROWS ( VALUES ( dim_cluster[cluster_name] ) )
			        RETURN IF ( n = 1, SELECTEDVALUE ( dim_cluster[cluster_name] ), n & " career areas" ),
			        "all career areas" )
			VAR lvl =
			    IF ( ISFILTERED ( dim_degree_level[degree_level] ) && HASONEVALUE ( dim_degree_level[degree_level] ),
			        LOWER ( SELECTEDVALUE ( dim_degree_level[degree_level] ) ) & " only",
			        "associate's and bachelor's" )
			RETURN "Showing: " & areas & " · " & lvl & " · NYC"
		displayFolder: Jobs\Text
		lineageTag: 6354d6c6-1d47-5cb7-89b9-c49a7d85c800

	measure 'List 1 alt' = "Table of the 25 degree-level jobs with the most projected openings a year in NYC, 2022 to 2032, with growth share, experience and entry wage. " & [Jobs answer openings]
		isHidden
		displayFolder: Jobs\Text
		lineageTag: ba6bc660-bf24-5d2b-a671-816a325ddc70

	measure 'List 2 alt' = "Table of up to 25 degree-level jobs ranked by " & LOWER ( SELECTEDVALUE ( list2_ranking[ranking], "Jobs added" ) ) & " in NYC since 2019 (estimate), with the NY metro change, experience and entry wage. " & [Jobs answer added]
		isHidden
		displayFolder: Jobs\Text
		lineageTag: 4a539282-66b6-5eaa-bee9-fa8dc768eba8

	/// Row name on the Jobs lists and the A-Z finder: the short title without ° or ◆ (B2); dim_job[job_label] stays in the row, 1 px wide, as the drill-through field. The marks' meaning is said beside the number it qualifies.
	measure 'Job name' = SELECTEDVALUE ( job_profile[soc_short_title] )
		displayFolder: Jobs\Summary
		lineageTag: 4100c215-75d2-5672-836f-4c971918992f

	/// Estimated width of a row's bar label in px, Inter 8 pt (the scale below keeps every label inside the cell).
	measure 'S1 label px' =
			VAR v = [L1 openings]
			VAR mx = MAXX ( ALLSELECTED ( dim_job[job_label] ), [L1 openings] )
			RETURN IF ( v > 0, IF ( v >= mx, 28, 0 ) + 7 * LEN ( IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) ) + IF ( SELECTEDVALUE ( job_profile[is_imputed] ) = TRUE (), 72, 0 ) )
		formatString: 0.0
		isHidden
		displayFolder: Jobs\Summary
		lineageTag: 7f63425d-f500-5ffb-9b0a-e426dfbb8304

	/// The longest bar's length in the view: 120 px, less when a row's label wouldn't fit after its bar (v5 cell 212 px).
	measure 'S1 bar scale' =
			VAR mx = MAXX ( ALLSELECTED ( dim_job[job_label] ), [L1 openings] )
			VAR fit = MINX ( FILTER ( ALLSELECTED ( dim_job[job_label] ), [L1 openings] > 0 ), DIVIDE ( ( 198 - [S1 label px] ) * mx, [L1 openings] ) )
			RETURN MIN ( 120, fit )
		formatString: 0.0
		isHidden
		displayFolder: Jobs\Summary
		lineageTag: 20e8b3b0-8a8a-5f00-b2e0-e197a30bf731

	/// Summary List 1 bar cell: openings a year, two significant digits; 'about' on the first row only (D46 item 2: the subtitle says rounded); a filled job draws hollow and says 'our estimate ⁴' (D45 item 7). Ties to 'about 9,800'; Software Developers '4,300 our estimate ⁴'.
	measure 'S1 bar' =
			VAR v = [L1 openings]
			VAR mx = MAXX ( ALLSELECTED ( dim_job[job_label] ), [L1 openings] )
			VAR w = MAX ( 2, ROUND ( [S1 bar scale] * DIVIDE ( v, mx ), 0 ) )
			VAR hollow = SELECTEDVALUE ( job_profile[is_imputed] ) = TRUE ()
			VAR bar =
			    IF ( hollow,
			        "<rect x='5' y='3' width='" & ( w - 2 ) & "' height='12' rx='2' fill='#FFFFFF' stroke='#828B97' stroke-width='1.5'/>",
			        "<rect x='4' y='2' width='" & w & "' height='14' rx='2' fill='#828B97'/>" )
			VAR body = "<svg xmlns='http://www.w3.org/2000/svg' width='212' height='18' viewBox='0 0 212 18'><style>text{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;fill:#1F2328}.l{fill:#5B6470}.b{font-weight:400}</style>" & bar & "<text x='" & ( w + 12 ) & "' y='12'>" & IF ( v >= mx, "<tspan class='l'>about </tspan>" ) & "<tspan class='b'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ), "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</tspan>" & IF ( SELECTEDVALUE ( job_profile[is_imputed] ) = TRUE (), "<tspan class='l'> our estimate ⁴</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( NOT ISBLANK ( v ) && v > 0, "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		dataCategory: ImageUrl
		displayFolder: Jobs\Summary
		lineageTag: 9578a4f1-78af-5f3e-9644-17943a2916ff

	/// Summary List 2: jobs added since 2019 (our estimate), positive only; ranks the top 10 and draws the bars. Ties to Software Developers +28,415.
	measure 'S2 added' =
			VAR a = [L2 jobs added]
			RETURN IF ( a > 0, a )
		formatString: +#,0;−#,0
		displayFolder: Jobs\Summary
		lineageTag: 9e6d832d-77b6-5500-8561-c5f4d6e4c83f

	/// Summary List 2 bar cell: '+28.4K' (three significant digits, our estimate; the subtitle says so), ◆ beside the number for split 2019 codes (D48 item 7).
	measure 'S2 bar' =
			VAR v = [S2 added]
			VAR mx = MAXX ( ALLSELECTED ( dim_job[job_label] ), [S2 added] )
			VAR w = MAX ( 2, ROUND ( 120 * DIVIDE ( v, mx ), 0 ) )
			VAR hollow = FALSE ()
			VAR bar =
			    IF ( hollow,
			        "<rect x='5' y='3' width='" & ( w - 2 ) & "' height='12' rx='2' fill='#FFFFFF' stroke='#828B97' stroke-width='1.5'/>",
			        "<rect x='4' y='2' width='" & w & "' height='14' rx='2' fill='#828B97'/>" )
			VAR body = "<svg xmlns='http://www.w3.org/2000/svg' width='212' height='18' viewBox='0 0 212 18'><style>text{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;fill:#1F2328}.l{fill:#5B6470}.b{font-weight:400}</style>" & bar & "<text x='" & ( w + 12 ) & "' y='12'>" & "<tspan class='b'>+" & IF ( ABS ( v ) >= 99950, FORMAT ( ABS ( v ) / 1000, "0" ), FORMAT ( ABS ( v ) / 1000, "0.0" ) ) & "K" & "</tspan>" & IF ( SELECTEDVALUE ( job_profile[split_2019] ), "<tspan class='l'> ◆</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( NOT ISBLANK ( v ) && v > 0, "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		dataCategory: ImageUrl
		displayFolder: Jobs\Summary
		lineageTag: 5bbf86f1-8ed2-5707-814d-890bc854912b

	/// The fixed universe of the rank (D45 item 1): degree-level jobs with a projection, 'All other' groups excluded; ignores every slicer. Ties to 164.
	measure 'Ranked jobs' = CALCULATE ( COUNTROWS ( job_profile ), REMOVEFILTERS (), job_profile[has_projection] = TRUE (), job_profile[is_all_other] = FALSE () )
		formatString: 0
		displayFolder: Jobs\Summary
		lineageTag: 20ec86f6-a9f7-53dc-ba18-c5744e3c29ed

	/// Jobs the A-Z finder lists (B9: counted, not typed). Ties to 225 (198 detailed, 23 'All other', 4 broad codes).
	measure 'Labeled jobs' = CALCULATE ( COUNTROWS ( dim_job ), REMOVEFILTERS (), NOT ISBLANK ( dim_job[job_label] ) )
		formatString: 0
		displayFolder: Jobs\Summary
		lineageTag: b2f8d929-db69-55fd-b314-45beb597ce98

	/// Controls-row link to the A-Z finder (B3, B9).
	measure 'Find jobs link' = "Find any of " & [Labeled jobs] & " degree-level jobs →"
		displayFolder: Jobs\Summary
		lineageTag: bcca8492-309d-5f22-bdd7-29effa1a67b7

	/// What we found, bottom line: the link after 'The detail for one job:'.
	measure 'Find jobs line' = "find any of " & [Labeled jobs] & " degree-level jobs →"
		displayFolder: Jobs\Summary
		lineageTag: fb765c8a-d9c6-54a1-8acd-7647de71132a

	/// Summary List 1 subtitle: the universe counted under the slicers (bias check 'name the universe'); says why it is fewer than the 225 (38 named jobs have no NYC projection, 23 'all other' groups aren't ranked). Ties to 'Top 10 of 164 degree-level jobs with an NYC projection · 2022–2032, rounded ¹'.
	measure 'S1 subtitle' =
			VAR n = CALCULATE ( COUNTROWS ( job_profile ), KEEPFILTERS ( job_profile[has_projection] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
			RETURN
			    SWITCH ( TRUE (),
			        n = 0, "No degree-level job in this selection has a projection",
			        n = 1, "The one degree-level job here with an NYC projection · 2022–2032, rounded ¹",
			        n <= 10, "All " & n & " degree-level jobs here with an NYC projection · 2022–2032, rounded ¹",
			        "Top 10 of " & n & " named degree-level jobs with an NYC projection · 2022–2032, rounded ¹" )
		displayFolder: Jobs\Summary
		lineageTag: 16378827-4988-5f30-af1d-4d5ad440d8b1

	/// Summary List 2 subtitle; names the years and 'degree-level' so the 121 reads as a part of the 225. Ties to 'Top 10 of 121 degree-level jobs with 1,000+ people in 2019 and 2025 · NYC · our estimate'.
	measure 'S2 subtitle' =
			VAR n = CALCULATE ( COUNTROWS ( job_profile ), KEEPFILTERS ( job_profile[clears_floor_1000] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
			RETURN
			    SWITCH ( TRUE (),
			        n = 0, "No degree-level job here has 1,000+ people in " & [First year] & " and " & [Last year],
			        n <= 10, "All " & n & " degree-level jobs here with 1,000+ people in " & [First year] & " and " & [Last year] & " · NYC · our estimate",
			        "Top 10 of " & n & " degree-level jobs with 1,000+ people in " & [First year] & " and " & [Last year] & " · NYC · our estimate" )
		displayFolder: Jobs\Summary
		lineageTag: 39aed2d9-f7d6-54e9-802d-2e9f9373c381

	/// Details List 1 subtitle.
	measure 'D1 subtitle' =
			VAR n = CALCULATE ( COUNTROWS ( job_profile ), KEEPFILTERS ( job_profile[has_projection] = TRUE () ), KEEPFILTERS ( job_profile[is_all_other] = FALSE () ) )
			RETURN IF ( n > 0, IF ( n <= 25, "All " & n, "Top 25 of " & n ) & " named degree-level jobs · NYC · projected for 2022–2032, rounded ¹" )
		displayFolder: Jobs\Summary
		lineageTag: c5b64ecb-3b45-5288-a074-f2b98d56a05f

	/// Reference row under both Summary lists: the same yardstick as the Overview card and the Job page (median entry wage over the 204 detailed jobs). Ties to $69.6K.
	measure 'S pay all' = "$" & IF ( ABS ( [KPI starting pay] ) >= 99950, FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0" ), FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0.0" ) ) & "K"
		displayFolder: Jobs\Summary
		lineageTag: 225dae11-4553-54e7-affb-9fa3f2521534

	measure 'S1 alt' = "Bar list of the " & IF ( [Ranked jobs] > 10, "10 ", "" ) & "degree-level jobs with the most projected openings a year in NYC, 2022 to 2032, rounded, with the work experience they ask and their entry wage. " & [Jobs answer openings]
		isHidden
		displayFolder: Jobs\Text
		lineageTag: 0239550a-3db1-585f-9956-4380d7cefbbf

	measure 'S2 alt' = "Bar list of the 10 jobs that added the most people in NYC since 2019 (our estimate), with the work experience they ask and their entry wage. " & [Jobs answer added]
		isHidden
		displayFolder: Jobs\Text
		lineageTag: a6d4aad9-f42e-54c7-8b5d-5302bee7e609

	/// Header as-of line (clarity header).
	measure 'Jobs data line' = "Data: projections 2022–2032 · jobs " & [First year] & "–" & [Last year] & " · refreshed " & [Refreshed date]
		displayFolder: Jobs\Text
		lineageTag: 154121ef-e21d-5c74-84ab-a9eac961ae40

	/// Hover card title.
	measure 'Jobs card title' = SELECTEDVALUE ( job_profile[soc_short_title] )
		displayFolder: Jobs\Hover card
		lineageTag: f2dd0ea4-85a7-59f8-94cd-ea65dd939198

	/// Hover card: openings a year, two significant digits. Ties to 'Openings a year, projected 2022–2032: about 6,600'.
	measure 'Jobs card openings' =
			VAR v = SELECTEDVALUE ( job_profile[annual_openings_avg] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        IF ( NOT SELECTEDVALUE ( job_profile[has_projection] ) || ISBLANK ( v ), "Openings a year: the state publishes no forecast for this job",
			            "Openings a year, projected 2022–2032: about " & IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & IF ( SELECTEDVALUE ( job_profile[is_imputed] ) = TRUE (), " (our estimate)" ) ) )
		displayFolder: Jobs\Hover card
		lineageTag: c8c3c34c-1a23-5d3c-8b08-d81f53dd4c6e

	/// Hover card: rank band among the 164 (fixed universe, D45 item 6). Ties to 'Rank: top 5 of 164 degree-level jobs' (13-2011, rank 3).
	measure 'Jobs card rank' =
			VAR r = SELECTEDVALUE ( job_profile[list1_rank] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && SELECTEDVALUE ( job_profile[has_projection] ),
			        IF ( ISBLANK ( r ), "Not ranked: a group of jobs", "Rank: " & SWITCH ( TRUE (), r <= 5, "top 5", r <= 10, "top 10", r <= 20, "top 20", "around " & FORMAT ( ROUND ( r, -1 ), "0" ) & "th" ) & " of " & [Ranked jobs] & " degree-level jobs" ) )
		displayFolder: Jobs\Hover card
		lineageTag: 4d7bd2e0-2bc3-5a33-930f-8c0955895ae0

	/// Hover card: openings a year per 100 people in the job (2022 base), beside the degree-level rate (C1 option B). Ties to 'about 8.7 a year (all: about 9)'.
	measure 'Jobs card rate' =
			VAR v = SELECTEDVALUE ( job_profile[annual_openings_avg] )
			VAR b = SELECTEDVALUE ( job_profile[base_employment] )
			VAR per = DIVIDE ( v, b ) * 100
			VAR allr = [KPI openings per 100]
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && SELECTEDVALUE ( job_profile[has_projection] ) && per > 0,
			        "For every 100 people in the job: about " & IF ( per >= 10, FORMAT ( ROUND ( per, 0 ), "0" ), SUBSTITUTE ( FORMAT ( ROUND ( per, 1 ), "0.0" ), ".0", "" ) ) & " a year (all: about " & IF ( allr >= 10, FORMAT ( ROUND ( allr, 0 ), "0" ), SUBSTITUTE ( FORMAT ( ROUND ( allr, 1 ), "0.0" ), ".0", "" ) ) & ")" )
		displayFolder: Jobs\Hover card
		lineageTag: 6687ec05-57ff-5273-b8b2-49c4ca275e42

	/// Hover card: where the openings come from (D48 item 4's words). Ties to '91% · from new jobs: 9%' (growth share 0.0915).
	measure 'Jobs card leaving' =
			VAR g = SELECTEDVALUE ( job_profile[growth_share] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && SELECTEDVALUE ( job_profile[has_projection] ) && NOT ISBLANK ( g ),
			        IF ( g < 0, "From people leaving the field: all of them (the job is shrinking)",
			            "From people leaving the field: " & FORMAT ( 1 - g, "0%" ) & " · from new jobs: " & FORMAT ( g, "0%" ) ) )
		displayFolder: Jobs\Hover card
		lineageTag: 385441e6-171b-538c-a86a-72eeba15f0ff

	/// Page title: the official SOC title, plain (D35: the ° and ◆ caveats are said in words beside the numbers they qualify: card 1's label, the people chart's subtitle). Ties to 'Accountants and Auditors'.
	measure 'Job title' = SELECTEDVALUE ( dim_job[soc_title] )
		displayFolder: Job page\Header
		lineageTag: e3c3c7f9-d970-5542-90e4-3fef04e6a9f8

	/// One line under the title: BLS OOH description, or O*NET's first sentence (dim_job.description_source). Ties to 'Accountants and auditors prepare and examine financial records.' v5: the header's right column, 8 pt, at most 2 lines (all 205).
	measure 'Job description' = SELECTEDVALUE ( dim_job[job_description] )
		displayFolder: Job page\Header
		lineageTag: 3ec6a8de-e21f-567a-a13f-95ef50d894a8

	/// The description under a one-line title (y80). Ties to Accountants and Auditors: the full description.
	measure 'Job description top' = IF ( LEN ( [Job title] ) <= 60, [Job description] )
		isHidden
		displayFolder: Job page\Header
		lineageTag: 2b00a1c3-9412-5df5-bbe5-ea5e24c1633e

	/// The description under a title that may wrap (y104). Blank for Accountants and Auditors.
	measure 'Job description low' = IF ( LEN ( [Job title] ) > 60, [Job description] )
		isHidden
		displayFolder: Job page\Header
		lineageTag: 4ae45c6c-8abe-54df-ac21-c1fb57f0b80b

	/// v5 header, right column, on the marker row: the heading over the description (BLS's own section name), blank when the job has none (20 of 225).
	measure 'Job description head' = IF ( NOT ISBLANK ( [Job description] ), "What they do" )
		displayFolder: Job page\Header
		lineageTag: 1a03233f-22c4-5803-817b-c90ac274db16

	/// Header as-of line, second line of the meta block: 'Data: 2019–2025 · projections to 2032 · Refreshed 16 Oct 2026'.
	measure 'Job data line' = "Data: " & [First year] & "–" & [Last year] & " · projections to 2032 · refreshed " & [Refreshed date]
		displayFolder: Job page\Header
		lineageTag: 335b9e7e-eb4d-5e52-a248-e8fecbbba9b9

	/// Projected openings a year, NYC 2022-2032 (NYS DOL), jobs with a projection. Ties to 6,648 (13-2011).
	measure 'Job openings' = IF ( SELECTEDVALUE ( job_profile[has_projection] ), SELECTEDVALUE ( job_profile[annual_openings_avg] ) )
		formatString: #,0
		displayFolder: Job page\Cards
		lineageTag: a8e33bb2-2d6d-5990-838b-22860dacab91

	/// Card 1 value: a projection, two significant digits with 'About' (D45 item 5). Ties to 'About 6,600' (6,648); 'About 640' (641.5, 13-2054); 'No NYC projection' for the 38 named jobs without one.
	measure 'Job openings text' =
			VAR v = [Job openings]
			RETURN IF ( ISBLANK ( v ), IF ( HASONEVALUE ( job_profile[soc_code] ), "No NYC projection" ), IF ( v < 1, "< 1", "About " & IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) ) )
		displayFolder: Job page\Cards
		lineageTag: 788ca258-aeea-5a2d-b2de-ae9debdc04bc

	/// 1 when the job's openings are our fill of the state's file (D1; 18 of the 164 ranked jobs, 24 rows in all): the 'our estimate' note comes first in the footer and numbers the other marks after it (B6).
	measure 'Job is filled' = IF ( SELECTEDVALUE ( job_profile[has_projection] ) && SELECTEDVALUE ( job_profile[is_imputed] ), 1, 0 )
		isHidden
		displayFolder: Job page\Cards
		lineageTag: ac040afd-19ac-5a9f-a165-a0bbdffd55d4

	/// Card 1 line 1, the yardstick (C1): rank band among the 164 (fixed universe from job_profile.list1_rank, ignores slicers; D45 item 6). Ties to 'Top 5 of the 164 with an NYC forecast' (rank 3), 'Around 50th of the 164 with an NYC forecast' (rank 51). (readability check: '164 vs 225?'): names what the 164 are (226 px at most).
	measure 'Job openings rank line' =
			VAR r = SELECTEDVALUE ( job_profile[list1_rank] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        SWITCH ( TRUE (),
			            ISBLANK ( [Job openings] ), "The state publishes no forecast for this job",
			            ISBLANK ( r ), "A group of jobs, not ranked",
			            ( VAR c__ = SWITCH ( TRUE (), r <= 5, "top 5", r <= 10, "top 10", r <= 20, "top 20", "around " & FORMAT ( ROUND ( r, -1 ), "0" ) & "th" ) RETURN UPPER ( LEFT ( c__, 1 ) ) & MID ( c__, 2, 200 ) ) & " of the " & [Ranked jobs] & " with an NYC forecast" ) )
		displayFolder: Job page\Cards
		lineageTag: 866f5936-b568-5b30-a4a3-5ee4b46560d4

	/// Card 1 line 2: share of openings from people leaving the field (D48 item 4), 'All' when the job shrinks (growth share < 0). A filled job leads with 'Our estimate ¹' and drops 'the field' to fit the 264 px line (B5: 293 px with it, measured). Ties to '91% replace people leaving the field'; 13-2054 'Our estimate ¹ · 93% replace people leaving'. (a readability check read '91% from people leaving' as '91% quit'): the Overview's verb, 'replace'.
	measure 'Job openings leaving line' =
			VAR g = SELECTEDVALUE ( job_profile[growth_share] )
			VAR share = IF ( g < 0, "All", FORMAT ( 1 - g, "0%" ) )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && NOT ISBLANK ( [Job openings] ) && NOT ISBLANK ( g ),
			        IF ( [Job is filled] = 1, "Our estimate ¹ · " & IF ( g < 0, "all", share ) & " replace people leaving",
			            share & " replace people leaving the field" ) )
		displayFolder: Job page\Cards
		lineageTag: 7a8efbd9-420b-5306-9261-ba3cd18f9d44

	/// Card 2's mark: ¹, or ² after the 'our estimate' note.
	measure 'Job mark pay' = MID ( "¹²³⁴⁵⁶⁷⁸⁹", [Job is filled] + 1, 1 )
		isHidden
		displayFolder: Job page\Footer
		lineageTag: a3053fe3-5066-5a71-a320-f23705e38db8

	/// Card 4's mark: ², or ³.
	measure 'Job mark AI' = MID ( "¹²³⁴⁵⁶⁷⁸⁹", [Job is filled] + 2, 1 )
		isHidden
		displayFolder: Job page\Footer
		lineageTag: 28b5e251-5c9c-53d1-8d75-b8ea58b096b4

	/// Card 2 value: NYS DOL entry wage, NYC 2025. Ties to $79.0K (78,988).
	measure 'Job starting pay value' =
			VAR w = SELECTEDVALUE ( job_profile[entry_wage] )
			RETURN IF ( NOT ISBLANK ( w ), "$" & IF ( ABS ( w ) >= 99950, FORMAT ( ABS ( w ) / 1000, "0" ), FORMAT ( ABS ( w ) / 1000, "0.0" ) ) & "K", IF ( HASONEVALUE ( job_profile[soc_code] ), "Not published" ) )
		displayFolder: Job page\Cards
		lineageTag: 3365cb13-a6f3-5cc1-a6f7-cf87fe310503

	/// Card 2 line 1: the job's NYC median wage. Ties to 'Median for all its workers: $111K' (110,746). (readability check: three pay figures, which middle is which?).
	measure 'Job starting pay ref' =
			VAR md = SELECTEDVALUE ( job_profile[median_wage] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        IF ( ISBLANK ( SELECTEDVALUE ( job_profile[entry_wage] ) ), "Not published for NYC by the state",
			            IF ( NOT ISBLANK ( md ), "Median for all its workers: $" & IF ( ABS ( md ) >= 99950, FORMAT ( ABS ( md ) / 1000, "0" ), FORMAT ( ABS ( md ) / 1000, "0.0" ) ) & "K" ) ) )
		displayFolder: Job page\Cards
		lineageTag: 83a677ab-71d4-508b-a306-7f08c2951ad9

	/// Card 2 line 2: the yardstick, the same $69.6K as the Overview card and the Jobs lists (D48 item 7).
	measure 'Job starting pay ref 2' = IF ( HASONEVALUE ( job_profile[soc_code] ), "Middle degree-level job's entry wage: $" & IF ( ABS ( [KPI starting pay] ) >= 99950, FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0" ), FORMAT ( ABS ( [KPI starting pay] ) / 1000, "0.0" ) ) & "K" )
		displayFolder: Job page\Cards
		lineageTag: 339432cd-8824-5af4-95d3-e3e13e8236b6

	/// 2024 NYC graduates of linked majors, split by openings (D2, D20), per projected opening. Ties to 0.1723 (13-2011).
	measure 'Job graduates per opening' = SELECTEDVALUE ( job_profile[graduates_per_opening] )
		formatString: 0.00
		displayFolder: Job page\Cards
		lineageTag: 01ed5aa7-0a52-542c-9761-f16259ef9238

	/// Card 3 value: two decimals (three significant digits at 10 or more), '< 0.01' under 1 per 100, '–' when there is no ratio or its graduates are all in dispersed majors (none counted). Ties to 0.17.
	measure 'Job graduates per opening text' =
			VAR r = [Job graduates per opening]
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        SWITCH ( TRUE (),
			            ISBLANK ( r ) || SELECTEDVALUE ( job_profile[per_opening_key] ) = "majors_dispersed", "–",
			            r = 0, "0",
			            r < 0.01, "< 0.01",
			            r >= 10, FORMAT ( r, "0.0" ),
			            FORMAT ( r, "0.00" ) ) )
		displayFolder: Job page\Cards
		lineageTag: af1fc53c-2127-5e71-b3b3-3b9f294bbbb1

	/// Card 3 reference line: the sentence for job_profile.per_opening_key (plan §11.1, D33); n = per_opening_n as stored. Ties to 'About 1 new graduate for every 6 openings'. Two sentences shortened to fit the card's 264 px line (sweep): under_1_per_100 (299 px before), zero_graduates (276).
	measure 'Job per opening words' =
			VAR k = SELECTEDVALUE ( job_profile[per_opening_key] )
			VAR n = SELECTEDVALUE ( job_profile[per_opening_n] )
			RETURN
			    SWITCH ( k,
			        "needs_projection", "Needs a projection",
			        "no_major", "No major counted toward this job",
			        "majors_dispersed", "Its majors' graduates work in many fields",
			        "zero_graduates", "No NYC graduates of its majors in 2024",
			        "under_1_per_100", "Under 1 new graduate per 100 openings",
			        "one_for_every_n", "About 1 new graduate for every " & FORMAT ( n, "#,0" ) & " openings",
			        "about_one", "About 1 new graduate for every opening",
			        "n_per_opening", "About " & FORMAT ( n, "0.0" ) & " new graduates for every opening"
			    )
		displayFolder: Job page\Cards
		lineageTag: 582aa908-16e8-5fd6-8e1a-c0590c64fe34

	/// D7's band (Anthropic observed exposure): High / Medium / Low / Not seen yet / Not rated; since the release it is the second layer, said as 'AI use seen' (D50 item 1). Ties to High.
	measure 'Job AI band' = SELECTEDVALUE ( job_profile[ai_band] )
		displayFolder: Job page\Cards
		lineageTag: 4ce68e35-3c59-56b8-af80-4f5ec370f7c4

	/// Card 4 value since the release (D50 item 1): BLS relative AI exposure tier, Low / Moderate / High / Very high (2025-35, published 2026-08-27); all 225 have one. Ties to 13-2011 'Very high'.
	measure 'Job BLS AI tier' = SELECTEDVALUE ( job_profile[bls_ai_tier] )
		displayFolder: Job page\Cards
		lineageTag: ff736a39-2b87-53d9-8ec1-1851c761fefc

	/// Card 4 line 1: D7's observed use as the second layer (Anthropic). Ties to 'AI use seen in 34.8% of its tasks' (0.3478).
	measure 'Job AI ref' =
			VAR b = [Job AI band]
			VAR e = SELECTEDVALUE ( job_profile[ai_observed_exposure] )
			RETURN
			    IF ( NOT ISBLANK ( [Job BLS AI tier] ),
			        SWITCH ( b,
			            "Not seen yet", "No AI use seen in its tasks so far",
			            "Not rated", "No AI-use estimate for this job",
			            BLANK (), "No AI-use estimate for this job",
			            "AI use seen in " & FORMAT ( e, "0.0%" ) & " of its tasks" ) )
		displayFolder: Job page\Cards
		lineageTag: ab3a7fce-0c73-5abd-b6a1-c5e79d715714

	/// Card 4 line 2: what the BLS rating is and isn't, beside the number (BLS: 'relative to other occupations … not a forecast'; design-brief §4.6, someone's scale).
	measure 'Job AI ref 2' = IF ( NOT ISBLANK ( [Job BLS AI tier] ), "Relative to other jobs · not job loss" )
		displayFolder: Job page\Cards
		lineageTag: ca6a42b7-1320-549c-aff7-d5963db01a15

	/// Card 3 line 1: the sentence for per_opening_key; the label already says 'New graduates', so the line says 'graduate' (approved Job mockup). Ties to 'About 1 graduate for every 6 openings'.
	measure 'Job graduates ref 1' = SUBSTITUTE ( [Job per opening words], "new graduate", "graduate" )
		displayFolder: Job page\Cards
		lineageTag: 207ec4f3-fd62-53a5-b9e9-ce7175fe0305

	/// Card 3 value (P7): graduates per opening in words, by job_profile.per_opening_key; n = per_opening_n as stored. Ties to '1 per 6 openings' (13-2011).
	measure 'Job graduates value' =
			VAR n = SELECTEDVALUE ( job_profile[per_opening_n] )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        SWITCH ( SELECTEDVALUE ( job_profile[per_opening_key] ),
			            "one_for_every_n", "1 per " & FORMAT ( n, "#,0" ) & " openings",
			            "about_one", "About 1 per opening",
			            "n_per_opening", FORMAT ( n, "0.0" ) & " per opening",
			            "under_1_per_100", "< 1 per 100 openings",
			            "zero_graduates", "None",
			            "–" ) )
		displayFolder: Job page\Cards
		lineageTag: 0024206d-c5a1-5710-af07-d4cca6f93280

	/// Card 3 line 1 (P7): both sides of the ratio, two significant digits (D45): graduates of its majors counted toward the job (graduates_2024_linked, D2 split) and its projected openings a year; the empty states keep their sentence. Ties to 'About 1,100 graduates for 6,600 openings a year' (1,145.7; 6,648).
	measure 'Job graduates base' =
			VAR k = SELECTEDVALUE ( job_profile[per_opening_key] )
			VAR g = SELECTEDVALUE ( job_profile[graduates_2024_linked] )
			VAR op = [Job openings]
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ),
			        IF ( k IN { "one_for_every_n", "about_one", "n_per_opening", "under_1_per_100" } && NOT ISBLANK ( op ) && op >= 1,
			            IF ( g < 1, "Under 1 graduate", "About " & IF ( g < 1, "< 1", IF ( g < 10, FORMAT ( ROUND ( g, 0 ), "0" ), FORMAT ( ROUND ( g, 1 - INT ( LOG10 ( g ) ) ), "#,0" ) ) ) & IF ( ROUND ( g, 0 ) = 1, " graduate", " graduates" ) )
			                & " for " & IF ( op < 1, "< 1", IF ( op < 10, FORMAT ( ROUND ( op, 0 ), "0" ), FORMAT ( ROUND ( op, 1 - INT ( LOG10 ( op ) ) ), "#,0" ) ) ) & " openings a year",
			            [Job graduates ref 1] ) )
		displayFolder: Job page\Cards
		lineageTag: 11a065ac-95c4-5626-9430-24aec3f1d462

	/// Card 3 line 2 (D46 item 6): graduates per opening is our estimate (program-to-job crosswalk, D2), said in words whenever a ratio shows. (stage 2 readability check): + 'experienced workers fill them too', so '1 per 6 openings' isn't read as 1 in 6 openings going to a graduate, or as a shortage (240 of 264 px).
	measure 'Job graduates ref 2' =
			VAR t = [Job graduates per opening text]
			RETURN IF ( NOT ISBLANK ( t ) && t <> "–", "Our estimate · experienced workers fill them too" )
		displayFolder: Job page\Cards
		lineageTag: 45437be8-23dc-5559-8b9c-6d577e44afc8

	/// Card 1 label, the same for every job (approved Job mockup); a filled job says 'Our estimate ¹' on line 2 instead (the D35 '(estimate)' label goes).
	measure 'Job openings label' = "Openings a year, NYC, 2022–2032 (projected)"
		displayFolder: Job page\Cards
		lineageTag: e6427436-ff29-5acb-9705-738bbf525cb7

	/// Card frame shared by the four job-page card images (v5, D54): 296 x 96 white, 8 px corners, Inter 8 pt, the value 20 pt in Bahnschrift (DIN).
	measure 'Job card svg head' = "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='96' viewBox='0 0 296 96'><style>text{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;fill:#5B6470}.v{font-family:Bahnschrift,'Segoe UI',sans-serif;font-size:26.67px;font-weight:600;fill:#1F2328}.s{font-family:'Segoe UI Symbol','Segoe UI',sans-serif;font-size:8.53px}</style><rect width='296' height='96' rx='8' fill='#FFFFFF'/>"
		isHidden
		displayFolder: Job page\Cards\Card parts
		lineageTag: ec1fb4a2-547c-5da9-969f-015fba808ad8

	/// Job card 1 image (SVG): about N a year, rank band among the 164, share from people leaving the field.
	measure 'Job card openings' =
			VAR body =
			    [Job card svg head]
			        & "<text x='16' y='22'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job openings label], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job openings text], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job openings rank line], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job openings leaving line], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Job page\Cards
		lineageTag: 9ab3edf4-8473-5dde-8478-67aa73848ca9

	/// Screen-reader text for Job card openings.
	measure 'Job card openings alt' =
			VAR r2 = [Job openings leaving line]
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), [Job openings label] & ": " & [Job openings text] & ". " & [Job openings rank line] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Job page\Cards\Alt text
		lineageTag: 1a7d405f-b2e2-5e32-9619-de4913e84ced

	/// Job card 2 image (SVG): entry wage, median, the all-degree-level yardstick.
	measure 'Job card starting pay' =
			VAR body =
			    [Job card svg head]
			        & "<text x='16' y='22'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "Entry wage, NYC, 2026 " & [Job mark pay], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job starting pay value], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job starting pay ref], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job starting pay ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Job page\Cards
		lineageTag: 54563f84-e987-50aa-bc5c-e5affd0a3d46

	/// Screen-reader text for Job card starting pay.
	measure 'Job card starting pay alt' =
			VAR r2 = [Job starting pay ref 2]
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), "Entry wage, NYC, 2026 " & [Job mark pay] & ": " & [Job starting pay value] & ". " & [Job starting pay ref] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Job page\Cards\Alt text
		lineageTag: 9d050212-a30c-5539-97ef-dd47a3facc90

	/// Job card 3 image (SVG): graduates per opening in words (P7), both sides of the ratio, said as our estimate.
	measure 'Job card graduates' =
			VAR body =
			    [Job card svg head]
			        & "<text x='16' y='22'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "NYC graduates of its majors per opening, 2024", "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job graduates value], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job graduates base], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job graduates ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Job page\Cards
		lineageTag: fb36b47a-141a-5acb-b19c-51a12e31a76f

	/// Screen-reader text for Job card graduates.
	measure 'Job card graduates alt' =
			VAR r2 = [Job graduates ref 2]
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), "NYC graduates of its majors per opening, 2024" & ": " & [Job graduates value] & ". " & [Job graduates base] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Job page\Cards\Alt text
		lineageTag: f132da78-e022-506d-91fd-f8002c5530e1

	/// Job card 4 image (SVG): BLS tier (D50 item 1), AI use seen in its tasks (D7, second layer), relative and not job loss.
	measure 'Job card AI exposure' =
			VAR body =
			    [Job card svg head]
			        & "<text x='16' y='22'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( "AI exposure (BLS), 2026 " & [Job mark AI], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job BLS AI tier], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job AI ref], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [Job AI ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Job page\Cards
		lineageTag: f8ef7fd9-aea0-5ecb-86e5-da304216ada4

	/// Screen-reader text for Job card AI exposure.
	measure 'Job card AI exposure alt' =
			VAR r2 = [Job AI ref 2]
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), "AI exposure (BLS), 2026 " & [Job mark AI] & ": " & [Job BLS AI tier] & ". " & [Job AI ref] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Job page\Cards\Alt text
		lineageTag: c5b6225f-c046-521b-b722-064c422fe590

	/// Typical entry education (BLS). Ties to Bachelor's degree.
	measure 'Job education' = SELECTEDVALUE ( job_profile[entry_education] )
		displayFolder: Job page\What it takes
		lineageTag: 13f1096a-7fb8-55e8-8634-b3fcd6c12715

	/// Typical on-the-job training (BLS), in words. Ties to 'no on-the-job training'.
	measure 'Job training words' =
			VAR t = SELECTEDVALUE ( job_profile[entry_training] )
			RETURN IF ( NOT ISBLANK ( t ), IF ( t = "None", "no on-the-job training", LOWER ( t ) ) )
		displayFolder: Job page\What it takes
		lineageTag: 71f143d4-ae33-5f9b-ab41-27966b59ea0d

	/// Way in (BLS) line: 'Bachelor's degree · no on-the-job training'.
	measure 'Job way in' = IF ( NOT ISBLANK ( [Job education] ), [Job education] & " · " & [Job training words] )
		displayFolder: Job page\What it takes
		lineageTag: bf2ee4e0-3f7b-595b-842a-eaa5b3f1cc1d

	/// Share of U.S. job ads for the job that name the software (Lightcast 2025 via O*NET OnLine; .00 profile only, D32), one row per product; draw on a fixed 0-100% axis so jobs compare. Ties to Excel 0.28 … Outlook 0.06 (13-2011).
	measure 'Skill share' = SUM ( job_skill_demand[share_of_job_ads] )
		formatString: 0%
		displayFolder: Job page\What it takes
		lineageTag: c3f1f100-a682-5594-893a-cba5a768627f

	/// 28%
	measure 'Skill share text' = IF ( NOT ISBLANK ( [Skill share] ), FORMAT ( [Skill share], "0%" ) )
		displayFolder: Job page\What it takes
		lineageTag: e0d5d76c-9431-503d-b449-9be4afbdee77

	/// Row order: % of ads, then O*NET's order (job_skill_demand.rank).
	measure 'Skill rank' = MIN ( job_skill_demand[rank] )
		formatString: 0
		isHidden
		displayFolder: Job page\What it takes
		lineageTag: 29a36503-4597-561b-b183-2cf9bbd77448

	/// Right-hand head of the skills block, year from the Lightcast window. Ties to '% of U.S. job ads, 2025'.
	measure 'Skills head' =
			VAR y = YEAR ( MAX ( job_skill_demand[window_end] ) )
			RETURN IF ( NOT ISBLANK ( y ), "% of U.S. job ads, " & y )
		displayFolder: Job page\What it takes
		lineageTag: b91638f9-2e84-5779-8c99-0ef259af060d

	/// Under the skills list (P2: review asked for the base, 'out of 100 postings'): how to read the top share, with the source; O*NET publishes shares of the job's unique U.S. postings, not their number. Ties to 'Read 28% as 28 of every 100 U.S. job ads for this job in 2025 (Lightcast via O*NET; the ad count isn't published).' (13-2011). 576 px: 2 lines in 368.
	measure 'Skills read line' =
			VAR p = MAX ( job_skill_demand[pct_of_job_ads] )
			VAR y = YEAR ( MAX ( job_skill_demand[window_end] ) )
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && NOT ISBLANK ( p ),
			        "Read " & p & "% as " & p & " of every 100 U.S. job ads for this job in " & y
			            & " (Lightcast via O*NET; the ad count isn't published)." )
		displayFolder: Job page\What it takes
		lineageTag: e2d9dc4a-52fd-5232-819a-8549c76e60e3

	/// Skills block empty state (38 named jobs).
	measure 'Skills empty' = IF ( HASONEVALUE ( job_profile[soc_code] ) && ISEMPTY ( job_skill_demand ), IF ( SELECTEDVALUE ( job_profile[soc_level] ) <> "detailed", "O*NET has no software list for this group code.", "No software shows up often in its U.S. job ads." ) )
		displayFolder: Job page\What it takes
		lineageTag: 8d3a136b-c967-58b7-ba25-aaa60f10da64

	/// ACS share of NYC workers aged 22-29 (Summary; D5: shown beside the other two signals, never blended). Blank when not readable: 'Signal young status' says why (sweep r: the status words were 136 px in a 44 px box). Ties to 0.2138 → 21%.
	measure 'Signal young' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "acs_young_share" )
			VAR v = CALCULATE ( SELECTEDVALUE ( job_entry_signal[value] ), job_entry_signal[measure] = "acs_young_share" )
			RETURN IF ( st = "readable", FORMAT ( v, "0%" ) )
		displayFolder: Job page\What it takes
		lineageTag: e8f80929-c967-5bca-a43b-fc721684e184

	/// Band in words; Summary shows the word only. Ties to 'middle'.
	measure 'Signal young band' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "acs_young_share" )
			RETURN IF ( st = "readable", SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[band] ), job_entry_signal[measure] = "acs_young_share" ), "low", "low", "mid", "middle", "high", "high" ) )
		displayFolder: Job page\What it takes
		lineageTag: a8c4a457-57c8-5f40-ac60-20c480e8c815

	/// ACS share of NYC workers aged 22-29 (Details; D5: shown beside the other two signals, never blended). '–' when not readable; line 2 says why. Ties to 0.2138 → 21% (one decimal).
	measure 'Signal young detail' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "acs_young_share" )
			VAR v = CALCULATE ( SELECTEDVALUE ( job_entry_signal[value] ), job_entry_signal[measure] = "acs_young_share" )
			RETURN IF ( st = "readable", FORMAT ( v, "0.0%" ), IF ( NOT ISBLANK ( st ), "–" ) )
		displayFolder: Job page\What it takes
		lineageTag: 2ab7d5bc-21d6-5f29-ab12-5aacce26d2be

	/// Band in words with its thresholds (the cuts in core.fct_job_entry_signal); when not readable, why.
	measure 'Signal young band detail' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "acs_young_share" )
			RETURN IF ( st = "readable", SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[band] ), job_entry_signal[measure] = "acs_young_share" ), "low", "low share of young workers (under 15%)", "mid", "middle share of young workers (15–30%)", "high", "high share of young workers (30% or more)" ), SWITCH ( st, "not available", "not counted separately by the census", "suppressed", "too few NYC survey responses" ) )
		displayFolder: Job page\What it takes
		lineageTag: e139a758-9709-5032-b391-2c47b080e2b9

	/// Summary: why the signal has no value, right-aligned in the row (mockup v4.1); blank when readable.
	measure 'Signal young status' = SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "acs_young_share" ), "not available", "not counted separately", "suppressed", "too few NYC responses" )
		displayFolder: Job page\What it takes
		lineageTag: d75ef010-9ce5-5f8d-92d0-bf5efe2cab7f

	/// O*NET share of workers who needed a month or less of experience (Summary; D5: shown beside the other two signals, never blended). Blank when not readable: 'Signal newcomer status' says why (sweep r: the status words were 136 px in a 44 px box). Ties to 0.4138 → 41%.
	measure 'Signal newcomer' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "onet_newcomer" )
			VAR v = CALCULATE ( SELECTEDVALUE ( job_entry_signal[value] ), job_entry_signal[measure] = "onet_newcomer" )
			RETURN IF ( st = "readable", FORMAT ( v, "0%" ) )
		displayFolder: Job page\What it takes
		lineageTag: c6735123-97fb-528b-9644-2f775dc78f12

	/// Band in words; Summary shows the word only.
	measure 'Signal newcomer band' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "onet_newcomer" )
			RETURN IF ( st = "readable", SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[band] ), job_entry_signal[measure] = "onet_newcomer" ), "low", "low", "mid", "middle", "high", "high" ) )
		displayFolder: Job page\What it takes
		lineageTag: f2c92b3a-76cb-5a01-b653-634a32d7af08

	/// O*NET share of workers who needed a month or less of experience (Details; D5: shown beside the other two signals, never blended). '–' when not readable; line 2 says why. Ties to 0.4138 → 41% (one decimal).
	measure 'Signal newcomer detail' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "onet_newcomer" )
			VAR v = CALCULATE ( SELECTEDVALUE ( job_entry_signal[value] ), job_entry_signal[measure] = "onet_newcomer" )
			RETURN IF ( st = "readable", FORMAT ( v, "0.0%" ), IF ( NOT ISBLANK ( st ), "–" ) )
		displayFolder: Job page\What it takes
		lineageTag: 3ce3a0e3-6ed1-5a74-9d4e-26bd51901586

	/// Band in words with its thresholds (the cuts in core.fct_job_entry_signal); when not readable, why.
	measure 'Signal newcomer band detail' =
			VAR st = CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "onet_newcomer" )
			RETURN IF ( st = "readable", SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[band] ), job_entry_signal[measure] = "onet_newcomer" ), "low", "rarely takes newcomers (under 10%)", "mid", "sometimes takes newcomers (10–25%)", "high", "often takes newcomers (25% or more)" ), SWITCH ( st, "not available", "not rated by O*NET", "suppressed", "not rated by O*NET" ) )
		displayFolder: Job page\What it takes
		lineageTag: a23adeff-8823-520e-8677-37c6b9934995

	/// Summary: why the signal has no value, right-aligned in the row (mockup v4.1); blank when readable.
	measure 'Signal newcomer status' = SWITCH ( CALCULATE ( SELECTEDVALUE ( job_entry_signal[signal_status] ), job_entry_signal[measure] = "onet_newcomer" ), "not available", "not rated", "suppressed", "not rated" )
		displayFolder: Job page\What it takes
		lineageTag: a09d7f41-7fa4-5743-a6c7-723128e8aefb

	/// 90% margin of error of the ACS share, Details only (D5 qualifiers off the face). Ties to '± 2.0 pts' (0.0203).
	measure 'Signal young moe' =
			VAR e = CALCULATE ( SELECTEDVALUE ( job_entry_signal[moe_90] ), job_entry_signal[measure] = "acs_young_share" )
			RETURN IF ( NOT ISBLANK ( e ), "± " & FORMAT ( e * 100, "0.0" ) & " pts" )
		displayFolder: Job page\What it takes
		lineageTag: 22e72cfc-3cb0-58b1-b978-76ce5e05bdf0

	/// Details, What the work draws on: the top 3 O*NET knowledge elements by importance. Ties to 'Economics and Accounting · English Language · Mathematics'.
	measure 'Draws on knowledge' =
			IF ( HASONEVALUE ( job_profile[soc_code] ),
			    CONCATENATEX (
			        FILTER ( job_skill_top, job_skill_top[domain] = "knowledge" && job_skill_top[rank] <= 3 ),
			        job_skill_top[element_name], " · ", job_skill_top[rank], ASC ) )
		displayFolder: Job page\What it takes
		lineageTag: 596894c8-13f2-5eb6-b169-2c3c18a8c93f

	/// Details, What the work draws on: the top 3 O*NET skill_essential elements by importance. Ties to 'Reading Comprehension · Active Listening · Critical Thinking'.
	measure 'Draws on skills' =
			IF ( HASONEVALUE ( job_profile[soc_code] ),
			    CONCATENATEX (
			        FILTER ( job_skill_top, job_skill_top[domain] = "skill_essential" && job_skill_top[rank] <= 3 ),
			        job_skill_top[element_name], " · ", job_skill_top[rank], ASC ) )
		displayFolder: Job page\What it takes
		lineageTag: 708ae4a4-4a24-57c9-91f8-0561ba4f1213

	/// Details empty state (8 named jobs, 18 with the All other groups).
	measure 'Draws on empty' = IF ( HASONEVALUE ( job_profile[soc_code] ) && ISBLANK ( [Draws on knowledge] ) && ISBLANK ( [Draws on skills] ), IF ( SELECTEDVALUE ( job_profile[soc_level] ) <> "detailed", "O*NET has no profile for this group code.", "O*NET has not rated the knowledge and skills for this job yet." ) )
		displayFolder: Job page\What it takes
		lineageTag: 1efbe821-98d7-5fa0-a4ba-9a108267f1b6

	/// Row label 'Knowledge' beside its O*NET line; blank with the line.
	measure 'Draws on knowledge label' = IF ( NOT ISBLANK ( [Draws on knowledge] ), "Knowledge" )
		isHidden
		displayFolder: Job page\What it takes
		lineageTag: 88c1fe59-3736-52d0-8e0a-edef8ec8212b

	/// Row label 'Skills' beside its O*NET line; blank with the line.
	measure 'Draws on skills label' = IF ( NOT ISBLANK ( [Draws on skills] ), "Skills" )
		isHidden
		displayFolder: Job page\What it takes
		lineageTag: 5b04504d-b5f7-510b-bd9f-a583972dc47f

	/// D36: the NYC estimate is at least 1,000 people in 2019 and in 2025 (job_profile.clears_floor_1000, the floor page 1's List 2 uses); below it the chart shows the NY metro line only.
	measure 'Job NYC floor' = COALESCE ( SELECTEDVALUE ( job_profile[clears_floor_1000] ), FALSE () )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 6393ae36-3dc9-510e-9ccc-678b8f7112ec

	/// People doing the job, % change since 2019, NYC estimate (D8), dashed; only above the D36 floor; the line joins across a blank year (D38). Ties to −2.2% (2025), +6.4% (2022).
	measure 'People NYC change' =
			IF ( HASONEVALUE ( dim_job[soc_code] ) && [Job NYC floor],
			    CALCULATE ( MAX ( job_employment_trend[pct_change_vs_2019] ), job_employment_trend[area_key] = "nyc" ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Job page\How it changed
		lineageTag: ddc34e0c-da76-5bf2-bec7-668cf1ac245a

	/// TRUE when the chart draws this line (a 2019 base; and the D36 floor for NYC).
	measure 'Job has NYC line' = NOT ISEMPTY ( CALCULATETABLE ( job_employment_trend, job_employment_trend[area_key] = "nyc", NOT ISBLANK ( job_employment_trend[pct_change_vs_2019] ) ) ) && [Job NYC floor]
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 1f323fac-4325-5472-81a4-f50754cb399c

	/// People doing the job, % change since 2019, NY metro, published OEWS, solid; the line joins across a blank year (D38). Ties to −7.1% (2025), +4.4% (2022).
	measure 'People metro change' =
			IF ( HASONEVALUE ( dim_job[soc_code] ),
			    CALCULATE ( MAX ( job_employment_trend[pct_change_vs_2019] ), job_employment_trend[area_key] = "ny_metro" ) )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Job page\How it changed
		lineageTag: 1acffb55-5ac6-5c80-a7f1-571a5306278c

	/// TRUE when the chart draws this line (a 2019 base).
	measure 'Job has metro line' = NOT ISEMPTY ( CALCULATETABLE ( job_employment_trend, job_employment_trend[area_key] = "ny_metro", NOT ISBLANK ( job_employment_trend[pct_change_vs_2019] ) ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 203ee145-63f4-5459-86eb-58c36254f443

	/// TRUE when an NYC estimate with a 2019 base exists, drawn or not (D36 says why it is not drawn).
	measure 'Job has NYC series' = NOT ISEMPTY ( CALCULATETABLE ( job_employment_trend, job_employment_trend[area_key] = "nyc", NOT ISBLANK ( job_employment_trend[pct_change_vs_2019] ) ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 584c33c8-ae9a-5ae6-b5fa-173a83b2cd5e

	/// People chart title from each line's last point. With no line it is the block's only sentence (plan §3.6): 'This job code started in 2021…' when both series start in 2021 (OEWS split those codes then: 11-2032, 11-2033, 11-3012, 11-3013, 19-4013), else 'No count since 2019…'; when only an NYC estimate under the D36 floor exists, 'Too few people do this job in NYC to chart a change since 2019'. Ties to 'Fewer people do this job than in 2019'.
	measure 'People title' =
			VAR y0 = [First year]
			VAR yn = CALCULATE ( MAX ( job_employment_trend[year] ), job_employment_trend[area_key] = "nyc", NOT ISBLANK ( job_employment_trend[pct_change_vs_2019] ) )
			VAR ym = CALCULATE ( MAX ( job_employment_trend[year] ), job_employment_trend[area_key] = "ny_metro", NOT ISBLANK ( job_employment_trend[pct_change_vs_2019] ) )
			VAR n = CALCULATE ( [People NYC change], job_employment_trend[year] = yn )
			VAR mt = CALCULATE ( [People metro change], job_employment_trend[year] = ym )
			VAR new_code =
			    CALCULATE ( MIN ( job_employment_trend[year] ), job_employment_trend[area_key] = "nyc", NOT ISBLANK ( job_employment_trend[nyc_employment_est] ) ) = 2021
			        && CALCULATE ( MIN ( job_employment_trend[year] ), job_employment_trend[area_key] = "ny_metro", NOT ISBLANK ( job_employment_trend[metro_employment] ) ) = 2021
			RETURN
			    IF ( HASONEVALUE ( dim_job[soc_code] ),
			        SWITCH ( TRUE (),
			            ISBLANK ( n ) && ISBLANK ( mt ) && [Job has NYC series],
			                "Too few NYC workers to chart a change since " & y0,
			            ISBLANK ( n ) && ISBLANK ( mt ),
			                IF ( new_code, "Its job code started in 2021: no " & y0 & " count", "No count since " & y0 & " is published for this job" ),
			            ISBLANK ( mt ), IF ( n < 0, "Fewer people do this job in NYC than in " & y0, "More people do this job in NYC than in " & y0 ),
			            ISBLANK ( n ), IF ( mt < 0, "Fewer people do this job in the NY metro than in " & y0, "More people do this job in the NY metro than in " & y0 ),
			            n < 0 && mt < 0, "Fewer people do this job than in " & y0,
			            n > 0 && mt > 0, "More people do this job than in " & y0,
			            "NYC and the metro area moved apart" ) )
		displayFolder: Job page\How it changed
		lineageTag: 0f4ddffd-f20b-5394-9f26-5fd5269bd7da

	/// Footnote mark for the NYC line (Summary): ³, or ⁴ after the 'our estimate' note (B6: numbered in reading order).
	measure 'Job mark NYC' = IF ( [Job has NYC line], MID ( "¹²³⁴⁵⁶⁷⁸⁹", [Job is filled] + 3, 1 ) )
		isHidden
		displayFolder: Job page\Footer
		lineageTag: 81256da9-6229-5079-a477-fac0528df7be

	/// Footnote mark for the similar-jobs block, only when similar jobs are listed (D35; 29 jobs): after the NYC line's mark, or in its place when the job has no NYC line (B6).
	measure 'Job mark routes' = IF ( SELECTEDVALUE ( job_profile[routes_status] ) = "listed", MID ( "¹²³⁴⁵⁶⁷⁸⁹", [Job is filled] + 3 + IF ( [Job has NYC line], 1, 0 ), 1 ) )
		isHidden
		displayFolder: Job page\Footer
		lineageTag: 96533a48-c602-5ad7-b02c-cab06f5701be

	/// People chart subtitle. D35: names the code split for the split jobs (◆ in job_label), where it changes the reading (Data Scientists' NYC line +1,217%). Why NYC is missing is said in the readout row ('Readout NYC note'). Ties to '% change since 2019 · NYC estimate ³'.
	measure 'People subtitle' =
			VAR split = IF ( SELECTEDVALUE ( job_profile[split_2019] ), " · 2019 from an older, combined code" )
			RETURN
			    SWITCH ( TRUE (),
			        // v5: with the split note the line was 371 px of the 368 px column; the column title above already says
			        // "since 2019", so the split case drops it
			        [Job has NYC line], "% change" & IF ( split = "", " since " & [First year] ) & " · NYC estimate " & [Job mark NYC] & split,
			        [Job has metro line], "% change since " & [First year] & " · NY metro only" & split )
		displayFolder: Job page\How it changed
		lineageTag: 5ef1b972-f6f5-5a4a-b70f-036debc235fa

	/// Readout row start: '2025 vs 2019' (the year from the slider); blank for the 12 jobs with no line, so the row is empty with the chart.
	measure 'Readout lead' = IF ( [Job has NYC line] || [Job has metro line], [Year pick value] & " vs " & [First year] )
		displayFolder: Job page\How it changed
		lineageTag: 7c9ae0db-de47-52c7-9802-d605c9ffc8f1

	/// Column 2 kicker (P4: the takeaway is the column's title now, 10 pt; this names the block under it, and the subtitle below carries 'since 2019').
	measure 'Change column title' = "How it has changed"
		displayFolder: Job page\How it changed
		lineageTag: b75095fe-af03-55d1-b6d3-530afd08564f

	/// Visual filter of the chart (> 0): years with a value only, so a job with no line shows an empty visual instead of a -1 to 1 axis; a gap year inside a line stays on the continuous axis.
	measure 'People chart has value' = IF ( NOT ISBLANK ( [People NYC change] ) || NOT ISBLANK ( [People metro change] ), 1 )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 64fdc888-9bbb-55e5-9c1b-1fa3862efaf6

	/// Visual filter of the chart (> 0): years with a value only, so a job with no line shows an empty visual instead of a -1 to 1 axis; a gap year inside a line stays on the continuous axis.
	measure 'Pay chart has value' = IF ( NOT ISBLANK ( [Pay median change] ) || NOT ISBLANK ( [Pay lower quarter change] ), 1 )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: a603f44d-5bcc-5870-8a2c-fe6ebf7ab33e

	/// The people chart's picked-year line; blank when the chart has no line (no line across an empty plot).
	measure 'People chart pick year' = IF ( [Job has NYC line] || [Job has metro line], [Year pick value] )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 815e25f3-a255-52d7-adb0-f91e9593e4f6

	/// The people chart's 0% line; blank with no line, so the empty chart draws no axis.
	measure 'People chart zero' = IF ( [Job has NYC line] || [Job has metro line], 0 )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: f0d1a421-03a6-5594-9693-f4f401ab1333

	/// The pay chart's 0% line; blank with no pay line.
	measure 'Pay chart zero' = IF ( [Job has pay line], 0 )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 72732300-a66b-56be-9af1-bc4b7b0dd9b3

	/// The pay chart's picked-year line; blank when the chart has no line.
	measure 'Pay chart pick year' = IF ( [Job has pay line], [Year pick value] )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 21a267d2-7771-5f70-b287-f40a73aaff87

	/// Details readout row start, from the pay lines (blank for the 16 jobs with no 2019 pay base).
	measure 'Pay readout lead' = IF ( [Job has pay line], [Year pick value] & " vs " & [First year] )
		displayFolder: Job page\How it changed
		lineageTag: e8be6e25-aee5-5413-bfbe-f344658a386b

	/// Readout slot 1 key when the NYC line is drawn.
	measure 'Readout NYC key' = IF ( [Job has NYC line], "NYC" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: a2a28ea0-54c9-5283-a891-97041f3d592a

	/// Readout slot 1 key when the chart has the NY metro line only.
	measure 'Readout metro key 1' = IF ( NOT [Job has NYC line] && [Job has metro line], "NY metro" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 8a5fee6a-b4a9-50bd-86d8-ab2333f295b4

	/// Readout slot 2 key beside the NYC value.
	measure 'Readout metro key 2' = IF ( [Job has NYC line] && [Job has metro line], "NY metro" )
		isHidden
