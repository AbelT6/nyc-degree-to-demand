	/// A-Z finder, Openings a year: two significant digits (D45), 'our estimate' in words for a filled job. Ties to 6,600; Software Developers '4,300 · our estimate'.
	measure 'AZ openings text' =
			VAR v = [Job openings]
			RETURN IF ( ISBLANK ( v ), IF ( HASONEVALUE ( job_profile[soc_code] ), "No NYC projection" ), IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & IF ( SELECTEDVALUE ( job_profile[is_imputed] ), " · our estimate" ) )
		displayFolder: A-Z
