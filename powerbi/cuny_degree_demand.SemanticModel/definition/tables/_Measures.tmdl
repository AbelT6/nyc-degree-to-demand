	/// Entry wage averaged over openings (D41): NYS DOL entry wage weighted by openings a year, jobs with a wage; blank under 5 such jobs (D58). Ties to $74,609 / $87,976 / $114,212; all $82,681.
	measure 'GI starting pay' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( IF ( [GI wage jobs n] >= 5, DIVIDE ( [GI pay weighted sum], [GI pay openings] ) ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), IF ( [GI wage jobs n] >= 5, DIVIDE ( [GI pay weighted sum], [GI pay openings] ) ) )
		formatString: $#,0
		displayFolder: Getting in\Pay
		lineageTag: 36263ec4-95a8-519a-9bde-ac027e41b618

	/// '$74.6K'; '—' for a band with no jobs here (associate's, 5 years or more) or under 5 jobs with a wage (D58).
	measure 'GI starting pay text' =
			VAR w = [GI starting pay]
			RETURN IF ( ISBLANK ( w ), IF ( [GI openings total] > 0, "—" ), "$" & IF ( ABS ( w ) >= 99950, FORMAT ( ABS ( w ) / 1000, "0" ), FORMAT ( ABS ( w ) / 1000, "0.0" ) ) & "K" )
		displayFolder: Getting in\Pay
		lineageTag: c5cb7eed-e4f3-5fa5-a9af-adee2c0aaf52

	measure 'GI p50 weighted' = SUMX ( job_profile, job_profile[metro_real_p50_change_2019_2025] * job_profile[metro_oews_employment_2025] )
