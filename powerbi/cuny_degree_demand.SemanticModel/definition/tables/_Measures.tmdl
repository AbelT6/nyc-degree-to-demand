	/// Finding 1, the headline number. Release (frame A, audit claim #1): three bands, not 'all other', which mixed jobs that need less (−87K) with master's-level jobs (+34K). Ties to '+16.8%', '+14.1%' and 'fell 2.9%' (D37 base).
	measure 'Finding 1 value' = IF ( [KPI degree jobs change] < 0, "−", "+" ) & FORMAT ( ABS ( [KPI degree jobs change] ), "0.0%" )
		displayFolder: What we found\Findings
		lineageTag: a77a0d59-9dc2-5753-8f6e-6860f8fcaec3

	/// Finding 1, the sentence after the number; its direction words come from the data.
	measure 'Finding 1 sentence' =
			VAR y1 = [Last year]
			VAR ms = CALCULATE ( [Masters change since 2019], REMOVEFILTERS (), job_employment_trend[year] = y1 )
			VAR nl = CALCULATE ( [Need less change since 2019], REMOVEFILTERS (), job_employment_trend[year] = y1 )
			RETURN
			    "in degree-level jobs since " & [First year] & ", and " & IF ( ms < 0, "−", "+" ) & FORMAT ( ABS ( ms ), "0.0%" ) & " in master's-level jobs, while jobs that need less schooling "
			        & IF ( nl < 0, "fell ", "grew " ) & FORMAT ( ABS ( nl ), "0.0%" ) & "."
		displayFolder: What we found\Findings
		lineageTag: 5d884304-5b6a-5535-9425-58f2435bfdbc

	/// Finding 1: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 1 kind' = "Our estimate · people in the job, NYC · " & [First year] & " → " & [Last year]
		displayFolder: What we found\Findings
		lineageTag: c2ee6e4c-0838-5885-a48d-ba65798c574f

	measure 'Finding 1 alt' = "Finding 1: " & [Finding 1 value] & " " & [Finding 1 sentence] & " " & [Finding 1 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: f2301037-b398-52f6-b115-6500edfa16c5

	/// Finding 2, the headline number. Ties to '87%' of about 140K (D46 item 8: who leaves, in BLS's two separation types).
	measure 'Finding 2 value' = FORMAT ( [KPI replacement share], "0%" )
		displayFolder: What we found\Findings
		lineageTag: 671dc4de-578d-5baf-8693-10d5742baf67

	/// Finding 2, the sentence after the number; its direction words come from the data.
	measure 'Finding 2 sentence' =
			VAR r = [KPI replacement share]
			RETURN
			    "of about " & IF ( [KPI openings a year] < 1000, IF ( [KPI openings a year] < 1, "< 1", IF ( [KPI openings a year] < 10, FORMAT ( ROUND ( [KPI openings a year], 0 ), "0" ), FORMAT ( ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( [KPI openings a year], 1 - INT ( LOG10 ( [KPI openings a year] ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " openings a year come from people who leave the workforce or change careers"
			        & IF ( r > 0.5, ". A job doesn't have to grow to hire.", "; most come from new jobs." )
		displayFolder: What we found\Findings
		lineageTag: 30a12c91-d7ab-5b78-8ec3-3d3fc0a9720c

	/// Finding 2: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 2 kind' = "Projection · openings a year, NYC · 2022–2032"
		displayFolder: What we found\Findings
		lineageTag: 95e064d3-0739-5392-97e7-4603c9768cb9

	measure 'Finding 2 alt' = "Finding 2: " & [Finding 2 value] & " " & [Finding 2 sentence] & " " & [Finding 2 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: 19d59c14-9c9a-5b6f-a737-5b2ae859928e

	/// Finding 3, the headline number. Leads with openings (D46 item 7). Ties to '69%' and '41%' (94,103 / 136,787; 83,910 / 204,310); 'but' because 41% beats the 15% of openings in those jobs.
	measure 'Finding 3 value' = FORMAT ( DIVIDE ( [WF openings none], [WF openings all] ), "0%" )
		displayFolder: What we found\Findings
		lineageTag: 0f2193a4-e4b2-5422-b894-da1923187ba0

	/// Finding 3, the sentence after the number; its direction words come from the data.
	measure 'Finding 3 sentence' =
			VAR a5 = DIVIDE ( [WF added 5plus], [WF added all] )
			VAR o5 = DIVIDE ( [WF openings 5plus], [WF openings all] )
			RETURN
			    "of openings a year are in jobs BLS rates as needing no related experience" & IF ( a5 > o5, ", but ", "; and " )
			        & FORMAT ( a5, "0%" ) & " of jobs added since " & [First year] & " are rated five years or more."
		displayFolder: What we found\Findings
		lineageTag: 2fa88d3a-f5aa-5a4e-8703-912b67e38271

	/// Finding 3: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 3 kind' = "Projection and our estimate · NYC · BLS typical, not a hiring rule"
		displayFolder: What we found\Findings
		lineageTag: 94d76f17-e312-557e-8294-b6ddfd6a57a6

	measure 'Finding 3 alt' = "Finding 3: " & [Finding 3 value] & " " & [Finding 3 sentence] & " " & [Finding 3 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: 6fd44479-0fa2-5245-8cf8-c07191bac5b4

	/// Finding 4, the headline number. Ties to '−14.2%' and CUNY '−24.5%'.
	measure 'Finding 4 value' = IF ( [KPI degrees change] < 0, "−", "+" ) & FORMAT ( ABS ( [KPI degrees change] ), "0.0%" )
		displayFolder: What we found\Findings
		lineageTag: 445f1723-db3f-5cc4-b068-09e20fbe4594

	/// Finding 4, the sentence after the number; its direction words come from the data.
	measure 'Finding 4 sentence' = "in associate's and bachelor's degrees from all NYC colleges since 2019; at CUNY, " & IF ( [KPI degrees change CUNY] < 0, "−", "+" ) & FORMAT ( ABS ( [KPI degrees change CUNY] ), "0.0%" ) & "."
		displayFolder: What we found\Findings
		lineageTag: d0ad819b-1eee-5bff-a07e-a8045d9f082c

	/// Finding 4: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 4 kind' = "Counted · all NYC colleges · 2019 → 2024 (2024 provisional)"
		displayFolder: What we found\Findings
		lineageTag: d9cb93cb-c926-5bca-9a3c-dccc43a76132

	measure 'Finding 4 alt' = "Finding 4: " & [Finding 4 value] & " " & [Finding 4 sentence] & " " & [Finding 4 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: 1370786a-5083-5b40-9110-5d4c8d99c6d8

	/// Finding 5, the headline number. Both ages shown so the larger gap isn't picked alone (D46 item 5). Ties to '32%' and '13%'.
	measure 'Finding 5 value' = FORMAT ( ABS ( [WF premium 35-64] ), "0%" )
		displayFolder: What we found\Findings
		lineageTag: 6bd951dd-e453-542c-9a47-0c10f97cad95

	/// Finding 5, the sentence after the number; its direction words come from the data.
	measure 'Finding 5 sentence' =
			VAR p = [WF premium 35-64]
			VAR y = [WF premium 22-34]
			RETURN
			    IF ( p >= 0, "higher", "lower" ) & " median pay with a graduate degree than with a bachelor's alone, at ages 35–64; "
			        & FORMAT ( ABS ( y ), "0%" ) & IF ( y >= 0, " higher", " lower" ) & " at 22–34."
		displayFolder: What we found\Findings
		lineageTag: f89efa05-4b6f-5ade-8f46-299420eac1c1

	/// Finding 5: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 5 kind' = "Census estimate · NYC residents, full-time, all fields · 2020–2024"
		displayFolder: What we found\Findings
		lineageTag: e858363b-9bf1-5c62-9142-29f87b589e25

	measure 'Finding 5 alt' = "Finding 5: " & [Finding 5 value] & " " & [Finding 5 sentence] & " " & [Finding 5 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: 84d3e521-c431-5a63-a118-99f6e0dc105b

	/// Finding 6, the headline number. Release (D50 item 1): BLS's relative AI exposure tiers lead; D7's observed use stays on the job page as 'AI use seen'. Ties to '94%' against '41%' (overview_kpi bls_ai_high_share).
	measure 'Finding 6 value' = FORMAT ( [KPI BLS AI share], "0%" )
		displayFolder: What we found\Findings
		lineageTag: 8e19ecc9-5af2-55ff-b046-19ecc48303d0

	/// Finding 6, the sentence after the number; its direction words come from the data.
	measure 'Finding 6 sentence' =
			"of openings a year are in jobs BLS rates High or Very high for AI exposure, against " & FORMAT ( [KPI BLS AI share need less], "0%" )
			    & " in jobs that need less schooling. Relative, not job loss. ¹"
		displayFolder: What we found\Findings
		lineageTag: e1b506b1-1a24-5802-856d-92b70bcda26b

	/// Finding 6: what kind of number, where, when (design-brief §4.6 questions 2-3).
	measure 'Finding 6 kind' = "Projection and a government rating · NYC · 2022–2032"
		displayFolder: What we found\Findings
		lineageTag: a24ce253-a3cf-5077-a6fc-719b0e0f0ac0

	measure 'Finding 6 alt' = "Finding 6: " & [Finding 6 value] & " " & [Finding 6 sentence] & " " & [Finding 6 kind]
		isHidden
		displayFolder: What we found\Findings
		lineageTag: fcadc17f-8ea2-516b-aa4c-146207f45046

