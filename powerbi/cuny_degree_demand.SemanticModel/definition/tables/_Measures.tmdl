	/// Summary footer slot 1 (B6): note 1 of the ordered list, or the sources line right after the last note.
	measure 'Job foot S1' =
			VAR n = [Job notes summary n]
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), IF ( 1 <= n, (
			VAR f = [Job is filled]
			VAR nyc = IF ( [Job has NYC line], 1, 0 )
			RETURN
			    SWITCH ( TRUE (),
			        f = 1 && 1 = 1, "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "imputed_projection", footnote[page_key], "job" ),
			        1 = f + 1, [Job mark pay] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "entry_wage_definition", footnote[page_key], "job" ),
			        1 = f + 2, [Job mark AI] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "ai_exposure_observed", footnote[page_key], "job" ),
			        nyc = 1 && 1 = f + 3, [Job mark NYC] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "nyc_jobs_estimate", footnote[page_key], "job" ),
			        SELECTEDVALUE ( job_profile[routes_status] ) = "listed" && 1 = f + 3 + nyc, [Job mark routes] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "escape_route", footnote[page_key], "job" ) ) ), IF ( 1 = n + 1, [Job sources summary] ) ) )
		displayFolder: Job page\Footer
		lineageTag: bc6789aa-4d74-5289-99e1-bcb7e05fbb87

