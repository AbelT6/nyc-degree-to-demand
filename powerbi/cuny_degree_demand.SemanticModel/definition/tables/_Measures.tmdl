	/// A-Z header folio (Z: the list's scope; Z2: the career-area pick). Ties to 'Showing: the study's 225 occupations, all career areas · NYC'.
	measure 'AZ showing' =
			IF ( ISFILTERED ( dim_cluster[cluster_name] ),
			    VAR n = COUNTROWS ( VALUES ( dim_cluster[cluster_name] ) )
			    RETURN "Showing: " & IF ( n = 1, SELECTEDVALUE ( dim_cluster[cluster_name] ), n & " career areas" ) & ", of the study's 225 occupations · NYC",
			    "Showing: the study's 225 occupations, all career areas · NYC" )
