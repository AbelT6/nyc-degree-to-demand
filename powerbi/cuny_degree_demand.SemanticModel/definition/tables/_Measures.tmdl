	/// Median pay change 2019 -> 2025 after inflation (NY metro, 2025 dollars), weighted by 2025 metro employment. Ties to +0.53% / 0.00% / -9.36%; all -1.24%.
	measure 'GI real pay change' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( DIVIDE ( [GI p50 weighted], [GI p50 weight] ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), DIVIDE ( [GI p50 weighted], [GI p50 weight] ) )
		formatString: 0.0%
		displayFolder: Getting in\Pay
		lineageTag: e687d096-9d5a-5be4-954c-64a0923db715

	/// Tooltip: the lower quarter's change, same weights. Ties to +3.51% / +1.57% / -8.18%; all +1.23%.
	measure 'GI real pay change p25' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( DIVIDE ( [GI p25 weighted], [GI p25 weight] ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), DIVIDE ( [GI p25 weighted], [GI p25 weight] ) )
		formatString: 0.0%
		displayFolder: Getting in\Pay
		lineageTag: bebfd07c-16dd-5d8c-9141-9d33fc0d0ac3

	/// '▲ 0.5%', '0.0%', '▼ 9.4%': arrows and signs, no red or green (design-brief §4.4). D56 Q3: '—' when fewer than 5 jobs back the change (associate's, less than 5 years: 1 job); the hover card says why.
	measure 'GI real pay change text' =
			VAR v = [GI real pay change]
			RETURN IF ( ISBLANK ( v ) || [GI pay jobs] < 5, IF ( [GI openings total] > 0, "—" ), IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "▼ ", "▲ " ) & FORMAT ( ABS ( v ), "0.0%" ) ) )
		displayFolder: Getting in\Pay
		lineageTag: bc64ddcc-aaed-54ef-b9b4-fb01ffd0df75

	/// Tooltip: lower quarter, same form.
	measure 'GI real pay change p25 text' =
			VAR v = [GI real pay change p25]
			RETURN IF ( NOT ISBLANK ( v ), IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "▼ ", "▲ " ) & FORMAT ( ABS ( v ), "0.0%" ) ) )
		displayFolder: Getting in\Pay
		lineageTag: 815901ca-126a-51ef-a09c-6885ea992a7d

	/// Tooltip: jobs with a pay series and a 2025 weight behind the change (D58: 5 jobs with no 2025 metro employment carry no weight; associate's, less than 5 years: 1 job; all bands: 202).
	measure 'GI pay jobs' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( COUNTROWS ( FILTER ( job_profile, NOT ISBLANK ( job_profile[metro_real_p50_change_2019_2025] ) && NOT ISBLANK ( job_profile[metro_oews_employment_2025] ) ) ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), COUNTROWS ( FILTER ( job_profile, NOT ISBLANK ( job_profile[metro_real_p50_change_2019_2025] ) && NOT ISBLANK ( job_profile[metro_oews_employment_2025] ) ) ) )
		formatString: #,0
		displayFolder: Getting in\Pay
		lineageTag: 7dab170d-42a6-5b46-97b7-0f72594fa7d5

	/// Tooltip on an empty band row: 'No associate's-entry job asks this much experience.'
	measure 'GI band empty note' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all" && ISBLANK ( [GI openings] ) && [GI openings total] > 0, "No " & IF ( ISFILTERED ( dim_degree_level[degree_level] ) && HASONEVALUE ( dim_degree_level[degree_level] ), LOWER ( SELECTEDVALUE ( dim_degree_level[degree_level] ) ) & "-entry job", "degree-level job" ) & IF ( ISFILTERED ( dim_cluster[cluster_name] ), " in this career area", "" ) & " asks this much experience." )
		displayFolder: Getting in\Pay
		lineageTag: 5f60c045-86ef-5aa4-a163-2f928560aee2

	/// The benchmark line under V2: all jobs, any entry level (overview_kpi comparison, the page-0 number). Ties to ▲ 2.5%.
	measure 'GI pay all jobs text' =
			VAR v = [KPI real pay change all jobs]
			RETURN IF ( NOT ISBLANK ( v ), IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "▼ ", "▲ " ) & FORMAT ( ABS ( v ), "0.0%" ) ) )
		displayFolder: Getting in\Pay
		lineageTag: 95e52c18-dc33-52bb-83bb-677664a0da49

	/// V2: the all-bands row on a surface band (a table can't set font weight per row).
	measure 'GI row fill' = IF ( SELECTEDVALUE ( 'Experience band'[band_key] ) = "all", "#F6F7F9", "#FFFFFF" )
		isHidden
		displayFolder: Getting in\Pay
		lineageTag: 9bd0cacb-ae88-56b1-89ab-64a1c6d57c03

	measure 'GI pay alt' = "Table of entry wage, averaged over openings, and the median pay change after inflation since 2019, by the work experience BLS says the job asks, with all of these jobs and all jobs as references. " & [GI answer 2]
		isHidden
		displayFolder: Getting in\Pay
		lineageTag: 82150a84-871f-5860-8f56-b73c420b420e

	/// Hover card title: 'Jobs that ask less than 5 years of related experience'.
	measure 'GI pay card title' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", "Jobs that ask " & SWITCH ( SELECTEDVALUE ( 'Experience band'[band_key] ), "none", "no related experience", "under_5_years", "less than 5 years of related experience", "5_years_plus", "five years or more of related experience" ), "All of these jobs, any experience" )
		isHidden
		displayFolder: Getting in\Pay card
		lineageTag: 5b1eeb1a-6595-52fa-a175-cecfca48615d

	/// Hover card: the 25th percentile's change, same form as the median column. Ties to '▲ 3.5%' (None). D56 Q3 / D58: under 5 jobs, why the table shows '—' (242 / 308 px).
	measure 'GI pay card p25' =
			VAR t = [GI real pay change p25 text]
			RETURN
			    IF ( ISBLANK ( [GI band empty note] ),
			        IF ( [GI pay jobs] < 5,
			            IF ( [GI wage jobs] < 5, "No entry wage or pay change shown: under 5 jobs back them",
			                "No pay change shown: fewer than 5 jobs back it" ),
			            IF ( NOT ISBLANK ( t ), "Lower-quarter pay change, after inflation: " & t ) ) )
		isHidden
		displayFolder: Getting in\Pay card
		lineageTag: 1c3780c4-820f-575c-afb9-8f32d03d0d2a

	/// Hover card: why the lower quarter is there (design-brief §12 Tier 1 notes); D56 Q3 / D58: why a thin band shows no figure.
	measure 'GI pay card why' =
			IF ( ISBLANK ( [GI band empty note] ),
			    SWITCH ( TRUE (),
			        [GI pay jobs] < 5, "A figure from so few jobs says little about the group.",
			        [GI wage jobs] < 5, "No entry wage shown: fewer than 5 jobs with one back it.",
			        NOT ISBLANK ( [GI real pay change p25] ), "The lower quarter is a rough stand-in for early-career pay." ) )
		isHidden
		displayFolder: Getting in\Pay card
		lineageTag: fe99eefa-77fd-5fed-b363-b64365a6ab94

	/// Hover card: how many jobs the pay change rests on (associate's, less than 5 years: 1 job). D58: says the change is the workers-weighted average of each job's own change, not one group median.
	measure 'GI pay card jobs' =
			VAR n = [GI pay jobs]
			RETURN
			    IF ( ISBLANK ( [GI band empty note] ) && n > 0,
			        IF ( n = 1, "From 1 job with NY-metro pay data for 2019 and 2025",
			            "Average of " & FORMAT ( n, "#,0" ) & " jobs' own changes, weighted by workers (NY metro)" ) )
		isHidden
		displayFolder: Getting in\Pay card
		lineageTag: ca9d5e46-cfdb-5d68-ab12-0b8bd8c0e5bd

	/// Openings a year for named jobs with a projection, in the selected band. Ranks the table and draws its data bar. Ties to 121 rows / 88,573 (None).
	measure 'GI job openings' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( [L1 openings], TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), [L1 openings] )
		formatString: #,0
		displayFolder: Getting in\Jobs table
		lineageTag: 346bcfec-f358-5a5d-a554-28ed8687f39d

	/// Two significant digits (6,600; D45), 'our estimate' in words for a filled job (D45 item 7); '< 1' for Calibration Technicians (0.58, filled).
	measure 'GI job openings text' =
			VAR v = [GI job openings]
			RETURN IF ( NOT ISBLANK ( v ), IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & IF ( SELECTEDVALUE ( job_profile[is_imputed] ), " · our estimate" ) )
		displayFolder: Getting in\Jobs table
		lineageTag: dd745e13-b48e-50f3-88ec-293108bf1057

	measure 'GI job degree' = IF ( NOT ISBLANK ( [GI job openings] ), SWITCH ( SELECTEDVALUE ( job_profile[entry_education] ), "Associate's degree", "Associate's", "Bachelor's degree", "Bachelor's" ) )
		displayFolder: Getting in\Jobs table
		lineageTag: 72ff2c7e-b0ff-58d3-a712-5fd133fe1044

	/// '$95.8K'; '—' for the 4 named jobs with no published entry wage.
	measure 'GI job pay' = IF ( NOT ISBLANK ( [GI job openings] ), COALESCE ( [Job starting pay], "—" ) )
		displayFolder: Getting in\Jobs table
		lineageTag: 1bd02bb8-ac50-51d5-97a2-baccc43f60a6

	/// ACS share of NYC workers aged 22-29, as the job page's Summary; '—' when not readable (guarded, so a placeholder never adds a row).
	measure 'GI job young' = IF ( NOT ISBLANK ( [GI job openings] ), COALESCE ( [Signal young], "—" ) )
		displayFolder: Getting in\Jobs table
		lineageTag: 07bc1a55-399d-5dd7-81ed-e4a29133a50f

	/// O*NET share who needed a month or less of experience, as the job page's Summary; '—' when not readable.
	measure 'GI job newcomer' = IF ( NOT ISBLANK ( [GI job openings] ), COALESCE ( [Signal newcomer], "—" ) )
		displayFolder: Getting in\Jobs table
		lineageTag: 5ff933ad-6c3b-5792-896e-8eff06af160c

	/// Rows in the table. Ties to 121 / 28 / 15; associate's + None 28.
	measure 'GI table jobs' = COUNTROWS ( FILTER ( VALUES ( dim_job[soc_code] ), NOT ISBLANK ( [GI job openings] ) ) )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Jobs table
		lineageTag: b34647c7-1356-5633-b275-d5e2f5c435c4

	/// V3 title, from the experience buttons.
	measure 'GI table title' =
			VAR w = SWITCH ( SELECTEDVALUE ( 'Experience band'[band_key] ), "none", "no related experience", "under_5_years", "less than 5 years of related experience", "5_years_plus", "five years or more of related experience" )
			RETURN IF ( ISBLANK ( w ), "Jobs at every experience level", "Jobs that ask " & w )
		displayFolder: Getting in\Jobs table
		lineageTag: 9861ff18-f0ae-5fed-a1a6-880a0e997a24

	measure 'GI table subtitle' =
			VAR n = [GI table jobs]
			RETURN "People doing these jobs · NYC" & IF ( n > 0, " · " & n & IF ( n = 1, " job", " jobs" ) & " by openings a year (“All other” groups not listed) · — no reliable figure" )
		displayFolder: Getting in\Jobs table
		lineageTag: efa70a64-36bb-5c59-9cf7-71903914e19d

	/// Shown over the empty table: 'No associate's-entry job asks five years or more of related experience.'
	measure 'GI table empty' = IF ( [GI table jobs] = 0 && [GI openings total] > 0, "No " & IF ( ISFILTERED ( dim_degree_level[degree_level] ) && HASONEVALUE ( dim_degree_level[degree_level] ), LOWER ( SELECTEDVALUE ( dim_degree_level[degree_level] ) ) & "-entry job", "degree-level job" ) & IF ( ISFILTERED ( dim_cluster[cluster_name] ), " in this career area", "" ) & " asks " & SWITCH ( SELECTEDVALUE ( 'Experience band'[band_key] ), "none", "no related experience", "under_5_years", "less than 5 years of related experience", "5_years_plus", "five years or more of related experience" ) & "." )
		displayFolder: Getting in\Jobs table
		lineageTag: dfea4966-c180-5060-9240-94cb33224ee7

	/// D5 made concrete under the table: jobs in O*NET's low band (under 10% needed a month or less). Ties to 47 jobs, about 36K (None); 6, about 3.5K (associate's).
	measure 'GI onet line' =
			VAR t = FILTER ( VALUES ( dim_job[soc_code] ), NOT ISBLANK ( [GI job openings] )
			    && CALCULATE ( SELECTEDVALUE ( job_entry_signal[band] ), job_entry_signal[measure] = "onet_newcomer" ) = "low" )
			VAR n = COUNTROWS ( t )
			VAR o = SUMX ( t, [GI job openings] )
			RETURN IF ( n > 0, "In " & n & " of these jobs (about " & IF ( o < 1000, IF ( o < 1, "< 1", IF ( o < 10, FORMAT ( ROUND ( o, 0 ), "0" ), FORMAT ( ROUND ( o, 1 - INT ( LOG10 ( o ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( o, 1 - INT ( LOG10 ( o ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " openings a year), 9 in 10 O*NET respondents say a new hire needs more than a month of experience." )
		displayFolder: Getting in\Jobs table
		lineageTag: 08673a17-9bd0-56e3-897e-3d5c0f98225b

	/// Tooltip: the official title and code.
	measure 'GI tip job' = SELECTEDVALUE ( job_profile[soc_title] ) & " (" & SELECTEDVALUE ( job_profile[soc_code] ) & ")"
		displayFolder: Getting in\Jobs table
		lineageTag: 6f0a79d9-5906-5cb4-b897-8ed8b32d8fde

	/// Tooltip: BLS entry education and experience.
	measure 'GI tip entry' = [Job education] & " · related experience: " & LOWER ( SELECTEDVALUE ( job_profile[entry_experience] ) )
		displayFolder: Getting in\Jobs table
		lineageTag: 3cbfab8f-4aef-5aa0-bb68-64e176c0a194

	/// Tooltip: ACS share with its 90% margin and band, or why there is none (D5 qualifiers off the face).
	measure 'GI tip young' = IF ( [Signal young detail] = "–", [Signal young band detail], [Signal young detail] & " " & [Signal young moe] & " · " & [Signal young band detail] )
		displayFolder: Getting in\Jobs table
		lineageTag: d0513263-67a9-5307-8714-1e214ac5404d

	/// Tooltip: O*NET share with its band, or why there is none.
	measure 'GI tip newcomer' = IF ( [Signal newcomer detail] = "–", [Signal newcomer band detail], [Signal newcomer detail] & " · " & [Signal newcomer band detail] )
		displayFolder: Getting in\Jobs table
		lineageTag: 70f95c12-54a5-58bd-bbbf-a3ccafce9e05

	/// Tooltip: NYC median pay, 2025 (13-2011: $111K).
	measure 'GI tip median pay' =
			VAR w = SELECTEDVALUE ( job_profile[median_wage] )
			RETURN IF ( NOT ISBLANK ( w ), "$" & IF ( ABS ( w ) >= 99950, FORMAT ( ABS ( w ) / 1000, "0" ), FORMAT ( ABS ( w ) / 1000, "0.0" ) ) & "K" )
		displayFolder: Getting in\Jobs table
		lineageTag: 5273a758-2ba8-5384-8fef-70fa0c0a46fb

	/// Header answer line 1 (V1 restated, design-brief §12.2; D58 wording). The first part is VAR opener, not lead: Desktop's DAX now reserves LEAD. B16: the counts became the share, since 'about 94K of about 140K a year' ran the line to 882 px in a 732 px box; shares from projections keep two digits without 'about' (D46 item 4), the rounded counts stay in V1's labels and tooltips. Ties to 'Most openings ask no experience (69%), but 41% of jobs added since 2019 ask five years or more.'; associate's 'Almost all openings ask no experience (98%); none ask five years or more.'
	measure 'GI answer 1' =
			VAR ot = [GI openings total]
			VAR o0 = COALESCE ( [GI open none], 0 )
			VAR o5 = COALESCE ( [GI open 5plus], 0 )
			VAR s0 = DIVIDE ( o0, ot )
			VAR s5 = DIVIDE ( o5, ot )
			VAR a5 = DIVIDE ( [GI added 5plus], [GI added total] )
			VAR counts = " (" & IF ( ABS ( s0 ) < 0.005, "0%", FORMAT ( s0, "0%;−0%" ) ) & ")"
			// D58 (fact-check): the experience is BLS's typical-entry rating of the job, so the sentence says "rated", not
			// "ask" (footnote ¹ names BLS); "every" when the share is 100%; "but" only when the jobs-added share is at least
			// twice the openings share and 15% or more (Healthcare's 6% against 0.5% read as a contrast)
			VAR opener =
			    SWITCH ( TRUE (),
			        o0 = 0, "Every opening here is in a job rated as needing some related experience",
			        o0 = ot, "Every opening here is in a job rated as needing no experience",
			        s0 >= 0.95, "Almost all openings are in jobs rated as needing no experience" & counts,
			        s0 > 0.5, "Most openings are in jobs rated as needing no experience" & counts,
			        "About " & IF ( o0 < 1000, IF ( o0 < 1, "< 1", IF ( o0 < 10, FORMAT ( ROUND ( o0, 0 ), "0" ), FORMAT ( ROUND ( o0, 1 - INT ( LOG10 ( o0 ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( o0, 1 - INT ( LOG10 ( o0 ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " of about " & IF ( ot < 1000, IF ( ot < 1, "< 1", IF ( ot < 10, FORMAT ( ROUND ( ot, 0 ), "0" ), FORMAT ( ROUND ( ot, 1 - INT ( LOG10 ( ot ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( ot, 1 - INT ( LOG10 ( ot ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " openings a year are in jobs rated as needing no experience" )
			VAR tail =
			    SWITCH ( TRUE (),
			        o5 = 0, "; none are rated five years or more.",
			        NOT [GI added splits], "; " & IF ( ABS ( s5 ) < 0.005, "0%", FORMAT ( s5, "0%;−0%" ) ) & " are rated five years or more.",
			        a5 >= 2 * s5 && a5 >= 0.15, ", but " & IF ( ABS ( a5 ) < 0.005, "0%", FORMAT ( a5, "0%;−0%" ) ) & " of jobs added since 2019 are rated five years or more.",
			        "; " & IF ( ABS ( a5 ) < 0.005, "0%", FORMAT ( a5, "0%;−0%" ) ) & " of jobs added since 2019 are rated five years or more." )
			RETURN IF ( ot > 0, opener & tail, "No job in this selection has a projection." )
		displayFolder: Getting in\Text
		lineageTag: f0c87b75-39fb-5428-8967-a2fc79e34252

	/// Header as-of line (clarity header: the built data line plus the refresh date; 468 px, the meta block is 476 wide).
	measure 'GI data line' = "Data: " & [First year] & "–" & [Last year] & " · projections to 2032 · ACS 2020–2024 · refreshed " & [Refreshed date]
		displayFolder: Getting in\Text
		lineageTag: f4ed94a0-c011-58ef-bf48-e0642da67be6

	/// Header answer line 2 (D41; D56 Q2 names the average over openings, which differs from the Overview's median job). Ties to 'Entry wage, averaged over openings, is $59.9K in associate's-entry jobs and $84.2K in bachelor's-entry jobs.'; associate's '… $59.9K in associate's-entry jobs (all degree-level jobs: $82.7K).' Longest case 3 lines in 576 px (tw.py).
	measure 'GI answer 2' =
			// D58: a level's average needs PAY_MIN_JOBS jobs with a wage and openings (Digital Technology's associate's $59.3K was 1 job)
			VAR na = CALCULATE ( [GI wage jobs n], KEEPFILTERS ( job_profile[entry_education] = "Associate's degree" ) )
			VAR nb = CALCULATE ( [GI wage jobs n], KEEPFILTERS ( job_profile[entry_education] = "Bachelor's degree" ) )
			VAR pa = IF ( na >= 5, CALCULATE ( DIVIDE ( [GI pay weighted sum], [GI pay openings] ), KEEPFILTERS ( job_profile[entry_education] = "Associate's degree" ) ) )
			VAR pb = IF ( nb >= 5, CALCULATE ( DIVIDE ( [GI pay weighted sum], [GI pay openings] ), KEEPFILTERS ( job_profile[entry_education] = "Bachelor's degree" ) ) )
			VAR pall = CALCULATE ( DIVIDE ( [GI pay weighted sum], [GI pay openings] ), REMOVEFILTERS ( dim_degree_level ) )
			VAR ref = IF ( ISFILTERED ( dim_cluster[cluster_name] ), "both degree levels", "all degree-level jobs" )
			RETURN
			    SWITCH ( TRUE (),
			        NOT ISBLANK ( pa ) && NOT ISBLANK ( pb ),
			            "Entry wage, averaged over openings, is $" & IF ( ABS ( pa ) >= 99950, FORMAT ( ABS ( pa ) / 1000, "0" ), FORMAT ( ABS ( pa ) / 1000, "0.0" ) ) & "K" & " in associate's-entry jobs and $" & IF ( ABS ( pb ) >= 99950, FORMAT ( ABS ( pb ) / 1000, "0" ), FORMAT ( ABS ( pb ) / 1000, "0.0" ) ) & "K" & " in bachelor's-entry jobs.",
			        NOT ISBLANK ( pa ),
			            "Entry wage, averaged over openings, is $" & IF ( ABS ( pa ) >= 99950, FORMAT ( ABS ( pa ) / 1000, "0" ), FORMAT ( ABS ( pa ) / 1000, "0.0" ) ) & "K" & " in associate's-entry jobs" & IF ( IF ( ABS ( pall ) >= 99950, FORMAT ( ABS ( pall ) / 1000, "0" ), FORMAT ( ABS ( pall ) / 1000, "0.0" ) ) & "K" <> IF ( ABS ( pa ) >= 99950, FORMAT ( ABS ( pa ) / 1000, "0" ), FORMAT ( ABS ( pa ) / 1000, "0.0" ) ) & "K", " (" & ref & ": $" & IF ( ABS ( pall ) >= 99950, FORMAT ( ABS ( pall ) / 1000, "0" ), FORMAT ( ABS ( pall ) / 1000, "0.0" ) ) & "K" & ")" ) & ".",
			        NOT ISBLANK ( pb ),
			            "Entry wage, averaged over openings, is $" & IF ( ABS ( pb ) >= 99950, FORMAT ( ABS ( pb ) / 1000, "0" ), FORMAT ( ABS ( pb ) / 1000, "0.0" ) ) & "K" & " in bachelor's-entry jobs" & IF ( IF ( ABS ( pall ) >= 99950, FORMAT ( ABS ( pall ) / 1000, "0" ), FORMAT ( ABS ( pall ) / 1000, "0.0" ) ) & "K" <> IF ( ABS ( pb ) >= 99950, FORMAT ( ABS ( pb ) / 1000, "0" ), FORMAT ( ABS ( pb ) / 1000, "0.0" ) ) & "K", " (" & ref & ": $" & IF ( ABS ( pall ) >= 99950, FORMAT ( ABS ( pall ) / 1000, "0" ), FORMAT ( ABS ( pall ) / 1000, "0.0" ) ) & "K" & ")" ) & ".",
			        [GI wage jobs n] > 0, "Too few jobs here have a published entry wage to average it.",
			        "No job in this selection has a published entry wage." )
		displayFolder: Getting in\Text
		lineageTag: 8531e53d-a572-5e6b-9c58-fef1105c67db

	/// Header answer, Getting in (v5: one wrapping measure, up to 3 lines at 10 pt in the 576 px column): the two sentences above, in order.
	measure 'GI answer' = [GI answer 1] & " " & [GI answer 2]
