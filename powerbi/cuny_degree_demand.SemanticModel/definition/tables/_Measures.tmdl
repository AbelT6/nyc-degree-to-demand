		lineageTag: b1d4c6c3-50d9-5159-bb5d-8f6ba65dee40

	/// The line's value at the slider year only: a markers-only series that enlarges the picked point.
	measure 'People NYC pick point' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Year pick value], [People NYC change] )
		formatString: +0.0%;−0.0%;0.0%
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 8183bf54-bb66-55f9-86f6-bdb5b21a2008

	/// Readout value at the slider year; 'no figure' when the line has none that year (D38; the lead names the year). Ties to '−2.2%' (2025), '+6.4%' (2022).
	measure 'People NYC at pick text' =
			VAR y = [Year pick value]
			VAR v = CALCULATE ( [People NYC change], job_employment_trend[year] = y )
			RETURN IF ( [Job has NYC line], IF ( ISBLANK ( v ), "no figure", IF ( y = [First year], "0%", IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "−", "+" ) & FORMAT ( ABS ( v ), "0.0%" ) ) ) ) )
		displayFolder: Job page\How it changed
		lineageTag: d67b33c2-b2e9-502a-9a03-5cda4034f767

	/// The line's value at the slider year only: a markers-only series that enlarges the picked point.
	measure 'People metro pick point' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Year pick value], [People metro change] )
		formatString: +0.0%;−0.0%;0.0%
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: e7e5750a-2eb2-513f-a98e-ac3df70ee982

	/// Readout value at the slider year; 'no figure' when the line has none that year (D38; the lead names the year). Ties to '−7.1%' (2025), '+4.4%' (2022).
	measure 'People metro at pick text' =
			VAR y = [Year pick value]
			VAR v = CALCULATE ( [People metro change], job_employment_trend[year] = y )
			RETURN IF ( [Job has metro line], IF ( ISBLANK ( v ), "no figure", IF ( y = [First year], "0%", IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "−", "+" ) & FORMAT ( ABS ( v ), "0.0%" ) ) ) ) )
		displayFolder: Job page\How it changed
		lineageTag: e5851138-2688-57ab-9f0c-f09447d415e0

	/// NY metro median annual wage in 2025 dollars, % change since 2019 (OEWS, CPI-U). Ties to −6.2% (105,650 / 112,684), +0.7% (2022).
	measure 'Pay median change' =
			VAR y0 = [First year]
			VAR v = CALCULATE ( MAX ( job_employment_trend[annual_p50_2025usd] ), job_employment_trend[area_key] = "ny_metro" )
			VAR b = CALCULATE ( MAX ( job_employment_trend[annual_p50_2025usd] ), job_employment_trend[area_key] = "ny_metro", job_employment_trend[year] = y0 )
			RETURN IF ( HASONEVALUE ( dim_job[soc_code] ) && NOT ISBLANK ( v ) && NOT ISBLANK ( b ), DIVIDE ( v, b ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Job page\How it changed
		lineageTag: 86522157-c329-5dac-a375-46f3cbb4bd58

	/// Details readout value at the slider year; 'no figure' as on Summary.
	measure 'Pay median at pick text' =
			VAR y = [Year pick value]
			VAR v = CALCULATE ( [Pay median change], job_employment_trend[year] = y )
			RETURN IF ( [Job has pay line], IF ( ISBLANK ( v ), "no figure", IF ( y = [First year], "0%", IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "−", "+" ) & FORMAT ( ABS ( v ), "0.0%" ) ) ) ) )
		displayFolder: Job page\How it changed
		lineageTag: d16a3c8a-d5b5-5bbe-b4f9-3f35016a1c78

	/// NY metro lower quarter annual wage in 2025 dollars, % change since 2019 (OEWS, CPI-U). Ties to −4.3% (82,830 / 86,550).
	measure 'Pay lower quarter change' =
			VAR y0 = [First year]
			VAR v = CALCULATE ( MAX ( job_employment_trend[annual_p25_2025usd] ), job_employment_trend[area_key] = "ny_metro" )
			VAR b = CALCULATE ( MAX ( job_employment_trend[annual_p25_2025usd] ), job_employment_trend[area_key] = "ny_metro", job_employment_trend[year] = y0 )
			RETURN IF ( HASONEVALUE ( dim_job[soc_code] ) && NOT ISBLANK ( v ) && NOT ISBLANK ( b ), DIVIDE ( v, b ) - 1 )
		formatString: +0.0%;−0.0%;0.0%
		displayFolder: Job page\How it changed
		lineageTag: a7441776-b2d1-52ab-a9db-7025c0e4f47f

	/// Details readout value at the slider year; 'no figure' as on Summary.
	measure 'Pay lower quarter at pick text' =
			VAR y = [Year pick value]
			VAR v = CALCULATE ( [Pay lower quarter change], job_employment_trend[year] = y )
			RETURN IF ( [Job has pay line], IF ( ISBLANK ( v ), "no figure", IF ( y = [First year], "0%", IF ( ABS ( v ) < 0.0005, "0.0%", IF ( v < 0, "−", "+" ) & FORMAT ( ABS ( v ), "0.0%" ) ) ) ) )
		displayFolder: Job page\How it changed
		lineageTag: b51441e6-fe9a-5043-b025-6fe62e89dc2a

	/// TRUE when the job has a 2019 NY metro median of its own (the pay lines' base): not for the 22 ◆ jobs (D58).
	measure 'Job has pay line' =
			VAR y0 = [First year]
			// D58 (fact-check): a ◆ job's 2019 median is its old combined code's (Medical Dosimetrists "+181.9%"), so no line
			RETURN NOT SELECTEDVALUE ( job_profile[split_2019] )
			    && NOT ISBLANK ( CALCULATE ( MAX ( job_employment_trend[annual_p50_2025usd] ), job_employment_trend[area_key] = "ny_metro", job_employment_trend[year] = y0 ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 4a7e0df6-f59d-5f69-9580-f92b6db2a482

	/// Summary pay line, the gray label (304 px at 10pt with the space after it). Ties to 'Median pay after inflation, NY metro, 2025 vs 2019:'.
	measure 'Pay at pick label' = IF ( [Job has pay line], "Median pay after inflation, NY metro, " & [Year pick value] & " vs " & [First year] & ":" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 24dd67cf-d093-5739-83e6-c95adaa034c9

	/// Summary pay line, the semibold value. Ties to '▼6.2%' (2025) and '▲0.7%' (2022).
	measure 'Pay at pick value' =
			VAR y = [Year pick value]
			VAR v = CALCULATE ( [Pay median change], job_employment_trend[year] = y )
			RETURN IF ( [Job has pay line], IF ( ISBLANK ( v ), "no figure", IF ( y = [First year], "0%", IF ( v < 0, "▼", "▲" ) & FORMAT ( ABS ( v ), "0.0%" ) ) ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: bdd69b7d-a803-5e8f-9a52-a22c18466066

	/// Summary line under the people chart, whole (shown as label + value). Ties to '… 2025 vs 2019: ▼6.2%' and '2022 vs 2019: ▲0.7%'.
	measure 'Pay at pick line' = IF ( [Job has pay line], [Pay at pick label] & " " & [Pay at pick value] )
		displayFolder: Job page\How it changed
		lineageTag: ad08c15a-d4ed-52b4-952c-7c4c7a18c95e

	/// Details pay chart title, from the median line's last point. With no 2019 base (14 jobs: the series starts 2020-2025) it says when the series starts; 2 jobs have no series. Ties to 'Pay fell after inflation: median 6.2% lower than in 2019'; 11-2032 'No 2019 pay to compare with: the NY metro series starts in 2021'.
	measure 'Pay title' =
			VAR y0 = [First year]
			VAR ys = CALCULATE ( MIN ( job_employment_trend[year] ), job_employment_trend[area_key] = "ny_metro", NOT ISBLANK ( job_employment_trend[annual_p50_2025usd] ) )
			VAR yl = CALCULATE ( MAX ( job_employment_trend[year] ), job_employment_trend[area_key] = "ny_metro", NOT ISBLANK ( job_employment_trend[annual_p50_2025usd] ) )
			VAR v = CALCULATE ( [Pay median change], job_employment_trend[year] = yl )
			RETURN
			    IF ( HASONEVALUE ( dim_job[soc_code] ),
			        SWITCH ( TRUE (),
			            ISBLANK ( ys ), "No NY metro pay series for this job",
			            SELECTEDVALUE ( job_profile[split_2019] ), "No pay change for this job alone: code split in 2021 ◆",
			            NOT [Job has pay line], "No " & y0 & " median to compare: published from " & ys,
			            yl = y0 || ISBLANK ( v ), "No NY metro pay since " & y0 & " for this job",
			            v < 0, "Median pay fell " & FORMAT ( -v, "0.0%" ) & " after inflation since " & y0,
			            "Median pay rose " & FORMAT ( v, "0.0%" ) & " after inflation since " & y0 ) )
		displayFolder: Job page\How it changed
		lineageTag: 7a43a106-8316-551b-b2aa-407c5c3d0131

	/// Details projection line, the gray label (v5: 124 px at 8 pt, so the longest value, 223 px, fits the 368 px column; was 'Jobs in NYC, NYS DOL projection:').
	measure 'Job projection label' = IF ( SELECTEDVALUE ( job_profile[has_projection] ), IF ( SELECTEDVALUE ( job_profile[is_imputed] ), "NYC jobs (our estimate):", "Jobs in NYC (NYS DOL):" ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 71d7713c-c94a-5e30-8eb1-c958073c72a1

	/// Details projection line, the semibold value: the 2022 base (agency estimate, three digits) and the 2032 projection (two digits with 'about', B11). Ties to '76,300 in 2022 → about 82,000 in 2032' (76,330; 82,410).
	measure 'Job projection value' =
			VAR b = SELECTEDVALUE ( job_profile[base_employment] )
			VAR p = SELECTEDVALUE ( job_profile[projected_employment] )
			RETURN IF ( SELECTEDVALUE ( job_profile[has_projection] ), FORMAT ( ROUND ( b, 3 - IF ( b >= 1, INT ( LOG10 ( b ) ) + 1, 1 ) ), "#,0" ) & " in 2022 → about " & IF ( p < 1, "< 1", IF ( p < 10, FORMAT ( ROUND ( p, 0 ), "0" ), FORMAT ( ROUND ( p, 1 - INT ( LOG10 ( p ) ) ), "#,0" ) ) ) & " in 2032" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: a75bd497-0fff-5b78-a2e8-76fdc29d9fc4

	/// Details line, whole (shown as label + value). Ties to 'Jobs in NYC (NYS DOL): 76,300 in 2022 → about 82,000 in 2032'.
	measure 'Job projection line' = IF ( SELECTEDVALUE ( job_profile[has_projection] ), [Job projection label] & " " & [Job projection value] )
		displayFolder: Job page\How it changed
		lineageTag: da91afb7-9323-5cf6-b036-eec1d44e98cd

	/// Outlook line, the gray label (v5: 166 px at 8 pt, so 'Very Unfavorable · projected −10%', 180 px, fits the 368 px column; was 'Outlook to 2032, NYS DOL rating for NYC:').
	measure 'Job outlook label' = IF ( SELECTEDVALUE ( job_profile[prospects_usable] ), "NYC outlook to 2032 (NYS DOL):" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: a1cf8e0b-05ff-54a3-8631-bd032ede82ac

	/// Outlook line, the semibold value, with the projected change moved off card 1 (D46 item 3). Ties to 'Favorable · projected +8%'.
	measure 'Job outlook value' = IF ( SELECTEDVALUE ( job_profile[prospects_usable] ), SELECTEDVALUE ( job_profile[employment_prospects] ) & [Job projected change words] )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 31da2f26-c0d6-55a6-9a56-0a4b4b21dc07

	/// ' · projected +8%': NYC jobs 2022 -> 2032, a projected percent change in whole numbers (D45 item 5).
	measure 'Job projected change words' =
			VAR p = SELECTEDVALUE ( job_profile[pct_change_2022_2032] )
			RETURN IF ( SELECTEDVALUE ( job_profile[has_projection] ) && NOT ISBLANK ( p ), " · projected " & IF ( ROUND ( p, 2 ) = 0, "0%", FORMAT ( p, "+0%;−0%" ) ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: e852c284-8294-59a6-a54e-abf8350ac40d

	/// Summary fallback line when the job has no usable NYS DOL rating (63 jobs) but has a projection, so the projected change isn't lost.
	measure 'Job projected change label' = IF ( NOT SELECTEDVALUE ( job_profile[prospects_usable] ) && SELECTEDVALUE ( job_profile[has_projection] ), "Jobs in NYC, projected 2022–2032:" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 894e4dbb-58f5-5da9-9882-1878542771a9

	/// The fallback line's value: '+8%' (the words measure without ' · projected ').
	measure 'Job projected change value' = IF ( NOT SELECTEDVALUE ( job_profile[prospects_usable] ) && SELECTEDVALUE ( job_profile[has_projection] ), MID ( [Job projected change words], 14, 10 ) )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: bb9174e3-d0f6-5676-9cea-ba2c3ed2d6af

	/// Outlook line, whole (shown as label + value). Hidden when the rating is unusable (63 jobs). Ties to 'Outlook to 2032, NYS DOL rating for NYC: Favorable'.
	measure 'Job outlook line' = IF ( SELECTEDVALUE ( job_profile[prospects_usable] ), [Job outlook label] & " " & [Job outlook value] )
		displayFolder: Job page\How it changed
		lineageTag: 054028cc-5e83-5e90-9368-fa46dc699700

	/// Visual filter of the year slider (> 0): 1 when the job has a people line or a pay line for the slider to move along.
	measure 'Year slider in use' = IF ( [Job has NYC line] || [Job has metro line] || [Job has pay line], 1 )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 685b912f-6560-5360-bca9-1e1845af4e77

	/// Readout slot 1: the NY metro value when it is the only line.
	measure 'People metro at pick text 1' = IF ( NOT [Job has NYC line], [People metro at pick text] )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 9098d4d8-9ddf-5620-b39c-4e7b3cc1d16b

	/// Readout slot 2: the NY metro value beside NYC.
	measure 'People metro at pick text 2' = IF ( [Job has NYC line], [People metro at pick text] )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 27d287ad-00c0-572f-a5b0-937157b2b013

	/// D38: the people chart's missing years, by line (NYC 1 job, NY metro 18). Ties to Chief Executives 'No metro figure for 2023–2024'.
	measure 'People gap note' =
			VAR n = IF ( [Job has NYC line], SELECTEDVALUE ( job_profile[nyc_missing_years] ) )
			VAR mt = IF ( [Job has metro line], SELECTEDVALUE ( job_profile[metro_missing_years] ) )
			RETURN
			    SWITCH ( TRUE (),
			        NOT ISBLANK ( n ) && NOT ISBLANK ( mt ), "No NYC figure for " & n & "; no metro figure for " & mt,
			        NOT ISBLANK ( n ), "No NYC figure for " & n,
			        NOT ISBLANK ( mt ), "No metro figure for " & mt )
		displayFolder: Job page\How it changed
		lineageTag: 014582ea-dc0e-5b76-9bb2-29db2e8aa2b9

	/// D38: the pay chart's missing years (both lines alike except Airline Pilots, median only). Ties to Aerospace Eng. Technicians 'No pay figure for 2022–2023'.
	measure 'Pay gap note' =
			VAR a = IF ( [Job has pay line], SELECTEDVALUE ( job_profile[p50_missing_years] ) )
			VAR b = IF ( [Job has pay line], SELECTEDVALUE ( job_profile[p25_missing_years] ) )
			RETURN
			    SWITCH ( TRUE (),
			        NOT ISBLANK ( a ) && a = b, "No pay figure for " & a,
			        NOT ISBLANK ( a ) && NOT ISBLANK ( b ), "No median figure for " & a & "; no lower-quarter figure for " & b,
			        NOT ISBLANK ( a ), "No median figure for " & a,
			        NOT ISBLANK ( b ), "No lower-quarter figure for " & b )
		displayFolder: Job page\How it changed
		lineageTag: b58394e5-74be-50c5-9f75-bec55a7d8e56

	/// Row under the people chart, left: the gap note (D38), else the slider hint; blank with no line. D60: the hint is plain words after a gold tick (was '◂ drag to pick a year ▸').
	measure 'People chart hint' =
			VAR g = [People gap note]
			RETURN IF ( NOT ISBLANK ( g ), g, IF ( [Job has NYC line] || [Job has metro line], "Drag to pick a year" ) )
		displayFolder: Job page\How it changed
		lineageTag: 7f5d6283-f2bc-594c-a525-7d87d3db14de

	/// D60: the hint's gold tick; white (hidden on the card) when a gap note or nothing takes the row.
	measure 'People chart hint tick' = IF ( ISBLANK ( [People gap note] ) && ( [Job has NYC line] || [Job has metro line] ), "#FFB81C", "#FFFFFF" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 0080163b-db8a-5553-aace-755b21c02200

	/// D60: a hint in dark text, a gap note in label gray.
	measure 'People chart hint color' = IF ( ISBLANK ( [People gap note] ), "#1F2328", "#5B6470" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: da1b9f81-dc87-5662-976a-07ca7a468645

	/// Row under the pay chart, left: the gap note (D38), else the slider hint; blank with no pay line. D60: plain words after a gold tick.
	measure 'Pay chart hint' =
			VAR g = [Pay gap note]
			RETURN IF ( NOT ISBLANK ( g ), g, IF ( [Job has pay line], "Drag to pick a year" ) )
		displayFolder: Job page\How it changed
		lineageTag: 973cd64b-814b-59d2-a386-1be55ff6f8c6

	/// D60: the pay hint's gold tick; white when a gap note or nothing takes the row.
	measure 'Pay chart hint tick' = IF ( ISBLANK ( [Pay gap note] ) && [Job has pay line], "#FFB81C", "#FFFFFF" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 6ea619ec-07aa-5ca8-9ea6-ce912e53f520

	/// D60: a hint in dark text, a gap note in label gray.
	measure 'Pay chart hint color' = IF ( ISBLANK ( [Pay gap note] ), "#1F2328", "#5B6470" )
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: bbeab91b-b58e-57c9-9b88-c4d13fc3f214

	/// The year OEWS redrew the NY metro area (job_employment_trend.series_note area_delineation_2024): 2024.
	measure 'Metro break year' =
			CALCULATE ( MIN ( job_employment_trend[year] ), REMOVEFILTERS ( job_employment_trend[year] ),
			    job_employment_trend[area_key] = "ny_metro", job_employment_trend[series_note] = "area_delineation_2024" )
		formatString: 0
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 921fc292-8688-5732-95bb-dd2a8def8159

	/// Row under the chart, right (mockup v4.1): explains the ◆ point (it sits on 2024); blank when the line has no point that year. v5 row 252 px at 8 pt Inter (in Desktop: 'in 2024' made it 155 px and it ran into the 113 px hint): 112 px beside the hint, 81 px beside a gap note (up to 159 px, 16 jobs).
	measure 'People break note' =
			VAR y = [Metro break year]
			VAR has = NOT ISBLANK ( CALCULATE ( MAX ( job_employment_trend[metro_employment] ), REMOVEFILTERS ( job_employment_trend[year] ),
			              job_employment_trend[area_key] = "ny_metro", job_employment_trend[year] = y ) )
			RETURN IF ( [Job has metro line] && has, IF ( ISBLANK ( [People gap note] ), "◆ metro area redrawn", "◆ area redrawn" ) )
		displayFolder: Job page\How it changed
		lineageTag: eccd49b7-e0fa-5091-86db-f12499c31fa2

	/// Row under the chart, right (mockup v4.1): explains the ◆ point (it sits on 2024); blank when the line has no point that year. v5 row 252 px at 8 pt Inter (in Desktop: 'in 2024' made it 155 px and it ran into the 113 px hint): 112 px beside the hint, 81 px beside a gap note (up to 159 px, 16 jobs).
	measure 'Pay break note' =
			VAR y = [Metro break year]
			VAR has = NOT ISBLANK ( CALCULATE ( MAX ( job_employment_trend[annual_p50_2025usd] ), REMOVEFILTERS ( job_employment_trend[year] ),
			              job_employment_trend[area_key] = "ny_metro", job_employment_trend[year] = y ) )
			RETURN IF ( [Job has pay line] && has, IF ( ISBLANK ( [Pay gap note] ), "◆ metro area redrawn", "◆ area redrawn" ) )
		displayFolder: Job page\How it changed
		lineageTag: 0b4e1446-0907-526f-999e-6781366519ac

	/// The line's value in the redraw year only: a markers-only ◆ series over that point.
	measure 'People metro break point' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Metro break year], [People metro change] )
		formatString: +0.0%;−0.0%;0.0%
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 075c3f6d-c5e6-52f9-a715-52eac38d2ea2

	/// The line's value in the redraw year only: a markers-only ◆ series over that point.
	measure 'Pay median break point' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Metro break year], [Pay median change] )
		formatString: +0.0%;−0.0%;0.0%
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 37ea44b7-2e9f-53d3-9872-8dd3e54094f9

	/// The line's value in the redraw year only: a markers-only ◆ series over that point.
	measure 'Pay lower quarter break point' = IF ( SELECTEDVALUE ( job_employment_trend[year] ) = [Metro break year], [Pay lower quarter change] )
		formatString: +0.0%;−0.0%;0.0%
		isHidden
		displayFolder: Job page\How it changed
