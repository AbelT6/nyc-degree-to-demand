		displayFolder: Getting in\Experience
		lineageTag: de66eea6-e1d9-5c0d-a2f4-4da50918fa10

	measure 'GI added 5plus' = CALCULATE ( SUM ( job_profile[nyc_change_2019_2025] ), job_profile[bls_experience_band] = "5_years_plus" )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: c859045a-6e02-5cad-b661-486d750f5b69

	measure 'GI open none' = CALCULATE ( SUM ( job_profile[annual_openings_avg] ), job_profile[bls_experience_band] = "none" )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: fe86050f-358e-5160-8400-cee0ee9f04a2

	measure 'GI open 5plus' = CALCULATE ( SUM ( job_profile[annual_openings_avg] ), job_profile[bls_experience_band] = "5_years_plus" )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: ffa205cf-c668-59dd-ab88-547f5154e374

	/// The smallest band share of jobs added (blank bands skipped).
	measure 'GI added min share' =
			VAR t = [GI added total]
			RETURN MINX ( { DIVIDE ( [GI added none], t ), DIVIDE ( [GI added under5], t ), DIVIDE ( [GI added 5plus], t ) }, [Value] )
		formatString: 0.0%
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: ca9b7dcc-ed4c-5db6-bcb8-5ab0e2d9b7d8

	/// True when growth splits into shares: at least 1,000 jobs added and no band lost a visible share (Energy's -42 of +25,240 still splits). 34 of the 39 career area x level views split.
	measure 'GI added splits' = [GI added total] >= 1000 && [GI added min share] >= -0.005
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: 8bb70fd1-7711-52eb-a4f5-ccce4152d4b7

	/// V1 gray bars: the band's share of jobs added; blank (bars hidden, 'GI added note' says why) when growth doesn't split. Ties to 0.449 / 0.141 / 0.411.
	measure 'GI added share' = IF ( [GI added splits], DIVIDE ( COALESCE ( [GI added], 0 ), [GI added total] ) )
		formatString: 0%
		displayFolder: Getting in\Experience
		lineageTag: e6dd22b9-21b1-596c-94a7-39af45700476

	/// V1's answer under its question (G2), from the same shares as the bars, under the slicers; the jobs-added half only when growth splits into shares (GI added splits). Ties to '69% of openings a year ask no experience; of jobs added since 2019, 41% ask 5+ years ¹'.
	measure 'GI v1 answer' =
			VAR t = [GI openings total]
			VAR so = DIVIDE ( [GI open none], t )
			VAR s5 = IF ( [GI added splits], DIVIDE ( [GI added 5plus], [GI added total] ) )
			RETURN
			    IF ( t > 0,
			        FORMAT ( so, "0%" ) & " of openings a year ask no experience"
			            & IF ( NOT ISBLANK ( s5 ), "; of jobs added since 2019, " & FORMAT ( s5, "0%" ) & " ask 5+ years" ) & " ¹" )
		displayFolder: Getting in\Experience
		lineageTag: a76c0a70-1520-5973-852b-c0e8f6d441e8

	/// V1 accent bar label: '69% · about 94K a year' (a projection: two significant digits with 'about', D45); 'no openings' for an empty band.
	measure 'GI openings label' =
			VAR s = [GI openings share]
			VAR o = COALESCE ( [GI openings], 0 )
			RETURN IF ( NOT ISBLANK ( s ), IF ( o <= 0, "no openings", IF ( ABS ( s ) < 0.005, "0%", FORMAT ( s, "0%;−0%" ) ) & " · about " & IF ( o < 1000, IF ( o < 1, "< 1", IF ( o < 10, FORMAT ( ROUND ( o, 0 ), "0" ), FORMAT ( ROUND ( o, 1 - INT ( LOG10 ( o ) ) ), "#,0" ) ) ), ( VAR r__ = ROUND ( o, 1 - INT ( LOG10 ( o ) ) ) RETURN FORMAT ( r__ / 1000, IF ( r__ >= 10000, "0", "0.0" ) ) & "K" ) ) & " a year" ) )
		displayFolder: Getting in\Experience
		lineageTag: 39663b01-091f-5dd1-b23c-738a7f040d75

	/// V1 gray bar label: '45% · +91.7K'.
	measure 'GI added label' =
			VAR s = [GI added share]
			VAR a = COALESCE ( [GI added], 0 )
			RETURN IF ( NOT ISBLANK ( s ), IF ( ABS ( s ) < 0.005, "0%", FORMAT ( s, "0%;−0%" ) ) & " · " & IF ( a < 0, "−", "+" ) & IF ( ABS ( a ) < 1000, FORMAT ( ROUND ( ABS ( a ), 3 - IF ( ABS ( a ) >= 1, INT ( LOG10 ( ABS ( a ) ) ) + 1, 1 ) ), "#,0" ), IF ( ABS ( a ) >= 99950, FORMAT ( ABS ( a ) / 1000, "0" ), FORMAT ( ABS ( a ) / 1000, "0.0" ) ) & "K" ) )
		displayFolder: Getting in\Experience
		lineageTag: 32d388ad-b1ec-5220-a226-d76d6a3b753e

	/// V1's line when the gray bars hide: growth under 1,000 (associate's: '(−174)'), or a band that lost a visible share (5 views, e.g. Financial Services, less than 5 years −859).
	measure 'GI added note' =
			VAR t = [GI added total]
			VAR a0 = COALESCE ( [GI added none], 0 )
			VAR a1 = COALESCE ( [GI added under5], 0 )
			VAR a5 = COALESCE ( [GI added 5plus], 0 )
			VAR lo = MIN ( MIN ( a0, a1 ), a5 )
			VAR words = SWITCH ( lo, a0, "no experience", a1, "less than 5 years", "five years or more" )
			RETURN
			    SWITCH ( TRUE (),
			        NOT ( [GI openings total] > 0 ), BLANK (),
			        t <= -1000, "No growth to split: these jobs lost " & IF ( ABS ( t ) >= 99950, FORMAT ( ABS ( t ) / 1000, "0" ), FORMAT ( ABS ( t ) / 1000, "0.0" ) ) & "K" & " since 2019.",
			        // D58: says only the size (Construction, associate's: +823 was +15% with no job losing any)
			        t < 1000, "Too small a change to split into shares: "
			            & IF ( t < 0, "−", IF ( t > 0, "+", "" ) ) & IF ( t = 0, "0", FORMAT ( ROUND ( ABS ( t ), 3 - IF ( ABS ( t ) >= 1, INT ( LOG10 ( ABS ( t ) ) ) + 1, 1 ) ), "#,0" ) ) & " since 2019.",
			        NOT [GI added splits], "Growth doesn't split into shares here: jobs asking " & words & " lost " & IF ( ABS ( lo ) < 1000, FORMAT ( ROUND ( ABS ( lo ), 3 - IF ( ABS ( lo ) >= 1, INT ( LOG10 ( ABS ( lo ) ) ) + 1, 1 ) ), "#,0" ), IF ( ABS ( lo ) >= 99950, FORMAT ( ABS ( lo ) / 1000, "0" ), FORMAT ( ABS ( lo ) / 1000, "0.0" ) ) & "K" ) & " since 2019.",
			        BLANK () )
		displayFolder: Getting in\Experience
		lineageTag: c51956e1-51c6-5377-9a57-d22154ef6dcc

	/// Tooltip: jobs (and 'All other' groups) in the band. Ties to 178 / 30 / 17.
	measure 'GI jobs in band' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( COUNTROWS ( job_profile ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), COUNTROWS ( job_profile ) )
		formatString: #,0
		displayFolder: Getting in\Experience
		lineageTag: 9b84bda3-7498-5bd0-a228-2ed2a462588b

	/// Tooltip: the band's BLS meaning (footnote ¹ says it is not a hiring rule).
	measure 'GI band definition' =
			SWITCH ( SELECTEDVALUE ( 'Experience band'[band_key] ),
			    "none", "BLS: no work experience in a related job is typically needed to start.",
			    "under_5_years", "BLS: less than 5 years of work experience in a related job is typically needed to start.",
			    "5_years_plus", "BLS: 5 years or more of work experience in a related job is typically needed to start." )
		displayFolder: Getting in\Experience
		lineageTag: 963f75a1-b95f-5125-ad9d-da3e19b76674

	measure 'GI experience alt' = "Bar chart of the share of openings a year, 2022 to 2032, and of NYC jobs added since 2019, by the work experience BLS says the job asks: none, less than 5 years, 5 years or more. " & [GI answer 1]
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: eff910fe-af61-55f6-8a26-61e087559b24

	measure 'GI pay weighted sum' = SUMX ( job_profile, job_profile[entry_wage] * job_profile[annual_openings_avg] )
