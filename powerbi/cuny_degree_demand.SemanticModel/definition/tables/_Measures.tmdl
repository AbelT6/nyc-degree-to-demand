	/// Header as-of line.
	measure 'WF data line' = "Data: jobs " & [First year] & "–" & [Last year] & " · projections 2022–2032 · degrees 2024 · refreshed " & [Refreshed date]
		displayFolder: What we found\Text
		lineageTag: c22b7e79-1dfc-51b8-8d1b-8fc261e8ed65

	/// What we found, footer cell (mart.footnote page findings).
	measure 'WF note rule' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "findings_rule", footnote[page_key], "findings" )
		displayFolder: Shared\Footer
		lineageTag: e65cd687-122f-5d90-af49-340049955a8f

	/// What we found, footer cell (mart.footnote page findings).
	measure 'WF note 1' = "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "bls_ai_exposure", footnote[page_key], "findings" )
		displayFolder: Shared\Footer
		lineageTag: a22f7bf7-73f4-547d-a97d-80aad2e3f1dd

	/// What we found, footer cell (mart.footnote page findings).
	measure 'WF note rounding' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "findings_rounding", footnote[page_key], "findings" )
		displayFolder: Shared\Footer
		lineageTag: 08ee506f-bdec-530c-8f60-09f1b88454be

	/// What we found, footer cell (mart.footnote page findings).
	measure 'WF sources' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "sources_findings", footnote[page_key], "findings" )
		displayFolder: Shared\Footer
		lineageTag: 5a3b5805-cc21-5d65-969b-1107e6830708

	/// Majors (major x level) with 2024 first-major awards at NYC colleges: the finder's universe, fixed (ignores the slicers). Ties to 545.
	measure 'MF majors with graduates' = CALCULATE ( COUNTROWS ( dim_major ), REMOVEFILTERS ( dim_major ), dim_major[has_graduates_2024] = TRUE () )
		formatString: #,0
		displayFolder: Find your major\Header
		lineageTag: dbd90e48-67a7-5ad0-93f1-e80fe54ce925

	/// Header answer. Ties to '545 majors had 2024 graduates at NYC colleges. Pick one to see the NYC jobs it leads to.' (v5: 567 of 576 px at 10 pt Inter, one line; the old wording wrapped its last word, craft review)
	measure 'MF answer' = FORMAT ( [MF majors with graduates], "#,0" ) & " majors had 2024 graduates at NYC colleges. Pick one to see the NYC jobs it leads to."
		displayFolder: Find your major\Header
		lineageTag: 04c2b140-a9c2-5d2a-8d7b-2d31667ee9d1

	/// Filter-context line (design-brief §4.1): the career-area pick (F1) and the level buttons' pick.
	measure 'MF showing' =
			VAR lvl =
			    IF ( ISFILTERED ( dim_major[level_label] ) && HASONEVALUE ( dim_major[level_label] ),
			        LOWER ( SELECTEDVALUE ( dim_major[level_label] ) ) & " majors", "associate's and bachelor's majors" )
			VAR areas =
			    IF ( ISFILTERED ( dim_cluster[cluster_name] ),
			        VAR n = COUNTROWS ( VALUES ( dim_cluster[cluster_name] ) )
			        RETURN IF ( n = 1, SELECTEDVALUE ( dim_cluster[cluster_name] ), n & " career areas" ),
			        "all career areas" )
			RETURN "Showing: " & areas & " · " & lvl & " with 2024 graduates · NYC colleges"
		displayFolder: Find your major\Header
		lineageTag: 3228abd6-4e07-517c-8d6f-ee286b6f0ad8

	/// Find your major's table filter (F1): 1 when no career area is picked, else 1 when the major links to a job in a picked area (mart.bridge_major_cluster, by subcluster). bridge_major_cluster has no relationship in the model (two filter paths from dim_cluster to job_major_link would be ambiguous), so the pick reaches it by TREATAS. Majors with no linked job at their level are in no area.
	measure 'MF in area' =
			IF ( NOT ISFILTERED ( dim_cluster[cluster_name] ), 1,
			    INT ( NOT ISEMPTY ( CALCULATETABLE ( bridge_major_cluster,
			        TREATAS ( VALUES ( dim_cluster[subcluster_id] ), bridge_major_cluster[subcluster_id] ),
			        TREATAS ( VALUES ( dim_major[major_award_key] ), bridge_major_cluster[major_award_key] ) ) ) ) )
		formatString: 0
		isHidden
		displayFolder: Find your major\Table
		lineageTag: c628f37d-c8ac-5072-9358-ff024fe82d85

	/// Header as-of line.
	measure 'MF data line' = "Data: degrees 2024 (provisional) · projections 2022–2032 · refreshed " & [Refreshed date]
		displayFolder: Find your major\Header
		lineageTag: ed29a728-cf07-5604-aa9e-3b4b03d921df

	/// Row name: the plain CIP title (dim_major[major_label] stays in the row, 1 px, as the drill-through field). Titles repeat only on majors with no 2024 graduates, which the finder leaves out.
	measure 'MF name' = SELECTEDVALUE ( dim_major[major_title] )
		displayFolder: Find your major\Table
		lineageTag: ca1bf650-6278-5231-bd62-1f5ad9bd121c

	/// Associate's / Bachelor's.
	measure 'MF level' = SELECTEDVALUE ( dim_major[level_label] )
		displayFolder: Find your major\Table
		lineageTag: d6e373cb-5994-5596-9751-6c04e711dd38

	/// Degrees awarded in 2024 (first majors, IPEDS provisional), all NYC colleges; counted. Ties to Psychology, General (bachelor's) 4,129; all 545 sum to 73,225.
	measure 'MF degrees' = SUM ( major_supply_demand[awards_2024_nyc] )
		formatString: #,0
		displayFolder: Find your major\Table
		lineageTag: dd14ba81-f393-576b-9813-dd3392f28bb6

	/// Same, CUNY colleges; 0 for none (205 of the 545; '–' read as missing). Ties to Psychology, General (bachelor's) 2,927; all sum to 34,839.
	measure 'MF degrees CUNY' = SUM ( major_supply_demand[awards_2024_cuny] )
		formatString: #,0;−#,0;0
		displayFolder: Find your major\Table
		lineageTag: 4f4cac28-83c4-5c88-bf2a-7a9f38f48559

	/// The major's kind (dim_major.kind_key, five kinds; note major_kinds). Ties to Accounting (bachelor's) 'Leads to degree-level jobs'.
	measure 'MF kind' = SELECTEDVALUE ( dim_major[kind_label] )
		displayFolder: Find your major\Table
		lineageTag: 3c4e80b4-8789-5594-8265-6eb057de617d

	measure 'MF alt' = "Table of the " & FORMAT ( [MF majors with graduates], "#,0" ) & " majors with 2024 graduates at NYC colleges, most degrees first: each major's level, its 2024 degrees at all NYC colleges and at CUNY, and its kind of job link. Click a row, then open its page."
		isHidden
		displayFolder: Find your major\Table
		lineageTag: 5bb3438a-46a2-5cb9-9241-7e223c8794c1

	/// Find your major, footer cell (mart.footnote page find_major).
	measure 'MF note 1' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "major_job_link", footnote[page_key], "find_major" )
		displayFolder: Shared\Footer
		lineageTag: 227be24a-5ce3-52b2-b5b4-cef40ee6b9ff

	/// Find your major, footer cell (mart.footnote page find_major).
	measure 'MF note 2' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "major_kinds", footnote[page_key], "find_major" )
		displayFolder: Shared\Footer
		lineageTag: a1f3cb9a-2ec1-5f1c-8be9-c866c69bd8fe

	/// Find your major, footer cell (mart.footnote page find_major).
	measure 'MF note 3' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "awards_2024_provisional", footnote[page_key], "find_major" )
		displayFolder: Shared\Footer
		lineageTag: 1d5a7e53-c1b5-5cf6-8e8e-b55b4375cfdb

	/// Find your major, footer cell (mart.footnote page find_major).
	measure 'MF sources' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "sources_find_major", footnote[page_key], "find_major" )
		displayFolder: Shared\Footer
		lineageTag: 344c8da6-c96b-5d58-8613-0105b2410062

	/// Page title: the major and its level. Ties to 'Accounting (bachelor's)'. The one label over 96 characters (Registered Nursing, … Other (bachelor's), 1,236 px in the 1,232 px box, major sweep) drops its level, which the Showing line always gives.
	measure 'MJ title' =
			VAR lab = SELECTEDVALUE ( dim_major[major_label] )
			RETURN IF ( LEN ( lab ) > 96, SELECTEDVALUE ( dim_major[major_title] ), lab )
		displayFolder: Major page\Header
		lineageTag: 8a8d2169-c86f-576b-9ce2-fe15ac06ec9e

	/// Filter-context line: names the level. Ties to 'Showing: one bachelor's major · NYC colleges · NYC jobs'.
	measure 'MJ showing' = IF ( HASONEVALUE ( dim_major[major_award_key] ), "Showing: one " & LOWER ( SELECTEDVALUE ( dim_major[level_label] ) ) & " major · NYC colleges · NYC jobs" )
		displayFolder: Major page\Header
		lineageTag: 0c8ad823-ae7f-523e-91bc-a2f345ada56e

	measure 'MJ kind' = SELECTEDVALUE ( dim_major[kind_key] )
		isHidden
		displayFolder: Major page\Header
		lineageTag: 56a94b35-5d9f-57f6-8893-19eacf02d2c5

	/// Linked jobs in the study (dim_major.n_degree_jobs). Ties to Accounting (bachelor's) 6.
	measure 'MJ n degree jobs' = SELECTEDVALUE ( dim_major[n_degree_jobs] )
		formatString: 0
		isHidden
		displayFolder: Major page\Header
		lineageTag: 55596679-1167-5665-8ba3-099442c08118

	/// Linked jobs outside the study.
	measure 'MJ n outside jobs' = SELECTEDVALUE ( dim_major[n_outside_jobs] )
		formatString: 0
		isHidden
		displayFolder: Major page\Header
		lineageTag: 0aabcfd8-50ad-5427-9d47-d6bb6a4c3a29

	/// Openings a year in its linked degree-level jobs, NYS DOL 2022-2032 (shared with other majors; equals the jobs table's sum, tests/mart_dim_major_kinds.sql). Ties to Accounting (bachelor's) 9,061.5.
	measure 'MJ degree jobs openings' = SELECTEDVALUE ( dim_major[degree_jobs_openings] )
		formatString: #,0
		displayFolder: Major page\Header
		lineageTag: b439703d-d351-5a60-9747-d4c3dfca350f

	/// The linked degree-level job with the most projected openings (short title). Ties to Accounting (bachelor's) 'Accountants and Auditors'.
	measure 'MJ top job' =
			VAR t =
			    TOPN ( 1,
			        FILTER ( job_major_link, NOT ISBLANK ( RELATED ( dim_job[job_label] ) ) && NOT ISBLANK ( job_major_link[job_openings_nyc] ) ),
			        job_major_link[job_openings_nyc], DESC, job_major_link[soc_code], ASC )
			VAR code = MAXX ( t, job_major_link[soc_code] )
			RETURN IF ( NOT ISBLANK ( code ), LOOKUPVALUE ( job_profile[soc_short_title], job_profile[soc_code], code ) )
		isHidden
		displayFolder: Major page\Header
		lineageTag: ab8e556c-4d0a-51c9-bccf-c38d5d4340ad

	/// Header answer by kind (release-plan §7b; the transfer sentence says what the D2 rule shows, not where students go: there is no transfer data, and 40 of the 149 such majors with graduates are bachelor's). Openings: two significant digits with 'about' (D45). Ties to Accounting (bachelor's) 'It leads to 6 degree-level jobs in NYC, with about 9,100 openings a year among them (projected, shared with other majors). The most are in Accountants and Auditors.'
	measure 'MJ answer' =
			VAR k = [MJ kind]
			VAR n = [MJ n degree jobs]
			VAR o = [MJ degree jobs openings]
			VAR jobs = n & " degree-level job" & IF ( n = 1, "", "s" )
			VAR top_job = [MJ top job]
			VAR lv = IF ( SELECTEDVALUE ( dim_major[award_level] ) = 3, "an associate's", "a bachelor's" )
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ),
			        SWITCH ( k,
			            "degree_jobs", "It leads to " & jobs & " in NYC"
			                & IF ( o > 0, ", with about " & IF ( o < 1, "< 1", IF ( o < 10, FORMAT ( ROUND ( o, 0 ), "0" ), FORMAT ( ROUND ( o, 1 - INT ( LOG10 ( o ) ) ), "#,0" ) ) ) & " openings a year among them (projected, shared with other majors)", "" )
			                & IF ( NOT ISBLANK ( top_job ), ". The most are in " & top_job, "" ) & ".",
			            "outside_jobs", "Most openings in the jobs it leads to are outside this study, named below with the schooling each usually needs to start."
			                & IF ( n > 0, " It also leads to " & jobs & ".", "" ),
			            "dispersed", "Its graduates work across many kinds of jobs, so no one job is its path. The program-to-job list links it to "
			                & IF ( n > 0, jobs & ", below.", "no degree-level job." ),
			            "transfer", "The program-to-job list links it only to jobs that don't usually start with " & lv & " degree and where few workers stop at one, so at this level it leads to no job of its own.",
			            "no_link", "The government's program-to-job list doesn't link it to any job, so this page shows its degrees only." ) )
		displayFolder: Major page\Header
		lineageTag: a77bcc84-fea7-5fea-85c3-351137990b05

	/// The answer under a one-line title (y80). Ties to Accounting (bachelor's), 23 characters: the full answer.
	measure 'MJ answer top' = IF ( LEN ( [MJ title] ) <= 54, [MJ answer] )
		isHidden
		displayFolder: Major page\Header
		lineageTag: 15e9be8d-f20a-5aa8-8a85-ac965b1b2d35

	/// The answer under a title that may wrap (y104). Blank for Accounting (bachelor's).
	measure 'MJ answer low' = IF ( LEN ( [MJ title] ) > 54, [MJ answer] )
		isHidden
		displayFolder: Major page\Header
		lineageTag: 17c87a12-1495-5232-8dec-7c24e1cbc66b

	/// Header as-of line.
	measure 'MJ data line' = "Data: degrees 2019–2024 · projections 2022–2032 · refreshed " & [Refreshed date]
		displayFolder: Major page\Header
		lineageTag: 3f686b19-7cd3-541a-929f-6f56e0e39640

	/// 2024 degrees, all NYC colleges (counted, provisional). Ties to Accounting (bachelor's) 1,630.
	measure 'MJ degrees' = SUM ( major_supply_demand[awards_2024_nyc] )
		formatString: #,0
		isHidden
		displayFolder: Major page\Cards
		lineageTag: 5a85fcf3-abb6-525e-8f3c-1a84e270f8de

	/// Ties to 1,239.
	measure 'MJ degrees CUNY' = SUM ( major_supply_demand[awards_2024_cuny] )
		formatString: #,0
		isHidden
		displayFolder: Major page\Cards
		lineageTag: ec72ce28-71b8-50d6-a297-7e58fa83dded

	/// Ties to 2,557.
	measure 'MJ degrees 2019' = SUM ( major_supply_demand[awards_2019_nyc] )
		formatString: #,0
		isHidden
		displayFolder: Major page\Cards
		lineageTag: 01da8eef-1f58-55ec-9cc7-fcf4706607a9

	measure 'MJ degrees CUNY 2019' = SUM ( major_supply_demand[awards_2019_cuny] )
		formatString: #,0
		isHidden
		displayFolder: Major page\Cards
		lineageTag: bb1735c9-95cc-5753-aa9d-69ae7214140e

	/// Card 1 value: counted, so exact. Ties to '1,630'.
	measure 'MJ card degrees value' = IF ( HASONEVALUE ( dim_major[major_award_key] ), FORMAT ( [MJ degrees], "#,0" ) )
		displayFolder: Major page\Cards
		lineageTag: d772196b-2c6d-5304-b119-3d6cd451ada0

	/// Card 1 line 1: CUNY's part, said as part of the total (M1). Ties to 'Of them, CUNY: 1,239 (76%)'.
	measure 'MJ card degrees ref 1' =
			VAR d = [MJ degrees]
			VAR c = [MJ degrees CUNY]
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( d = 0, "No NYC graduates in 2024", IF ( c = 0, "Of them, CUNY: none", "Of them, CUNY: " & FORMAT ( c, "#,0" ) & " (" & FORMAT ( DIVIDE ( c, d ), "0%" ) & ")" ) ) )
		displayFolder: Major page\Cards
		lineageTag: e9c962df-1b68-59b4-a06b-9e1d58205a39

	/// Card 1 line 2: the change since 2019, NYC and CUNY (the yardstick), in words like the Overview's card 3 (M1). Ties to Accounting (bachelor's) 'Down 36.3% since 2019; CUNY down 32.3%'.
	measure 'MJ card degrees ref 2' =
			VAR d0 = [MJ degrees 2019]
			VAR d1 = [MJ degrees]
			VAR c0 = [MJ degrees CUNY 2019]
			VAR c1 = [MJ degrees CUNY]
			VAR ch = DIVIDE ( d1, d0 ) - 1
			VAR cch = DIVIDE ( c1, c0 ) - 1
			VAR cuny = IF ( c0 > 0, "; CUNY " & IF ( cch < 0, "down ", "up " ) & FORMAT ( ABS ( cch ), "0.0%" ), IF ( c1 > 0, "; CUNY: none in 2019", "" ) )
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( d0 > 0, IF ( ch < 0, "Down ", "Up " ) & FORMAT ( ABS ( ch ), "0.0%" ) & " since 2019" & cuny, "None awarded in 2019" ) )
		displayFolder: Major page\Cards
		lineageTag: 1b8390ff-eecd-5c97-90cd-c4970fab6d7d

	/// The last year of degrees (2024).
	measure 'MJ degrees year' = CALCULATE ( MAX ( major_awards_trend[year] ), REMOVEFILTERS () )
		formatString: 0
		isHidden
		displayFolder: Major page\Right
		lineageTag: 23ae9a0d-8198-5cdd-becc-9d99c65fe999

	/// Degrees in the last year (2024), per college in context.
	measure 'MJ college degrees' =
			VAR y = [MJ degrees year]
			RETURN CALCULATE ( SUM ( major_awards_trend[awards] ), major_awards_trend[year] = y )
		formatString: #,0
		isHidden
		displayFolder: Major page\Right
		lineageTag: 55f9a91b-d50d-58e4-a31b-1643fd60d66a

	/// The CUNY colleges list: 2024 degrees per CUNY college (blank for other colleges and for 0, so they drop out of the list: major_awards_trend keeps a 0 row for 2024 where a college awarded the major only in earlier years; 374 such rows, major sweep).
	measure 'MJ CUNY college degrees' =
			VAR v = CALCULATE ( [MJ college degrees], KEEPFILTERS ( dim_college[is_cuny] = TRUE () ) )
			RETURN IF ( v > 0, v )
		formatString: #,0
		displayFolder: Major page\Right
		lineageTag: 12e0c4ed-ced4-543b-8f50-a74d1c9c41f2

	/// CUNY colleges that awarded the major in 2024. Ties to Accounting (bachelor's) 8.
	measure 'MJ CUNY colleges n' =
			VAR y = [MJ degrees year]
			RETURN CALCULATE ( DISTINCTCOUNT ( major_awards_trend[unitid] ), major_awards_trend[year] = y, major_awards_trend[is_cuny] = TRUE (), major_awards_trend[awards] > 0 ) + 0
		formatString: 0
		isHidden
		displayFolder: Major page\Right
		lineageTag: e2b07068-bb47-5a88-9a71-e0197eb54028

	measure 'MJ other colleges n' =
			VAR y = [MJ degrees year]
			RETURN CALCULATE ( DISTINCTCOUNT ( major_awards_trend[unitid] ), major_awards_trend[year] = y, major_awards_trend[is_cuny] = FALSE (), major_awards_trend[awards] > 0 ) + 0
		formatString: 0
		isHidden
		displayFolder: Major page\Right
		lineageTag: 24bfefbd-bb55-5a5d-916f-96bd815db11d

	measure 'MJ other colleges degrees' =
			VAR y = [MJ degrees year]
			RETURN CALCULATE ( SUM ( major_awards_trend[awards] ), major_awards_trend[year] = y, major_awards_trend[is_cuny] = FALSE () ) + 0
		formatString: #,0
		isHidden
		displayFolder: Major page\Right
		lineageTag: b8c22782-a330-545a-a933-50d6bf31aca5

	/// The CUNY college with the most 2024 degrees, without 'CUNY' in its name.
	measure 'MJ top CUNY college' =
			VAR t = TOPN ( 1, FILTER ( VALUES ( dim_college[college_name] ), [MJ CUNY college degrees] > 0 ), [MJ CUNY college degrees], DESC, dim_college[college_name], ASC )
			RETURN SUBSTITUTE ( TRIM ( SUBSTITUTE ( SUBSTITUTE ( MAXX ( t, dim_college[college_name] ), "CUNY ", "" ), " CUNY", "" ) ), "Bernard M Baruch College", "Baruch College" )
		isHidden
		displayFolder: Major page\Right
		lineageTag: 3ef9687b-7ab9-5883-9d84-4d1cfb113a72

	/// The major's CIP 2020 code, for card 2's label (M2). Ties to 52.0301.
	measure 'MJ cip code' = SELECTEDVALUE ( dim_major[cip_code] )
		isHidden
		displayFolder: Major page\Cards
		lineageTag: 45707355-3c82-5d03-bb01-1d2ca3c43540

	/// Card 2 value: CUNY colleges that awarded it in 2024. Ties to '8'.
	measure 'MJ card colleges value' =
			VAR n = [MJ CUNY colleges n]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( n = 0, "None", FORMAT ( n, "0" ) ) )
		displayFolder: Major page\Cards
		lineageTag: 15ac8fab-fd3c-5900-8db9-5bd1d3d0eef3

	/// Card 2 line 1: the CUNY college with the most 2024 degrees.
	measure 'MJ card colleges ref 1' =
			VAR t = TOPN ( 1, FILTER ( VALUES ( dim_college[college_name] ), [MJ CUNY college degrees] > 0 ), [MJ CUNY college degrees], DESC, dim_college[college_name], ASC )
			VAR v = MAXX ( t, [MJ CUNY college degrees] )
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( [MJ CUNY colleges n] = 0, "No CUNY college awarded it in 2024", "Most: " & [MJ top CUNY college] & ", " & FORMAT ( v, "#,0" ) ) )
		displayFolder: Major page\Cards
		lineageTag: c67d5bd6-8ad6-5b03-b120-b8349e0185ed

	/// Card 2 line 2: the rest of NYC, the yardstick.
	measure 'MJ card colleges ref 2' =
			VAR n = [MJ other colleges n]
			VAR d = [MJ other colleges degrees]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( n = 0, "No other NYC college awarded it", n & IF ( n = 1, " other NYC college: ", " other NYC colleges: " ) & FORMAT ( d, "#,0" ) & IF ( d = 1, " degree", " degrees" ) ) )
		displayFolder: Major page\Cards
		lineageTag: 30052bbc-4bb4-5bdc-9b63-602e974197d4

	/// Card 3 value: degree-level jobs it leads to; '–' when the list links it to no job (transfer, no link).
	measure 'MJ card jobs value' =
			VAR k = [MJ kind]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( k IN { "transfer", "no_link" }, "–", FORMAT ( [MJ n degree jobs], "0" ) ) )
		displayFolder: Major page\Cards
		lineageTag: 675423d4-81ab-53f3-a36a-0bd5d817fecf

	/// Card 3 line 1: openings a year in those jobs (projection, 'about', two significant digits), or why there are none.
	measure 'MJ card jobs ref 1' =
			VAR k = [MJ kind]
			VAR n = [MJ n degree jobs]
			VAR o = [MJ degree jobs openings]
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ),
			        IF ( n > 0,
			            IF ( o > 0, "About " & IF ( o < 1, "< 1", IF ( o < 10, FORMAT ( ROUND ( o, 0 ), "0" ), FORMAT ( ROUND ( o, 1 - INT ( LOG10 ( o ) ) ), "#,0" ) ) ) & " openings a year, shared (projected)", "No NYC projection for these jobs" ),
			            SWITCH ( k,
			                "outside_jobs", "Its " & [MJ n outside jobs] & " linked job" & IF ( [MJ n outside jobs] = 1, " is", "s are" ) & " outside the study",
			                "dispersed", "Its graduates work across many jobs",
			                "transfer", "No job of its own at this level",
			                "no_link", "No job link in the government's list" ) ) )
		displayFolder: Major page\Cards
		lineageTag: 21d84f23-87e1-5d12-a219-7cc9be7f9c44

	/// Card 3 line 2: where most openings are.
	measure 'MJ card jobs ref 2' =
			VAR k = [MJ kind]
			VAR n = [MJ n degree jobs]
			VAR top_job = [MJ top job]
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ),
			        SWITCH ( TRUE (),
			            k = "outside_jobs", "Most of its jobs' openings are outside the study",
			            n > 0 && k = "dispersed", "Its graduates work across many jobs",
			            n > 0 && NOT ISBLANK ( top_job ), "Most openings: " & top_job ) )
		displayFolder: Major page\Cards
		lineageTag: 601bfd99-19f0-5194-bcee-35aa479928a5

	/// Card frame of the Major page: the job page's card at 400 x 96.
	measure 'MJ card svg head' = "<svg xmlns='http://www.w3.org/2000/svg' width='400' height='96' viewBox='0 0 400 96'><style>text{font-family:Inter,'Segoe UI',sans-serif;font-size:10.67px;fill:#5B6470}.v{font-family:Bahnschrift,'Segoe UI',sans-serif;font-size:26.67px;font-weight:600;fill:#1F2328}.s{font-family:'Segoe UI Symbol','Segoe UI',sans-serif;font-size:8.53px}</style><rect width='400' height='96' rx='8' fill='#FFFFFF'/>"
		isHidden
		displayFolder: Major page\Cards\Card parts
		lineageTag: 2378a5d5-7a8a-56f2-8cdf-4f1427845d3f

	/// Major card 1 (SVG): 2024 degrees at NYC colleges, CUNY's part, the change since 2019.
	measure 'MJ card degrees' =
			VAR body =
			    [MJ card svg head]
			        & "<text x='16' y='22'>Degrees awarded, all NYC colleges, 2024 (provisional)</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card degrees value], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card degrees ref 1], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card degrees ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Major page\Cards
		lineageTag: e1054914-431b-5ce2-a317-4d62d74f1435

	/// Screen-reader text for MJ card degrees.
	measure 'MJ card degrees alt' =
			VAR r2 = [MJ card degrees ref 2]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), "Degrees awarded, all NYC colleges, 2024 (provisional): " & [MJ card degrees value] & ". " & [MJ card degrees ref 1] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Major page\Cards\Alt text
		lineageTag: 4e7dbca1-e93b-51e4-be15-a2ec26eda089

	/// Major card 2 (SVG): CUNY colleges that awarded it, the one with the most, the rest of NYC.
	measure 'MJ card colleges' =
			VAR body =
			    [MJ card svg head]
			        & "<text x='16' y='22'>CUNY colleges with degrees under program code " & [MJ cip code] & ", 2024</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card colleges value], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card colleges ref 1], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card colleges ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Major page\Cards
		lineageTag: 0e8c7860-1078-57ff-8710-b7f4ab310c54

	/// Screen-reader text for MJ card colleges.
	measure 'MJ card colleges alt' =
			VAR r2 = [MJ card colleges ref 2]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), "CUNY colleges with degrees under program code " & [MJ cip code] & ", 2024: " & [MJ card colleges value] & ". " & [MJ card colleges ref 1] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Major page\Cards\Alt text
		lineageTag: a75644ba-572d-59c4-90ad-7482fcb36648

	/// Major card 3 (SVG): linked jobs in the study, their openings a year (shared), where most openings are.
	measure 'MJ card jobs' =
			VAR body =
			    [MJ card svg head]
			        & "<text x='16' y='22'>Degree-level jobs it leads to, NYC</text>"
			        & "<text class='v' x='16' y='50'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card jobs value], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ) & "</text>"
			        & "<text x='16' y='70'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card jobs ref 1], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text>"
			        & "<text x='16' y='84'>" & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( [MJ card jobs ref 2], "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "▲", "<tspan class='s'>▲</tspan>" ), "▼", "<tspan class='s'>▼</tspan>" ) & "</text></svg>"
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ), "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( body, "%", "%25" ), "#", "%23" ) )
		displayFolder: Major page\Cards
		lineageTag: 0402f759-d6b2-5773-be9d-4baf75d0c619

	/// Screen-reader text for MJ card jobs.
	measure 'MJ card jobs alt' =
			VAR r2 = [MJ card jobs ref 2]
			RETURN IF ( HASONEVALUE ( dim_major[major_award_key] ), "Degree-level jobs it leads to, NYC: " & [MJ card jobs value] & ". " & [MJ card jobs ref 1] & IF ( NOT ISBLANK ( r2 ), ". " & r2 ) & "." )
		isHidden
		displayFolder: Major page\Cards\Alt text
		lineageTag: 7831cb7b-7896-5b1a-8609-67da7eabaf01

	/// TRUE on a dim_job row the major links to (job_major_link holds the pair) that is one of the 225 (labeled).
	measure 'MJ linked' = NOT ISEMPTY ( job_major_link ) && NOT ISBLANK ( SELECTEDVALUE ( dim_job[job_label] ) )
		isHidden
		displayFolder: Major page\Jobs
		lineageTag: 5f8f4f6b-4b01-5483-9b9e-d58e86802c48

	/// Row name: the job's short title. Blank where the major doesn't link to the job, so the row drops out.
	measure 'MJ job name' = IF ( [MJ linked], [Job name] )
		displayFolder: Major page\Jobs
		lineageTag: 6d7fc172-db92-584b-b56c-80abe437ad64

	/// BLS typical work experience, as on the A-Z finder (with the long training, Z3). Blank where the major doesn't link to the job, so the row drops out.
	measure 'MJ job experience' = IF ( [MJ linked], [Job experience asked full] )
		displayFolder: Major page\Jobs
		lineageTag: 5b3690bb-dfbc-5b6f-8617-30931bc15188

	/// BLS AI exposure tier, as on the A-Z finder. Blank where the major doesn't link to the job, so the row drops out.
	measure 'MJ job AI' = IF ( [MJ linked], [Job BLS AI tier] )
		displayFolder: Major page\Jobs
		lineageTag: 5f8bd860-94c1-569b-aa4d-f6db8bef1f14

	/// Openings a year, two significant digits, 'our estimate' in words (as on the A-Z finder). Blank where the major doesn't link to the job, so the row drops out.
	measure 'MJ job openings' = IF ( [MJ linked], [AZ openings text] )
		displayFolder: Major page\Jobs
		lineageTag: fb3a610a-6110-5b0f-a0dd-1d86effeff5b

	/// NYS DOL entry wage, NYC 2025, as on the A-Z finder. Blank where the major doesn't link to the job, so the row drops out.
	measure 'MJ job pay' = IF ( [MJ linked], [Job starting pay value] )
		displayFolder: Major page\Jobs
		lineageTag: c6caf0ad-c493-5b2c-b447-507bab77123c

	/// The jobs table's order (most openings first; jobs with no projection last).
	measure 'MJ job openings sort' = IF ( [MJ linked], [Job openings] )
		formatString: #,0
		isHidden
		displayFolder: Major page\Jobs
		lineageTag: e4930483-c5bf-587b-92dd-28dc5f76acb4

	/// Under the jobs title when the list has rows (D60: drawn as 'MJ jobs hint' + 'MJ jobs note'; kept for the tie-out).
	measure 'MJ jobs subtitle' = IF ( HASONEVALUE ( dim_major[major_award_key] ) && [MJ n degree jobs] > 0, "Click a job, then open its page · openings a year are projected for 2022–2032 and shared with other majors" )
		displayFolder: Major page\Jobs
		lineageTag: cb88bd96-6cf7-5dbc-bdc7-c40b648bb887

	/// D60 (5): the how-to hint under the jobs title (dark, after a gold tick), when the list has rows.
	measure 'MJ jobs hint' = IF ( HASONEVALUE ( dim_major[major_award_key] ) && [MJ n degree jobs] > 0, "Click a job, then open its page" )
		displayFolder: Major page\Jobs
		lineageTag: 6bf0a94f-4dcc-525e-b1ab-343831cc30bb

	/// The note after the hint, in label gray.
	measure 'MJ jobs note' = IF ( HASONEVALUE ( dim_major[major_award_key] ) && [MJ n degree jobs] > 0, "· openings a year are projected for 2022–2032 and shared with other majors" )
		displayFolder: Major page\Jobs
		lineageTag: b7521f32-2cb7-5c00-bb7a-85b83fc27844

	/// D60: the hint's gold tick; white (hidden) when the list is empty.
	measure 'MJ jobs hint tick' = IF ( HASONEVALUE ( dim_major[major_award_key] ) && [MJ n degree jobs] > 0, "#FFB81C", "#FFFFFF" )
		isHidden
		displayFolder: Major page\Jobs
		lineageTag: 6cadf52f-a2f5-5208-8b4c-69ab0620a5ff

	/// The jobs list's empty state, by kind.
	measure 'MJ jobs empty' =
			IF ( HASONEVALUE ( dim_major[major_award_key] ) && [MJ n degree jobs] = 0,
			    SWITCH ( [MJ kind],
			        "transfer", "None at this level: few workers in the jobs it is linked to stop at this degree.",
			        "no_link", "None: the program-to-job list links it to no job.",
			        "outside_jobs", "None of the jobs it leads to is in this study; they're named below.",
			        "dispersed", "The program-to-job list links it to no degree-level job." ) )
		displayFolder: Major page\Jobs
		lineageTag: 6a949c9e-2f32-5d28-a66b-2b059726300d

	/// The major's linked jobs outside the 225, the five with the most openings, named with BLS's typical entry education; no drill (study-frame-brainstorm §4 point 1). (M7: 'Also linked, outside the study' was unclear in review): says who links them and why they're outside (every job outside the 225 starts below an associate's or at a graduate degree).
	measure 'MJ outside line' =
			VAR outside_rows = FILTER ( job_major_link, ISBLANK ( RELATED ( dim_job[job_label] ) ) )
			VAR n = COUNTROWS ( outside_rows )
			VAR top5 = TOPN ( 5, outside_rows, job_major_link[job_openings_nyc], DESC, job_major_link[soc_code], ASC )
			VAR names =
			    CONCATENATEX ( top5,
			        RELATED ( dim_job[soc_short_title] )
			            & SWITCH ( RELATED ( dim_job[entry_education_rank] ), 1, " (no credential)", 2, " (high school)", 3, " (some college)",
			                       4, " (certificate)", 7, " (master's)", 8, " (doctorate or professional degree)", "" ),
			        "; ", job_major_link[job_openings_nyc], DESC, job_major_link[soc_code], ASC )
			RETURN
			    IF ( HASONEVALUE ( dim_major[major_award_key] ) && n > 0,
			        "The program-to-job list also links it to jobs outside this study, which usually start with less schooling or with a graduate degree: " & names
			            & IF ( n > 5, "; and " & ( n - 5 ) & " more", "" ) & "." )
		displayFolder: Major page\Jobs
		lineageTag: 0606569c-7272-5be9-87fd-2eab907973b3

	measure 'MJ jobs alt' = "Table of the degree-level jobs this major leads to in NYC, most openings first, with experience asked, AI exposure (BLS), openings a year and entry wage. " & [MJ answer]
		isHidden
		displayFolder: Major page\Jobs
		lineageTag: 53448074-b8a2-5c3f-934d-8c8a6247c9b4

	/// CUNY colleges list, row name without 'CUNY'.
	measure 'MJ college name' = IF ( NOT ISBLANK ( [MJ CUNY college degrees] ), SUBSTITUTE ( TRIM ( SUBSTITUTE ( SUBSTITUTE ( SELECTEDVALUE ( dim_college[college_name] ), "CUNY ", "" ), " CUNY", "" ) ), "Bernard M Baruch College", "Baruch College" ) )
		displayFolder: Major page\Right
		lineageTag: 0675f717-d05e-55fa-9e7a-cb9c6af40d7a

	/// Subtitle (or the empty state) of the CUNY colleges list.
	measure 'MJ colleges sub' = IF ( HASONEVALUE ( dim_major[major_award_key] ), IF ( [MJ CUNY colleges n] > 0, "CUNY colleges, degrees awarded in 2024", "No CUNY college awarded it in 2024." ) )
		displayFolder: Major page\Right
		lineageTag: 4b00ffee-d01a-541a-a14e-7e2f37f67b78

	/// (stage 3, M6: 'let the CUNY colleges part expand'): the list now shows every CUNY college (it scrolls past six) and each row opens a hover card (college_card); this how-to hint (gold tick, D60 (5)) says so. Ties to Accounting (bachelor's) 'Hover a college for its degrees since 2019 · scroll for 2 more'.
	measure 'MJ colleges more' =
			VAR n = [MJ CUNY colleges n]
			RETURN IF ( n > 0, "Hover a college for its degrees since 2019" & IF ( n > 6, " · scroll for " & ( n - 6 ) & " more", "" ) )
		displayFolder: Major page\Right
		lineageTag: 2b65a9b4-8923-5eb5-810e-164ae251df65

	/// The hint's tick: gold when the list has rows.
	measure 'MJ colleges hint tick' = IF ( [MJ CUNY colleges n] > 0, "#FFB81C", "#FFFFFF" )
		isHidden
		displayFolder: Major page\Right
		lineageTag: 23802351-55da-555f-8919-b1798760a11a

	/// College card line 1: the college's 2024 degrees in the major and its share of CUNY's (major_supply_demand has no college key, so the total ignores the hovered college). Ties to Baruch, Accounting (bachelor's) '2024: 513 degrees, 41% of CUNY's'.
	measure 'CC 2024' =
			VAR v = [MJ CUNY college degrees]
			VAR t = [MJ degrees CUNY]
			RETURN IF ( NOT ISBLANK ( v ), "2024: " & FORMAT ( v, "#,0" ) & IF ( v = 1, " degree", " degrees" ) & ", " & FORMAT ( DIVIDE ( v, t ), "0%" ) & " of CUNY's" )
		displayFolder: Major page\College card
		lineageTag: cdf87ee7-fd24-52d0-ac0b-650bb48aa654

	/// College card line 2: the same college's 2019 degrees and the change (the card's yardstick).
	measure 'CC 2019' =
			VAR v1 = [MJ CUNY college degrees]
			VAR v0 = CALCULATE ( SUM ( major_awards_trend[awards] ), major_awards_trend[year] = 2019, KEEPFILTERS ( dim_college[is_cuny] = TRUE () ) )
			RETURN
			    IF ( NOT ISBLANK ( v1 ),
			        IF ( v0 > 0, "2019: " & FORMAT ( v0, "#,0" ) & " · " & IF ( v1 < v0, "down ", "up " ) & FORMAT ( ABS ( DIVIDE ( v1, v0 ) - 1 ), "0%" ) & " since",
			            "2019: none under this code" ) )
		displayFolder: Major page\College card
		lineageTag: ef2f7671-518a-56a6-a7fc-9e97fcdb4c77

	/// College card line 3: what is counted.
	measure 'CC note' = IF ( NOT ISBLANK ( [MJ CUNY college degrees] ), "First majors, program code " & [MJ cip code] )
		displayFolder: Major page\College card
		lineageTag: 83ee03f6-2621-5ebc-a9f9-afa5f2a0a913

	/// Degrees a year, all NYC colleges, 2019 on (the line chart).
	measure 'MJ degrees by year' =
			VAR y = SELECTEDVALUE ( major_awards_trend[year] )
			RETURN IF ( y >= 2019, SUM ( major_awards_trend[awards] ) + 0 )
		formatString: #,0
		displayFolder: Major page\Right
		lineageTag: 77597158-14d7-54f0-b7bf-23b7498f3545

	/// Same, CUNY colleges.
	measure 'MJ degrees by year CUNY' =
			VAR y = SELECTEDVALUE ( major_awards_trend[year] )
			RETURN IF ( y >= 2019, CALCULATE ( SUM ( major_awards_trend[awards] ), major_awards_trend[is_cuny] = TRUE () ) + 0 )
		formatString: #,0
		displayFolder: Major page\Right
		lineageTag: 3d2058b1-ece4-5a90-9431-0825b53b4e91

	measure 'MJ trend alt' = "Line chart of the degrees awarded in this major each year, 2019 to 2024, all NYC colleges and CUNY. " & [MJ card degrees ref 2]
		isHidden
		displayFolder: Major page\Right
		lineageTag: 56341163-e107-5671-947f-bd18602330ed

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ note 1' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "major_job_link", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: 47c30142-8084-52ec-9a4b-3b03d0590675

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ note 2' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "long_training", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: 797727ad-9585-5313-b87d-0aff1aa7df1d

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ note 3' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "major_openings_shared", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: 367b7831-fa06-5220-a70f-98d067606a54

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ note 4' = "“Our estimate”: " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "imputed_projection", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: ebb31987-3314-5c30-a22a-8004dd5f444a

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ note 5' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "awards_2024_provisional", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: 3eb9fc10-c722-591d-b6cf-61a41cdef560

	/// Major page, footer cell (mart.footnote page major).
	measure 'MJ sources' = LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "sources_major", footnote[page_key], "major" )
		displayFolder: Shared\Footer
		lineageTag: ee4a49db-5938-5ccd-a6a5-34f93996ed70

	/// Notes table, Page column: the built pages a note appears on, in story order (the table groups by subject and text).
	measure 'Note pages' = CONCATENATEX ( VALUES ( footnote[page_name] ), footnote[page_name], ", ", CALCULATE ( MIN ( footnote[page_order] ) ), ASC )
		displayFolder: Notes
		lineageTag: 3612995c-2ce2-56a7-ab62-07d6c4903c53

	/// Notes table row order: the seed's order (ref_footnote.sort_order), as the approved notes.html.
	measure 'Note sort' = MIN ( footnote[sort_order] )
		formatString: 0
		isHidden
		displayFolder: Notes
		lineageTag: 695ae78a-48b5-5af2-92ac-2599ac9468a6

	/// D60: the gold tick image for 'Hint tick job' (3 x 11; white or 'none' hides it).
	measure 'Hint tick job svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [Hint tick job], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Shared
		lineageTag: 7b6708ed-d291-5aa0-8537-7867ad53c341

	/// D60: the gold tick image for 'Hint tick major' (3 x 11; white or 'none' hides it).
	measure 'Hint tick major svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [Hint tick major], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Shared
		lineageTag: 4af8627a-02c3-59f8-b548-7514718eb461

	/// D60: the gold tick image for 'People chart hint tick' (3 x 11; white or 'none' hides it).
	measure 'People chart hint tick svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [People chart hint tick], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 214b28f5-1a90-5250-821b-b3222ba02e9c

	/// D60: the gold tick image for 'Pay chart hint tick' (3 x 11; white or 'none' hides it).
	measure 'Pay chart hint tick svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [Pay chart hint tick], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Job page\How it changed
		lineageTag: 47dee75f-178b-5d94-a268-ef20cce41cdd

	/// D60: the gold tick image for 'MJ jobs hint tick' (3 x 11; white or 'none' hides it).
	measure 'MJ jobs hint tick svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [MJ jobs hint tick], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Major page\Jobs
		lineageTag: c8093619-9a68-5247-a037-5ef394f89587

	/// D60: the gold tick image for 'MJ colleges hint tick' (3 x 11; white or 'none' hides it).
	measure 'MJ colleges hint tick svg' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='3' height='11' viewBox='0 0 3 11'><rect width='3' height='11' fill='"
			    & SUBSTITUTE ( [MJ colleges hint tick], "#", "%23" ) & "'/></svg>"
		isHidden
		displayFolder: Major page\Right
		lineageTag: 7efcaa46-133e-5504-84c2-d0fca8cbaf16

	column refreshed_at
		dataType: dateTime
		isHidden
		formatString: General Date
		lineageTag: 07bddec7-da41-52cf-b678-a11f21d83d59
		summarizeBy: none
		isNameInferred
		sourceColumn: [refreshed_at]

		annotation SummarizationSetBy = User

	partition _Measures = calculated
		mode: import
		source = ROW ( "refreshed_at", NOW () )
