	measure 'Finding badge 4' = "data:image/svg+xml;utf8," & SUBSTITUTE ( "<svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 20 20'><circle cx='10' cy='10' r='9.25' fill='none' stroke='#1D3A83' stroke-width='1.5'/><text x='10' y='13' text-anchor='middle' style=""font-family:Inter,'Segoe UI',sans-serif;font-weight:600;font-size:10.67px"" fill='#1D3A83'>4</text></svg>", "#", "%23" )
		isHidden
