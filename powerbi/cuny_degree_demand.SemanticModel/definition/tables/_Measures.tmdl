	/// Readout slot 2 when the NYC line is not drawn: D36 (an estimate under 1,000 people in 2019 or 2025: 80 jobs) or no NYC estimate with a 2019 base.
	measure 'Readout NYC note' =
			IF ( NOT [Job has NYC line] && [Job has metro line],
			    IF ( [Job has NYC series], "NYC: too few to estimate", "NYC: no estimate" ) )
		displayFolder: Job page\How it changed
