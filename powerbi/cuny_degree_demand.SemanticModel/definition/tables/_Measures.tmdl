	/// The same, in the band row's context.
	measure 'GI wage jobs' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( [GI wage jobs n], TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), [GI wage jobs n] )
		formatString: #,0
		isHidden
