	/// Jobs behind an entry wage averaged over openings: a wage and openings (not banded).
	measure 'GI wage jobs n' = COUNTROWS ( FILTER ( job_profile, NOT ISBLANK ( job_profile[entry_wage] ) && job_profile[annual_openings_avg] > 0 ) )
