			VAR n = [Job is filled] + 2
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), IF ( 3 <= n, (
			VAR f = [Job is filled]
			VAR nyc = IF ( [Job has NYC line], 1, 0 )
			RETURN
			    SWITCH ( TRUE (),
			        f = 1 && 3 = 1, "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "imputed_projection", footnote[page_key], "job" ),
			        3 = f + 1, [Job mark pay] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "entry_wage_definition", footnote[page_key], "job" ),
			        3 = f + 2, [Job mark AI] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "ai_exposure_observed", footnote[page_key], "job" ),
			        nyc = 1 && 3 = f + 3, [Job mark NYC] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "nyc_jobs_estimate", footnote[page_key], "job" ),
			        SELECTEDVALUE ( job_profile[routes_status] ) = "listed" && 3 = f + 3 + nyc, [Job mark routes] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "escape_route", footnote[page_key], "job" ) ) ), IF ( 3 = n + 1, [Job sources details] ) ) )
		displayFolder: Job page\Footer
		lineageTag: 44cb1f9e-dbc6-5205-aac6-c7228264b80f

	/// Details footer slot 4: the first notes of the same list (our estimate, starting pay, AI), then sources.
	measure 'Job foot D4' =
			VAR n = [Job is filled] + 2
			RETURN IF ( HASONEVALUE ( job_profile[soc_code] ), IF ( 4 <= n, (
			VAR f = [Job is filled]
			VAR nyc = IF ( [Job has NYC line], 1, 0 )
			RETURN
			    SWITCH ( TRUE (),
			        f = 1 && 4 = 1, "¹ " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "imputed_projection", footnote[page_key], "job" ),
			        4 = f + 1, [Job mark pay] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "entry_wage_definition", footnote[page_key], "job" ),
			        4 = f + 2, [Job mark AI] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "ai_exposure_observed", footnote[page_key], "job" ),
			        nyc = 1 && 4 = f + 3, [Job mark NYC] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "nyc_jobs_estimate", footnote[page_key], "job" ),
			        SELECTEDVALUE ( job_profile[routes_status] ) = "listed" && 4 = f + 3 + nyc, [Job mark routes] & " " & LOOKUPVALUE ( footnote[short_text], footnote[footnote_key], "escape_route", footnote[page_key], "job" ) ) ), IF ( 4 = n + 1, [Job sources details] ) ) )
		displayFolder: Job page\Footer
		lineageTag: f5285e26-5ec7-5ce5-a645-e05f541085ad

	/// Openings a year 2022-2032 in the band, every job_profile row ('All other' included, as the 136,787 total). Ties to 94,103 / 22,403 / 20,281.
	measure 'GI openings' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( SUM ( job_profile[annual_openings_avg] ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), SUM ( job_profile[annual_openings_avg] ) )
		formatString: #,0
		displayFolder: Getting in\Experience
		lineageTag: b44cadc6-732a-572e-a520-a69d01d7fd52

	/// Openings a year under the slicers, every band (the disconnected band table doesn't filter job_profile). Ties to 136,787.
	measure 'GI openings total' = SUM ( job_profile[annual_openings_avg] )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: 512a7196-e3d9-5fc8-a219-fcfdc2c4b670

	/// V1 accent bars: the band's share of openings (0 when the band has none, so the row keeps its label). Ties to 0.688 / 0.164 / 0.148; associate's 0.982 / 0.018 / 0.
	measure 'GI openings share' =
			VAR t = [GI openings total]
			RETURN IF ( t > 0, DIVIDE ( COALESCE ( [GI openings], 0 ), t ) )
		formatString: 0%
		displayFolder: Getting in\Experience
		lineageTag: c4e81117-aa71-5ed4-99b9-447091fc973d

	/// NYC jobs added 2019 -> 2025 (estimate) in the band; nyc_change is null unless the job has both years, so this is the D37 base. Ties to +91,690 / +28,710 / +83,910.
	measure 'GI added' = IF ( HASONEVALUE ( 'Experience band'[band_key] ) && SELECTEDVALUE ( 'Experience band'[band_key] ) <> "all", CALCULATE ( SUM ( job_profile[nyc_change_2019_2025] ), TREATAS ( VALUES ( 'Experience band'[band_key] ), job_profile[bls_experience_band] ) ), SUM ( job_profile[nyc_change_2019_2025] ) )
		formatString: +#,0;−#,0
		displayFolder: Getting in\Experience
		lineageTag: a941e430-f850-529b-8bc4-12068b8a9488

	/// Jobs added under the slicers, every band (D37 base). Ties to +204,310; associate's -174.
	measure 'GI added total' = SUM ( job_profile[nyc_change_2019_2025] )
		formatString: +#,0;−#,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: 36afd81c-661d-562a-88fb-7e5bacff9729

	measure 'GI added none' = CALCULATE ( SUM ( job_profile[nyc_change_2019_2025] ), job_profile[bls_experience_band] = "none" )
		formatString: #,0
		isHidden
		displayFolder: Getting in\Experience
		lineageTag: 4238bfe8-587a-5dc2-8e30-98434ee29596

	measure 'GI added under5' = CALCULATE ( SUM ( job_profile[nyc_change_2019_2025] ), job_profile[bls_experience_band] = "under_5_years" )
		formatString: #,0
