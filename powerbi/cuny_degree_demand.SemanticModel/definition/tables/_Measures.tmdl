	/// Summary, under the 4 rows (41 named jobs have more).
	measure 'Majors more line' =
			VAR n = CALCULATE ( COUNTROWS ( job_major_link ), job_major_link[awards_2024_nyc] > 0 )
			RETURN IF ( n > 4, "+ " & ( n - 4 ) & " more on Details" )
		displayFolder: Job page\Paths
		lineageTag: 8b53a62c-0b4f-5645-9c0a-f2cca0199f23

	/// The sentence for job_profile.majors_split_key (plan §11.1, D33). The split count is ours and built from projections, so it says 'we count about' at two significant digits (D46 item 6), from the raw graduates_2024_linked (majors_split_n is already rounded to three digits: 1,150 would round again to 1,200) and majors_split_n_cuny (whole under 1,000; the three CUNY counts over 1,000 round the same either way). Ties to 'Their graduates also go into other jobs, so we count about 1,100 of them (about 860 from CUNY) toward this one.' (1,145.7; 856). 'Their' (the majors listed above) instead of the mockup's 'Graduates of these majors': 669 px instead of 731, so it stays on the two lines of the 368 px box.
	measure 'Majors split sentence' =
			VAR raw = SELECTEDVALUE ( job_profile[graduates_2024_linked] )
			VAR k0 = SELECTEDVALUE ( job_profile[majors_split_key] )
			VAR k = IF ( k0 = "split" && raw < 1, "under_one", k0 )
			VAR n = SELECTEDVALUE ( job_profile[majors_split_n] )
			VAR nt = FORMAT ( n, "#,0" )
			VAR c = SELECTEDVALUE ( job_profile[majors_split_n_cuny] )
			VAR about_n = "about " & IF ( raw < 1, "< 1", IF ( raw < 10, FORMAT ( ROUND ( raw, 0 ), "0" ), FORMAT ( ROUND ( raw, 1 - INT ( LOG10 ( raw ) ) ), "#,0" ) ) )
			VAR cuny = IF ( c > 0, "about " & IF ( c < 1, "< 1", IF ( c < 10, FORMAT ( ROUND ( c, 0 ), "0" ), FORMAT ( ROUND ( c, 1 - INT ( LOG10 ( c ) ) ), "#,0" ) ) ) & " from CUNY", "none from CUNY" )
			RETURN
			    SWITCH ( k,
			        "split", "Their graduates also go into other jobs, so we count " & about_n & " of them (" & cuny & ") toward this one.",
			        "all_count", "We count all of them toward this job: " & about_n & " (" & cuny & ").",
			        "under_one", "Graduates of these majors also go into other jobs, so fewer than 1 of them counts toward this one.",
			        "none_counted", "Graduates of these majors are split by openings, and this job has no NYC openings figure, so none count toward it.",
			        "all_dispersed", "Graduates of these majors work in many fields, so none are counted per opening.",
			        "no_graduates_2024", IF ( n = 1, "Its one linked major had no NYC graduates in 2024.", "None of its " & nt & " linked majors had NYC graduates in 2024." ),
			        "no_major", "No major is linked to this job (NCES program-to-job list)."
			    )
		displayFolder: Job page\Paths
		lineageTag: edeccb72-e677-543b-b75e-c51699abe2a5

	/// Details: explains ✦ when a listed major is dispersed (D20). Ties to 13-2011 (Financial Forensics and Fraud Investigation).
	measure 'Majors dispersed line' =
			IF ( CALCULATE ( COUNTROWS ( job_major_link ), job_major_link[awards_2024_nyc] > 0, job_major_link[counts_as_supply] = FALSE () ) > 0,
			    "✦ Its graduates spread over many fields, so none count here." )
		displayFolder: Job page\Paths
		lineageTag: e9a2f3be-1c81-578c-9f90-7c60da9237ce

	/// Details, under the rows: linked majors with no 2024 graduates (with no rows, 'Majors empty' speaks). Ties to '4 more linked majors had no NYC graduates in 2024.'
	measure 'Majors zero line' =
			VAR listed = [Majors listed]
			VAR zero = COUNTROWS ( job_major_link ) - listed
			RETURN
			    IF ( HASONEVALUE ( job_profile[soc_code] ) && listed > 0 && zero > 0, zero & " more linked major" & IF ( zero > 1, "s" ) & " had no NYC graduates in 2024." )
		displayFolder: Job page\Paths
		lineageTag: 714ebef9-28b7-5357-a0f5-4d87523e0491

	/// Similar-jobs block title; its footnote mark only when routes are listed (D35); blank (block hidden) when the job has no AI band.
	measure 'Routes title' =
			VAR st = SELECTEDVALUE ( job_profile[routes_status] )
			VAR mk = [Job mark routes]
			RETURN IF ( NOT ISBLANK ( st ) && st <> "no_ai_band", "Similar jobs with less AI use seen today" & IF ( NOT ISBLANK ( mk ), " " & mk ) )
		displayFolder: Job page\Paths
		lineageTag: 38bfe56b-f215-5d13-84c5-822cac682d5e

	/// The sentence for job_profile.routes_status (plan §11.1, D33): the subtitle when routes are listed, else the block's only line.
	measure 'Routes line' =
			SWITCH ( SELECTEDVALUE ( job_profile[routes_status] ),
			    "listed", "They use similar skills and pay at least 90% as much; AI use is seen in fewer of their tasks (this job: "
			        & FORMAT ( SELECTEDVALUE ( job_profile[ai_observed_exposure] ), "0.0%" ) & ").",
			    "none_qualify", "No similar job with less AI use seen pays at least 90% as much.",
			    "no_skill_ratings", "Not compared: O*NET has no skill ratings for this job yet.",
			    "no_nyc_wage", "Not compared: no NYC wage is published for this job.",
			    "not_high", "Shown when AI use seen is High; for this job it is " & SELECTEDVALUE ( job_profile[ai_band] ) & "."
			)
		displayFolder: Job page\Paths
		lineageTag: 3877f25a-5d9e-55eb-8e15-8b1133cbbef6

	/// Route row: 'Financial Examiners →' (hover for the route card, D31).
	measure 'Route name' =
			VAR t = SELECTEDVALUE ( job_escape_route[destination_title] )
			RETURN IF ( NOT ISBLANK ( t ), t & " →" )
		displayFolder: Job page\Paths
		lineageTag: bf708f30-c90d-53e4-9f80-0642a0aaa319

	/// Route row, right: pay against this job (job_escape_route.pay_words). Ties to 'pays 25% more', 'pays 9% less', 'pays 50% more'.
	measure 'Route pay words' = SELECTEDVALUE ( job_escape_route[pay_words] )
		displayFolder: Job page\Paths
		lineageTag: 295e5952-c4d8-52fc-bce8-910b4a2040ca

	/// Row order of the routes.
	measure 'Route rank' = MIN ( job_escape_route[route_rank] )
		formatString: 0
		isHidden
		displayFolder: Job page\Paths
		lineageTag: 5a44fd12-d213-5322-8a24-ae7dadadecef

	/// Similar-jobs rows (readability check saw 'less AI use' beside BLS 'Very high' as a contradiction): each job's AI use seen (D7, share of its tasks), so the two AI measures read apart. Ties to 13-2011's Financial Examiners 'AI use 4.3%' (card 4: 34.8%).
	measure 'Route AI words' =
			VAR e = SELECTEDVALUE ( job_escape_route[destination_exposure] )
			RETURN IF ( NOT ISBLANK ( e ), "AI use " & FORMAT ( e, "0.0%" ) )
		displayFolder: Job page\Paths
		lineageTag: c2aa92e8-1605-5c81-b020-bf9146060c07

	/// Hover card (tooltip page) title.
	measure 'Route card title' = SELECTEDVALUE ( job_escape_route[destination_title] )
		displayFolder: Job page\Route card
		lineageTag: c0585002-0847-5faa-aac2-09c39a059bbb

	/// Hover card: the destination's openings, two significant digits with 'About' as card 1 (D45), 'our estimate' in words for a filled destination. Ties to Financial Examiners 'About 1,200 openings a year' (1,151).
	measure 'Route card openings' =
			VAR v = SELECTEDVALUE ( job_escape_route[destination_openings] )
			VAR d = SELECTEDVALUE ( job_escape_route[destination_soc_code] )
			VAR filled = CALCULATE ( COUNTROWS ( job_profile ), REMOVEFILTERS (), job_profile[soc_code] = d, job_profile[is_imputed] = TRUE () ) > 0
			RETURN
			    IF ( HASONEVALUE ( job_escape_route[destination_soc_code] ),
			        IF ( ISBLANK ( v ), "No NYC projection",
			            IF ( v < 1, "Under 1 opening a year", "About " & IF ( v < 1, "< 1", IF ( v < 10, FORMAT ( ROUND ( v, 0 ), "0" ), FORMAT ( ROUND ( v, 1 - INT ( LOG10 ( v ) ) ), "#,0" ) ) ) & " openings a year" ) & IF ( filled, " (our estimate)" ) ) )
		displayFolder: Job page\Route card
		lineageTag: 16260312-63e0-578c-8706-ed4c2d2e8733

	/// Hover card: the destination's NYC entry wage. Ties to '$88.6K' (88,620).
	measure 'Route card pay' =
			VAR w = SELECTEDVALUE ( job_escape_route[destination_entry_wage] )
			RETURN IF ( HASONEVALUE ( job_escape_route[destination_soc_code] ), IF ( ISBLANK ( w ), "Entry wage not published", "Entry wage $" & IF ( ABS ( w ) >= 99950, FORMAT ( ABS ( w ) / 1000, "0" ), FORMAT ( ABS ( w ) / 1000, "0.0" ) ) & "K" ) )
		displayFolder: Job page\Route card
		lineageTag: 32f8190f-a150-5ade-a267-743957bd0b8e

	/// Hover card: the destination's D7 band, said as 'AI use seen' since the release (D50 item 1). Ties to 'Low AI use seen'.
	measure 'Route card AI' =
			VAR b = SELECTEDVALUE ( job_escape_route[destination_band] )
			RETURN IF ( NOT ISBLANK ( b ), IF ( b = "Not seen yet", "No AI use seen yet", b & " AI use seen" ) )
		displayFolder: Job page\Route card
		lineageTag: c9c4eaae-96da-5e7a-9828-8b9b48858d63

	/// Hover card: the destination's one-line description.
	measure 'Route card description' = SELECTEDVALUE ( job_escape_route[destination_description] )
		displayFolder: Job page\Route card
		lineageTag: 689dc958-4458-5040-a02b-91c0f3e8f699

	/// Share of the job's NY State workers in the sector, May 2025 (OEWS industry staffing, D3); top 4 rows by rank_in_job. Ties to 0.3245, 0.1539, 0.0551, 0.0547.
	measure 'Employer share' = SUM ( job_industry_mix[share_of_job] )
		formatString: 0.0%
		displayFolder: Job page\Details
		lineageTag: 608afb8f-eda8-5f1f-9ce6-cf910b885b6d

	/// 32.5%
	measure 'Employer share text' = IF ( NOT ISBLANK ( [Employer share] ), FORMAT ( [Employer share], "0.0%" ) )
		displayFolder: Job page\Details
		lineageTag: 63c08f54-4254-59cc-a54c-f83383e14794

	/// Row order of the sectors.
	measure 'Employer rank' = MIN ( job_industry_mix[rank_in_job] )
		formatString: 0
		isHidden
		displayFolder: Job page\Details
		lineageTag: dc610db5-a033-5e89-bb7d-9e14c9f347e6

	/// Employers block empty state (5 jobs).
	measure 'Employers empty' = IF ( HASONEVALUE ( job_profile[soc_code] ) && ISEMPTY ( job_industry_mix ), "No industry breakdown published for this job" )
		displayFolder: Job page\Details
		lineageTag: a9eb62d5-27cc-567b-bb59-2a776224ae53

	/// Details, under the sector bars: separations in its employers' industries, QWI 2024 (private employers only); hidden when blank (14 jobs). Ties to 'about 51%' (0.5086).
	measure 'Turnover line' =
			VAR t = SELECTEDVALUE ( job_profile[industry_separation_rate_page] )
			RETURN IF ( NOT ISBLANK ( t ), "Its employers' staff turn over about " & FORMAT ( t, "0%" ) & " a year (private, 2024)." )
